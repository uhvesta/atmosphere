load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# A Rust CLI so it doesn't depend on the Swift toolchain it regenerates.
# Crates come from the root Cargo workspace through crate_universe (@crates).
rust_binary(
    name = "update_versions",
    srcs = glob(["src/*.rs"]),
    visibility = ["//tools/rules/swift:__pkg__"],
    deps = [
        "//tools/scripts/bootstrap/lib:bootstrap",
        "@crates//:bzip2",
        "@crates//:clap",
        "@crates//:plist",
        "@crates//:rayon",
        "@crates//:regex",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "update_versions_test",
    crate = ":update_versions",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
