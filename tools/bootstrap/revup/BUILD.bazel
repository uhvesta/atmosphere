load("@rules_rust//rust:defs.bzl", "rust_binary")

# bazel run //tools/bootstrap/revup installs revup into .tools/revup
# from ../versions.lock and writes the .tools/bin/revup launcher.
rust_binary(
    name = "revup",
    srcs = ["src/main.rs"],
    compile_data = ["launcher.sh"],
    deps = [
        "//tools/bootstrap/lib:bootstrap",
        "@crates//:flate2",
        "@crates//:sha2",
        "@crates//:tar",
        "@crates//:thiserror",
        "@crates//:zip",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
