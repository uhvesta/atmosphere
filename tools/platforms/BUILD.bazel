# Target platforms for cross-compilation. Select one with
# `--config=<name>` (see .bazelrc) or `--platforms=//tools/platforms:<name>`.
#
# Linux targets are fully static musl binaries, so they run on any Linux
# distribution. PIE is off because Rust links musl targets with -no-pie.

package(default_visibility = ["//visibility:public"])

platform(
    name = "macos_arm64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libcxx",
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libcxx",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
