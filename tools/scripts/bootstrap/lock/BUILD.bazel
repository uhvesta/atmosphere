load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# bazel run //tools/scripts/bootstrap/lock rewrites ../versions.lock from
# ../versions.toml. Crates come from the root Cargo workspace (@crates).
rust_binary(
    name = "lock",
    srcs = glob(["src/*.rs"]),
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:toml",
        "@crates//:ureq",
    ],
)

rust_test(
    name = "lock_test",
    crate = ":lock",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
