load("@rules_rust//rust:defs.bzl", "rust_binary")

# bazel run //tools/scripts/bootstrap/lock rewrites ../versions.lock from
# ../versions.toml. Crates come from the root Cargo workspace (@crates).
rust_binary(
    name = "lock",
    srcs = glob(["src/*.rs"]),
    deps = [
        "//tools/scripts/bootstrap/lib:bootstrap",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
