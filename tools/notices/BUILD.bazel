load("@rules_python//python:py_test.bzl", "py_test")

exports_files(
    ["extras.txt"] + glob(["licenses/*.txt"]),
    visibility = ["//visibility:public"],
)

py_test(
    name = "notices_test",
    srcs = ["notices_test.py"],
    args = [
        "$(rlocationpath @humata2_notices//:THIRD_PARTY_NOTICES.txt)",
        "$(rlocationpath @humata2_notices//:CRATES.txt)",
        "$(rlocationpath //apps/humata2/app:linked_crates)",
