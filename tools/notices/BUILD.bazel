    data = [
        "//apps/humata2/app:linked_crates",
        "@humata2_notices//:CRATES.txt",
        "@humata2_notices//:THIRD_PARTY_NOTICES.txt",
    ],
    legacy_create_init = 0,
    python_version = "3.14.4",
