load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Auto-translating macOS 26.7+ FSKit compatibility crate over fusefs_vfs::Volume:
# - Audit token & Unix socket peer credential extraction (LOCAL_PEERTOKEN / SO_PEERCRED)
# - MountSpec helper for `/sbin/mount -F -o nobrowse` & FSGenericURLResource URLs
# - FsKitAdapter<V: Volume> translating FSUnaryFileSystem / FSVolume / FSItem ops
# - Framed Unix-domain App Group bridge server (FsKitBridgeServer)
rust_library(
    name = "fskit",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fusefs_fskit",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/fusefs/host",
        "//libs/fusefs/vfs",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "fskit_test",
    crate = ":fskit",
    deps = [
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
