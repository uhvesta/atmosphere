# The Claude Code for the target platform, pinned in claude.bzl.
alias(
    name = "claude",
    actual = select({
        ":darwin_arm64": "@claude_cli_darwin_arm64//:claude",
        ":darwin_x64": "@claude_cli_darwin_x64//:claude",
        ":linux_arm64": "@claude_cli_linux_arm64//:claude",
        ":linux_x64": "@claude_cli_linux_x64//:claude",
    }),
    visibility = ["//apps/humata:__subpackages__"],
)

[
    config_setting(
        name = "{}_{}".format(os, cpu_name),
        constraint_values = [
            "@platforms//os:" + ("macos" if os == "darwin" else "linux"),
            "@platforms//cpu:" + cpu,
        ],
    )
    for os in ("darwin", "linux")
    for cpu_name, cpu in (
        ("arm64", "aarch64"),
        ("x64", "x86_64"),
    )
]

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "claude.bzl",
    ],
    tags = ["starlark"],
)
