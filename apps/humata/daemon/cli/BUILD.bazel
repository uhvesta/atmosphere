load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# `humata`: sessions from the command line, through the daemon's socket.
rust_binary(
    name = "humata",
    srcs = glob(["src/*.rs"]),
    visibility = ["//apps/humata:__subpackages__"],
    deps = [
        "//apps/humata/daemon/wire",
        "@crates//:clap",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "humata_test",
    crate = ":humata",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
