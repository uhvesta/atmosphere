load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":builds.bzl", "humatad_builds")

# The one binary every machine runs: `humatad daemon` on your Mac, which the
# app and the CLI talk to on a local socket, and `humatad host --stdio` on each
# machine sessions run on, reached over SSH.
rust_library(
    name = "humatad_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "humatad",
    deps = [
        "//apps/humata/daemon/agent",
        "//apps/humata/daemon/wire",
        "@crates//:prost",
        "@crates//:rusqlite",
        "@crates//:rustix",
        "@crates//:ruzstd",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "humatad_test",
    crate = ":humatad_lib",
    deps = ["@crates//:tempfile"],
)

rust_binary(
    name = "humatad",
    srcs = ["src/main.rs"],
    visibility = ["//apps/humata:__subpackages__"],
    deps = [
        ":humatad_lib",
        "//apps/humata/daemon/wire",
        "@crates//:clap",
        "@crates//:tokio",
    ],
)

# humatad for every platform a host may be, bundled with the app so a host
# gets the build for it whatever this Mac is. Named as `uname -sm` names them.
humatad_builds(
    name = "builds",
    binary = ":humatad",
    platforms = {
        "//bazel/platforms:linux_arm64": "linux-aarch64",
        "//bazel/platforms:linux_x86_64": "linux-x86_64",
        "//bazel/platforms:macos_arm64": "darwin-arm64",
        "//bazel/platforms:macos_x86_64": "darwin-x86_64",
    },
    prefix = "humatad",
    visibility = ["//apps/humata:__subpackages__"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
