load("@lifr_identity//:defs.bzl", "HUMATA_BUNDLE_ID")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Humata for the Mac: the window over humatad, which it bundles and keeps
# running. Signed by a team, it registers humatad as a login agent with
# SMAppService, listed in Login Items; built ad hoc, it runs humatad itself
# and stops it on quit. Needs Xcode: build with `--config=xcode`.
swift_library(
    name = "app_lib",
    package_name = "humata",
    srcs = glob(["Sources/*.swift"]),
    # Apple's model is there from macOS 26; before, it says it's unavailable.
    linkopts = ["-Wl,-weak_framework,FoundationModels"],
    module_name = "HumataApp",
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        "//apps/humata/clients/daemon",
        "//apps/humata/clients/daemon_live",
        "//apps/humata/features/app",
        "//apps/humata/features/projects",
        "//apps/libs/kits/inference",
        "//apps/libs/kits/inference/live",
        "//apps/libs/kits/inference/mlx",
        "//apps/libs/kits/inference/server",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# The login agent's definition, named after the bundle ID.
genrule(
    name = "daemon_plist",
    srcs = ["daemon.plist.template"],
    outs = ["daemon.plist"],
    cmd = "sed 's/@BUNDLE_ID@/{}/g' $< > $@".format(HUMATA_BUNDLE_ID),
)

macos_application(
    name = "macos",
    additional_contents = {
        "//apps/humata/daemon/cli:humata": "Helpers",
        "//apps/humata/daemon/humatad": "Helpers",
        # Among the resources: codesign takes anything in Helpers for Mac
        # code, which the Linux builds aren't.
        "//apps/humata/daemon/humatad:builds": "Resources",
        ":daemon_plist": "Library/LaunchAgents",
    },
    bundle_id = HUMATA_BUNDLE_ID,
    bundle_name = "Humata",
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":app_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
