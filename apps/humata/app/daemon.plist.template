<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The login agent SMAppService registers for a signed Humata: humatad from
     inside the app, started at login and again if it crashes. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@BUNDLE_ID@.daemon</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/humatad</string>
	<key>ProgramArguments</key>
	<array>
		<string>humatad</string>
		<string>daemon</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>@BUNDLE_ID@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
