load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# End-to-end tests: the real humatad and humata binaries, as a person runs them.
rust_test(
    name = "fork_from_cli_test",
    srcs = [
        "common.rs",
        "fork.rs",
        "fork_from_cli_test.rs",
    ],
    crate_root = "fork_from_cli_test.rs",
    data = [
        "//apps/humata/daemon/cli:humata",
        "//apps/humata/daemon/humatad",
    ],
    env = {
        "HUMATA": "$(rootpath //apps/humata/daemon/cli:humata)",
        "HUMATAD": "$(rootpath //apps/humata/daemon/humatad)",
    },
    deps = [
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

