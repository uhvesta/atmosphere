# Where humatad is in the runfiles, for the Swift test to start it.
genrule(
    name = "binaries_swift",
    testonly = True,
    srcs = ["//apps/humata/daemon/humatad"],
    outs = ["Binaries.swift"],
    cmd = """cat > $@ <<'EOF'
enum Binaries {
    static let humatad = "$(rlocationpath //apps/humata/daemon/humatad)"
}
EOF""",
)

swift_library(
    name = "fork_from_swift_lib",
    package_name = "humata",
    testonly = True,
    srcs = glob(["ForkFromSwift/*.swift"]) + [":binaries_swift"],
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        "//apps/humata/clients/daemon",
        "//apps/humata/clients/daemon_live",
    ],
)

# The same through the Swift client the app uses, on the real humatad.
macos_unit_test(
    name = "fork_from_swift_test",
    data = ["//apps/humata/daemon/humatad"],
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":fork_from_swift_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)

