load("@rules_rust//rust:defs.bzl", "rust_binary")

# protoc-gen-prost, the protoc plugin for prost, built from the workspace's
# pinned crate.
rust_binary(
    name = "protoc-gen-prost",
    srcs = ["main.rs"],
    visibility = ["//apps/humata/proto:__pkg__"],
    deps = [
        "@crates//:prost",
        "@crates//:protoc-gen-prost",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
