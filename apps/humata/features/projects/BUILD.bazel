load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The sidebar: projects and their sessions, read again every few seconds,
# and the sheets to add a project and start a session in it. TCA reducers
# with SwiftUI views. Needs Xcode: build with `--config=xcode`.
swift_library(
    name = "projects",
    package_name = "humata",
    srcs = glob(["Sources/*.swift"]),
    module_name = "HumataProjects",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/humata/app:__subpackages__",
        "//apps/humata/features/app:__pkg__",
        "//apps/humata/features/board:__pkg__",
    ],
    deps = [
        "//apps/humata/clients/daemon",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests over the in-memory daemon, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "humata",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":projects",
        "//apps/humata/clients/daemon",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
