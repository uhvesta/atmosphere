load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# A project's board: its tasks and subtasks by status, each item's page
# with its spec and sessions, and the board's history to revert from. TCA
# reducers with SwiftUI views. Needs Xcode: build with `--config=xcode`.
swift_library(
    name = "board",
    package_name = "humata",
    srcs = glob(["Sources/*.swift"]),
    module_name = "HumataBoard",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/humata/features/app:__pkg__"],
    deps = [
        "//apps/humata/clients/daemon",
        "//apps/humata/features/projects",
        "//apps/humata/features/review",
        "//apps/humata/features/session",
        "//apps/libs/kits/board",
        "//apps/libs/kits/chatui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests over the in-memory daemon, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "humata",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":board",
        "//apps/humata/clients/daemon",
        "//apps/humata/features/projects",
        "//apps/humata/features/review",
        "//apps/humata/features/session",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
