load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//apps/libs/kits/flow:defs.bzl", "flow_snapshot_test")

# Humata's window: the projects sidebar and the open session's chat. A TCA
# reducer composing the projects and session features. Needs Xcode: build
# with `--config=xcode`.
swift_library(
    name = "app",
    package_name = "humata",
    srcs = glob(["Sources/*.swift"]),
    module_name = "HumataAppFeature",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/humata/app:__subpackages__"],
    deps = [
        "//apps/humata/clients/daemon",
        "//apps/humata/features/board",
        "//apps/humata/features/diagram",
        "//apps/humata/features/hosts",
        "//apps/humata/features/projects",
        "//apps/humata/features/search",
        "//apps/humata/features/session",
        "//apps/humata/features/terminal",
        "//apps/libs/kits/chatui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests over the in-memory daemon, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "humata",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":app",
        "//apps/humata/clients/daemon",
        "//apps/humata/features/board",
        "//apps/humata/features/hosts",
        "//apps/humata/features/projects",
        "//apps/humata/features/review",
        "//apps/humata/features/search",
        "//apps/humata/features/session",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

# Histories both window tests open.
_SEEDS = ["TestSupport/ChatMaker.swift"]

_WINDOW_TEST_DEPS = [
    ":app",
    "//apps/humata/clients/daemon",
    "//apps/humata/features/board",
    "//apps/humata/features/diagram",
    "//apps/humata/features/docs",
    "//apps/humata/features/hosts",
    "//apps/humata/features/projects",
    "//apps/humata/features/review",
    "//apps/humata/features/search",
    "//apps/humata/features/session",
    "//apps/humata/features/terminal",
    "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
]

# The window step by step on the Mac, over the in-memory daemon: references
# in SnapshotTests/__Snapshots__. Manual, since `bazel test` can't read
# other windows: run it with //apps/libs/kits/flow:run_mac.sh.
flow_snapshot_test(
    name = "mac_flow_snapshot_test",
    package_name = "humata",
    srcs = glob(["MacFlowSnapshotTests/*.swift"]) + _SEEDS,
    mac = True,
    tags = ["manual"],
    deps = _WINDOW_TEST_DEPS,
)

# What the window costs as a person uses it: opening a long chat, scrolling
# it, following a turn at work. A target of its own, so measuring doesn't run
# the flows above, nor they it. Manual, and run the same way; times mean most
# optimized and are checked only when asked:
# `FLOWKIT_OPT=1 HUMATA_PERF=1 apps/libs/kits/flow/run_mac.sh <this target>`.
flow_snapshot_test(
    name = "mac_perf_test",
    package_name = "humata",
    srcs = glob(["PerfTests/*.swift"]) + _SEEDS,
    mac = True,
    tags = ["manual"],
    deps = _WINDOW_TEST_DEPS,
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
