load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Searching every session's messages, replies, commands and output, with
# related words from Apple's on-device model. A TCA reducer with its SwiftUI
# view. Needs Xcode: build with `--config=xcode`.
swift_library(
    name = "search",
    package_name = "humata",
    srcs = glob(["Sources/*.swift"]),
    module_name = "HumataSearch",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/humata/features/app:__pkg__"],
    deps = [
        "//apps/humata/clients/daemon",
        "//apps/libs/kits/inference",
        "//apps/libs/kits/inference/live",
        "//apps/libs/kits/words",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests over the in-memory daemon, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "humata",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":search",
        "//apps/humata/clients/daemon",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
