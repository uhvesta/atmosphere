load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Terminals in a session's folder or on a host: tabs of shells the host keeps
# running, each drawn by Ghostty. A TCA reducer with a SwiftUI view. Needs
# Xcode: build with `--config=xcode`.
swift_library(
    name = "terminal",
    package_name = "humata",
    srcs = glob(["Sources/*.swift"]),
    module_name = "HumataTerminal",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/humata/features/app:__pkg__",
        "//apps/humata/features/hosts:__pkg__",
        "//apps/humata/features/session:__pkg__",
    ],
    deps = [
        "//apps/humata/clients/daemon",
        "@ghostty_kit//:GhosttyKit",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests over the in-memory daemon, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "humata",
    testonly = True,
    srcs = glob(
        ["Tests/*.swift"],
        exclude = ["Tests/GhosttySurfaceTests.swift"],
    ),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":terminal",
        "//apps/humata/clients/daemon",
        "@ghostty_kit//:GhosttyKit",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

# A real Ghostty surface running commands. Ghostty starts every command
# through login(1), which is setuid and can't run inside a sandbox, so this
# runs outside Bazel's, and only when asked:
# `bazel test --config=xcode //apps/humata/features/terminal:surface_tests`
# from a terminal that isn't itself sandboxed.
swift_library(
    name = "surface_tests_lib",
    package_name = "humata",
    testonly = True,
    srcs = ["Tests/GhosttySurfaceTests.swift"],
    target_compatible_with = ["//bazel/xcode"],
    deps = [":terminal"],
)

macos_unit_test(
    name = "surface_tests",
    minimum_os_version = "15.0",
    tags = [
        "manual",
        "no-sandbox",
    ],
    target_compatible_with = ["//bazel/xcode"],
    deps = [":surface_tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
