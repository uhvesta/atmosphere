# Where khodrd is in the runfiles, for the Swift test to start it.
genrule(
    name = "binaries_swift",
    testonly = True,
    srcs = ["//apps/khodr/daemon/khodrd"],
    outs = ["Binaries.swift"],
    cmd = """cat > $@ <<'EOF'
enum Binaries {
    static let khodrd = "$(rlocationpath //apps/khodr/daemon/khodrd)"
}
EOF""",
)

swift_library(
    name = "fork_from_swift_lib",
    package_name = "khodr",
    testonly = True,
    srcs = glob(["ForkFromSwift/*.swift"]) + [":binaries_swift"],
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        "//apps/khodr/clients/daemon",
        "//apps/khodr/clients/daemon_live",
    ],
)

# The same through the Swift client the app uses, on the real khodrd.
macos_unit_test(
    name = "fork_from_swift_test",
    data = ["//apps/khodr/daemon/khodrd"],
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":fork_from_swift_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
