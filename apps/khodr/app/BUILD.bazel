load("@lifr_identity//:defs.bzl", "KHODR_BUNDLE_ID")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Khodr for the Mac: the window over khodrd, which it bundles and keeps
# running. Signed by a team, it registers khodrd as a login agent with
# SMAppService, listed in Login Items; built ad hoc, it runs khodrd itself
# and stops it on quit. Needs Xcode: build with `--config=xcode`.
swift_library(
    name = "app_lib",
    package_name = "khodr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "KhodrApp",
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        "//apps/khodr/clients/daemon",
        "//apps/khodr/clients/daemon_live",
        "//apps/khodr/features/app",
        "//apps/khodr/features/projects",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# The login agent's definition, named after the bundle ID.
genrule(
    name = "daemon_plist",
    srcs = ["daemon.plist.template"],
    outs = ["daemon.plist"],
    cmd = "sed 's/@BUNDLE_ID@/{}/g' $< > $@".format(KHODR_BUNDLE_ID),
)

macos_application(
    name = "macos",
    additional_contents = {
        "//apps/khodr/daemon/khodrd": "Helpers",
        ":daemon_plist": "Library/LaunchAgents",
    },
    bundle_id = KHODR_BUNDLE_ID,
    bundle_name = "Khodr",
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":app_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
