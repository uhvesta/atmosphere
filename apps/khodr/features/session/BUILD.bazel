load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# One session: its chat as it happens, sending, steering and queueing,
# permissions and the approval mode, usage, and forks. A TCA reducer with a
# SwiftUI view built from ChatUI. Needs Xcode: build with `--config=xcode`.
swift_library(
    name = "session",
    package_name = "khodr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "KhodrSession",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/khodr/app:__subpackages__",
        "//apps/khodr/features:__subpackages__",
    ],
    deps = [
        "//apps/khodr/clients/daemon",
        "//apps/libs/kits/chat",
        "//apps/libs/kits/chatui",
        "//apps/libs/kits/inference",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "khodr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":session",
        "//apps/khodr/clients/daemon",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
