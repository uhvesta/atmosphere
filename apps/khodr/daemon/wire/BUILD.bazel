load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Khodr's protocol on any byte stream (a local socket, SSH's stdin and
# stdout): length-prefixed envelopes, the hello, and the client and server
# every peer uses.
rust_library(
    name = "wire",
    srcs = glob(["src/*.rs"]),
    crate_name = "khodr_wire",
    visibility = ["//apps/khodr:__subpackages__"],
    deps = [
        "//apps/khodr/proto:khodr_rust",
        "@crates//:prost",
        "@crates//:ruzstd",
        "@crates//:thiserror",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "wire_test",
    crate = ":wire",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
