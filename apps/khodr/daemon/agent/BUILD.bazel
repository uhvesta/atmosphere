load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The agent interface every backend implements, the runtime the in-process
# backends share (turns, approvals, forks, history on disk), and the backends:
# Copilot, a local model, and the scripted one tests run on.
rust_library(
    name = "agent",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "khodr_agent",
    visibility = ["//apps/khodr/daemon:__subpackages__"],
    deps = [
        "//apps/khodr/daemon/workspace",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:ureq",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "agent_test",
    crate = ":agent",
    deps = ["@crates//:tempfile"],
)

# The Copilot backend on the pinned Copilot CLI, offline against a fake model
# server.
rust_test(
    name = "copilot_test",
    srcs = ["tests/copilot_test.rs"],
    data = ["//apps/khodr/copilot"],
    env = {"COPILOT_CLI": "$(rootpath //apps/khodr/copilot)"},
    deps = [
        ":agent",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
