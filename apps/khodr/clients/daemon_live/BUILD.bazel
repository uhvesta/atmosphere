load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The daemon client over khodrd's Unix socket. Only the app and end-to-end
# tests depend on this; features use //apps/khodr/clients/daemon.
swift_library(
    name = "daemon_live",
    package_name = "khodr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "KhodrDaemonLive",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/khodr/app:__pkg__",
        "//apps/khodr/e2e:__pkg__",
    ],
    # khodr_swift brings SwiftProtobuf with it.
    deps = [
        "//apps/khodr/clients/daemon",
        "//apps/khodr/proto:khodr_swift",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
