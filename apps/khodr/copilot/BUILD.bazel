# The Copilot CLI for the target platform, pinned in copilot.bzl.
alias(
    name = "copilot",
    actual = select({
        ":darwin_arm64": "@copilot_cli_darwin_arm64//:copilot",
        ":darwin_x64": "@copilot_cli_darwin_x64//:copilot",
        ":linux_arm64": "@copilot_cli_linux_arm64//:copilot",
        ":linux_x64": "@copilot_cli_linux_x64//:copilot",
    }),
    visibility = ["//apps/khodr:__subpackages__"],
)

[
    config_setting(
        name = "{}_{}".format(os, cpu_name),
        constraint_values = [
            "@platforms//os:" + ("macos" if os == "darwin" else "linux"),
            "@platforms//cpu:" + cpu,
        ],
    )
    for os in ("darwin", "linux")
    for cpu_name, cpu in (
        ("arm64", "aarch64"),
        ("x64", "x86_64"),
    )
]

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "copilot.bzl",
    ],
    tags = ["starlark"],
)
