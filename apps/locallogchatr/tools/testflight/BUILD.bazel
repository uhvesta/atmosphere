load("@lifr_identity//:defs.bzl", "LANGREADR_BUNDLE_ID", "TEAM_ID")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Uploads LocalLogChatr's iPhone app to TestFlight from this Mac, in
# LangReadr's App Store Connect record, with Lifr's script and key (see
# //apps/lifr/tools/testflight):
#   bazel run --config=xcode //apps/locallogchatr/tools/testflight:upload
# See upload.sh for what each argument is. Bazel splits args at spaces like
# a shell, so those with a space in them are quoted.
sh_binary(
    name = "upload",
    srcs = ["//apps/lifr/tools/testflight:upload.sh"],
    args = [
        TEAM_ID or "none",
        "$(rootpath //apps/lifr/tools/testflight:asc)",
        "LangReadr",
        "lifr_testflight",
        "//apps/locallogchatr/app:ios",
        "langreadr",
        "'" + LANGREADR_BUNDLE_ID + "|LangReadr|LangReadr App Store|langreadr-app-store'",
    ],
    data = ["//apps/lifr/tools/testflight:asc"],
    target_compatible_with = ["//bazel/xcode"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
