load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# WordsKit: words related to what's searched for, from a model on the
# device or the system's word lists, so a search finds what it means as
# well as what it says. Lifr's and Humata's searches use it.
swift_library(
    name = "words",
    srcs = glob(["Sources/*.swift"]),
    module_name = "WordsKit",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/humata:__subpackages__",
        "//apps/lifr/clients/search_live:__pkg__",
    ],
    deps = [
        "//apps/libs/kits/inference",
        "//apps/libs/kits/json",
    ],
)

# Runs on the system's word lists and a scripted model, on macOS.
swift_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":words",
        "//apps/libs/kits/inference",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
