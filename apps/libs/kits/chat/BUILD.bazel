load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# ChatKit: conversations with an assistant, generic over the app's messages
# and what it keeps with each conversation. Branches, checkpoints and forks,
# summaries that compact a long conversation, the newest messages that fit
# a model, and search by words and times. Plain Swift with Foundation, so
# it builds with the hermetic toolchains, Linux included.
swift_library(
    name = "chat",
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "ChatKit",
    visibility = ["//apps:__subpackages__"],
)

# Given/then tests on a small sample conversation, run with TestingKit.
swift_binary(
    name = "chat_tests",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    deps = [
        ":chat",
        "//apps/libs/kits/testing",
    ],
)

sh_test(
    name = "chat_test",
    srcs = ["//apps/libs/kits/testing:run_tests.sh"],
    args = ["$(rootpath :chat_tests)"],
    data = [":chat_tests"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
