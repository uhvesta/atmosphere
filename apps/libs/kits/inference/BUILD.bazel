load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# InferenceKit: the models an app can run on the device. The runtime every
# model answers through, each model's context budget, the catalog, Hugging
# Face links and hashes, which model each of the app's uses runs on, and the
# downloads in progress. A scripted runtime is here for tests and previews.
# The live runtimes and downloads are in //apps/libs/kits/inference/live.
swift_library(
    name = "inference",
    package_name = "inference",
    srcs = glob(["Sources/*.swift"]),
    module_name = "InferenceKit",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps:__subpackages__"],
    deps = ["//apps/libs/kits/json"],
)

# Links, hashes and the catalog, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "inference",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [":inference"],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
