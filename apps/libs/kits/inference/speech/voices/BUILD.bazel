load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Which engine runs each kind of downloaded voice model, the one place the
# apps' speech meets the engines beside it, such as ../supertonic.
swift_library(
    name = "voices",
    package_name = "inference",
    srcs = glob(["Sources/*.swift"]),
    module_name = "InferenceKitVoices",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/langreadr/app:__pkg__",
        "//apps/lifr/app:__pkg__",
        "//apps/locallogchatr/app:__pkg__",
    ],
    deps = [
        "//apps/libs/kits/inference",
        "//apps/libs/kits/inference/speech/supertonic",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
