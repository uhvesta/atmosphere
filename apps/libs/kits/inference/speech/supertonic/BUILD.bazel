load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Supertonic 3, a downloaded voice model, on Core ML, which the OS ships:
# a SpeechEngine that Speaker, in the package above, plays. It needs its
# model, so it's checked by building and by hand with :smoke_test; the
# text it reads is tested on its own.
swift_library(
    name = "supertonic",
    package_name = "inference",
    srcs = glob(["Sources/*.swift"]),
    module_name = "InferenceKitSupertonic",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/libs/kits/inference/speech/voices:__pkg__"],
    deps = ["//apps/libs/kits/inference"],
)

swift_library(
    name = "tests_lib",
    package_name = "inference",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [":supertonic"],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

# Speaks a sentence with a downloaded Supertonic 3, from the folder in
# SUPERTONIC_DIR, and checks it made about as much audio as the text
# takes to say. Skips without it; it downloads nothing.
swift_library(
    name = "smoke_tests_lib",
    testonly = True,
    srcs = glob(["SmokeTests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":supertonic",
        "//apps/libs/kits/inference",
    ],
)

macos_unit_test(
    name = "smoke_test",
    minimum_os_version = "15.0",
    tags = ["manual"],
    target_compatible_with = ["//bazel/xcode"],
    deps = [":smoke_tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
