load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Speech: text read aloud on the device. The system voice, through
# AVSpeechSynthesizer, needs no download. A downloaded voice model runs on
# an engine of its own, in a package beside this one, such as
# ./supertonic, which the app hands to Speaker. Every engine makes PCM
# audio a piece at a time, which plays through AVAudioEngine; Speaker
# picks the voice for each language, falls back to the system's, and stops
# what's playing when something else speaks. Speaker is tested with fakes.
swift_library(
    name = "speech",
    package_name = "inference",
    srcs = glob(["Sources/*.swift"]),
    module_name = "InferenceKitSpeech",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/langreadr/app:__pkg__",
        "//apps/lifr/app:__pkg__",
        "//apps/locallogchatr/app:__pkg__",
    ],
    deps = ["//apps/libs/kits/inference"],
)

swift_library(
    name = "tests_lib",
    package_name = "inference",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":speech",
        "//apps/libs/kits/inference",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
