load("@rules_apple//apple:ios.bzl", "ios_build_test")
load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load(":test_model.bzl", "QWEN35_TINY_MLX")

# The MLX spike: can Bazel build MLX Swift LM, its Metal kernels included,
# and does it run a real model here? Nothing in the apps uses it yet.

# Where the spike's model is, for the test to find it.
genrule(
    name = "test_model_swift",
    testonly = True,
    srcs = ["@mlx_test_model//:{}/config.json".format(QWEN35_TINY_MLX.directory)],
    outs = ["TestModel.swift"],
    cmd = """cat > $@ <<'EOF'
enum TestModel {{
    static let config = "$(rlocationpath @mlx_test_model//:{directory}/config.json)"
}}
EOF""".format(directory = QWEN35_TINY_MLX.directory),
)

swift_library(
    name = "spike_tests_lib",
    testonly = True,
    srcs = glob(["SpikeTests/*.swift"]) + [":test_model_swift"],
    data = ["@mlx_kernels//:bundle"],
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        "@swiftpkg_mlx_swift_lm//:MLXLLM",
        "@swiftpkg_mlx_swift_lm//:MLXLMCommon",
        "@swiftpkg_swift_transformers//:Tokenizers",
    ],
)

# Qwen3.5 0.8B on MLX on this Mac's GPU: an answer, and how fast.
# Manual: it downloads 630 MB and needs the GPU, which the sandbox hides.
macos_unit_test(
    name = "spike_test",
    data = ["@mlx_test_model//:model"],
    minimum_os_version = "15.0",
    tags = [
        "manual",
        "no-sandbox",
    ],
    target_compatible_with = ["//bazel/xcode"],
    deps = [":spike_tests_lib"],
)

# The same for iPhones: MLX, its kernels and the test build for a device.
ios_build_test(
    name = "spike_ios_build_test",
    testonly = True,
    minimum_os_version = "18.0",
    target_compatible_with = ["//bazel/xcode"],
    targets = [
        ":spike_tests_lib",
        "@mlx_kernels//:kernels",
    ],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "mlx_kernels.bzl",
        "test_model.bzl",
    ],
    tags = ["starlark"],
)
