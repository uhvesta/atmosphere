load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Downloaded models run by LiteRT-LM on the GPU, through Google's prebuilt
# framework. It needs a model on a device, so it's checked by building and
# by hand; what runs a turn is in //apps/libs/kits/inference/live, tested
# with a fake engine.
swift_library(
    name = "litert",
    package_name = "inference",
    srcs = glob(["Sources/*.swift"]),
    module_name = "InferenceKitLiteRT",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps:__subpackages__"],
    deps = [
        "//apps/libs/kits/inference",
        "//apps/libs/kits/inference/live",
        "//apps/libs/kits/json",
        "@litert_lm//:LiteRTLM",
    ],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "litert_lm.bzl",
        "test_model.bzl",
    ],
    tags = ["starlark"],
)
