load("@rules_swift//swift:swift_library.bzl", "swift_library")

# TestingKit: given/then checks as a plain test binary, for code that
# builds with the hermetic toolchains, Linux included. Run a binary with
# run_tests.sh.
swift_library(
    name = "testing",
    testonly = True,
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "TestingKit",
    visibility = ["//apps:__subpackages__"],
)

exports_files(
    ["run_tests.sh"],
    visibility = ["//apps:__subpackages__"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
