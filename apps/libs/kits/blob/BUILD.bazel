load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# BlobKit: how an app writes the values it persists, as a header that says
# how the bytes are encoded and compressed, then the payload. Plain Swift on
# zstd's C library, so it builds with the hermetic toolchains too.
swift_library(
    name = "blob",
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
        # With Xcode, clang also finds zstd's own module map and warns that
        # zstd's headers define its configuration macros. They're zstd's
        # defaults, so the warning is noise.
        "-Xcc",
        "-Wno-config-macros",
    ],
    module_name = "BlobKit",
    visibility = ["//apps:__subpackages__"],
    deps = [":zstd"],
)

# zstd from the BCR as the Swift module CZstd. Its own module map isn't an
# input of sandboxed compiles, so the hermetic toolchains couldn't find it.
cc_library(
    name = "zstd",
    hdrs = ["zstd/zstd_shim.h"],
    aspect_hints = [":zstd_module"],
    deps = ["@zstd"],
)

swift_interop_hint(
    name = "zstd_module",
    module_name = "CZstd",
)

# Given/then tests, run with TestingKit.
swift_binary(
    name = "blob_tests",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    deps = [
        ":blob",
        "//apps/libs/kits/testing",
    ],
)

sh_test(
    name = "blob_test",
    srcs = ["//apps/libs/kits/testing:run_tests.sh"],
    args = ["$(rootpath :blob_tests)"],
    data = [":blob_tests"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
