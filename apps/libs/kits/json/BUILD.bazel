load("@rules_swift//swift:swift_library.bzl", "swift_library")

# JSONKit: any JSON value, for the wire, schemas and models' answers. Plain
# Swift with Foundation, so it builds with the hermetic toolchains.
swift_library(
    name = "json",
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "JSONKit",
    visibility = ["//apps:__subpackages__"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
