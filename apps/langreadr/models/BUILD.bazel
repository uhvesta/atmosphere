load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The models LangReadr can run, from //apps/libs/kits/inference: what
# LangReadr asks a model to do, and the library as a dependency for
# features, with an in-memory one for tests and previews. The app gives
# the live library.
swift_library(
    name = "models",
    package_name = "langreadr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LangReadrModels",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/langreadr/app:__pkg__",
        "//apps/langreadr/reading:__pkg__",
    ],
    deps = [
        "//apps/libs/kits/inference",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
