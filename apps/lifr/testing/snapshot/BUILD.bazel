load("@lifr_identity//:defs.bzl", "FLOW_HOST_BUNDLE_ID")
load("//apps/libs/kits/flow:defs.bzl", "flow_host_app")

# The app Lifr's hosted flow snapshot tests run in, for its window scene.
# See lifr_snapshot_test in defs.bzl.
flow_host_app(
    name = "host",
    bundle_id = FLOW_HOST_BUNDLE_ID,
    # The iPad flows run in it on the iPad runner.
    families = [
        "iphone",
        "ipad",
    ],
    visibility = ["//apps/lifr:__subpackages__"],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["starlark"],
)
