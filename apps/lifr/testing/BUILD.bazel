load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The given/then harness every hermetic Lifr test binary uses.
swift_library(
    name = "testing",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "LifrTesting",
    visibility = ["//apps/lifr:__subpackages__"],
)

exports_files(
    ["run_tests.sh"],
    visibility = ["//apps/lifr:__subpackages__"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
