load("@rules_apple//apple:macos.bzl", "macos_command_line_application", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The `lifr` command and `lifr mcp`. They talk to the Mac app over its socket;
# the app embeds this in Contents/Helpers.

swift_library(
    name = "cli_lib",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrCLI",
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/core",
    ],
)

swift_library(
    name = "main",
    package_name = "lifr",
    srcs = ["main/main.swift"],
    module_name = "LifrCLIMain",
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":cli_lib",
        "//apps/lifr/api",
    ],
)

macos_command_line_application(
    name = "lifr",
    bundle_id = "com.example.lifr.cli",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__pkg__",
        "@rules_xcodeproj//xcodeproj:generated",
    ],
    deps = [":main"],
)

# Commands and `lifr mcp` against the API's golden fixture: output as inline
# snapshots, and --json against the golden files.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]) + ["//apps/lifr/api:Tests/Fixture.swift"],
    data = [
        "//apps/lifr/api:Tests/golden/errors.json",
        "//apps/lifr/api:Tests/golden/mcp_tools.json",
        "//apps/lifr/api:Tests/golden/methods.json",
    ],
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":cli_lib",
        "//apps/lifr/api",
        "//apps/lifr/core",
        "@swiftpkg_swift_snapshot_testing//:InlineSnapshotTesting",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
