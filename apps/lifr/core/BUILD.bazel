load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Lifr's models and rules. Plain Swift with Foundation and no Apple-only
# frameworks, so it builds with the hermetic toolchains, Linux included, and
# every client (the apps, the CLI and the MCP server) goes through it.
swift_library(
    name = "core",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "LifrCore",
    visibility = ["//apps/lifr:__subpackages__"],
    deps = ["//apps/libs/kits/journal"],
)

# Given/then tests for each rule, run with TestingKit.
swift_binary(
    name = "core_tests",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    deps = [
        ":core",
        "//apps/libs/kits/testing",
    ],
)

sh_test(
    name = "core_test",
    srcs = ["//apps/libs/kits/testing:run_tests.sh"],
    args = ["$(rootpath :core_tests)"],
    data = [":core_tests"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
