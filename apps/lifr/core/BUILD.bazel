load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Lifr's rules. Plain Swift with no Apple frameworks, so it builds with the
# hermetic toolchain too.
swift_library(
    name = "core",
    srcs = ["Greeting.swift"],
    module_name = "LifrCore",
    visibility = ["//apps/lifr:__subpackages__"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
