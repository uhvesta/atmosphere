load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Downloaded models run by LiteRT-LM on the GPU, through Google's prebuilt
# framework. It needs a model on a device, so it's checked by building and
# by hand; what runs a turn is in //apps/lifr/clients/models_live, tested
# with a fake engine. The app uses this, and the assistant's end-to-end test.
swift_library(
    name = "models_litert",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrLiteRT",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/features/root:__pkg__",
    ],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/models_live",
        "@litert_lm//:LiteRTLM",
    ],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "litert_lm.bzl",
        "test_model.bzl",
    ],
    tags = ["starlark"],
)
