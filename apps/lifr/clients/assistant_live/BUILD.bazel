load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The assistant client on Apple's on-device model (Foundation Models, iOS
# and macOS 26). Only the app uses it; features depend on
# //apps/lifr/clients/assistant. The framework is weakly linked so the app
# still runs on iOS 18 and macOS 15, where the assistant says it needs an
# update. The model needs Apple Intelligence, so this is checked by
# building, and by hand.
swift_library(
    name = "assistant_live",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    linkopts = ["-Wl,-weak_framework,FoundationModels"],
    module_name = "LifrAssistantLive",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/app:__subpackages__"],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/clients/assistant",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
