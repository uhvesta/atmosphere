load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The session client's socket server: the local API's gate, grants in the
# Keychain, Touch ID approvals and terminal sessions. Only the app uses it;
# features depend on //apps/lifr/clients/session. Its sources are macOS
# only, so the iOS app builds it empty.
swift_library(
    name = "session_live",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrSessionLive",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/app:__subpackages__"],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/clients/session",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
    ],
)

# Runs the server on a real socket, with a stand-in for the code-signing
# check, the Keychain and Touch ID.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":session_live",
        "//apps/lifr/api",
        "//apps/lifr/clients/session",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
