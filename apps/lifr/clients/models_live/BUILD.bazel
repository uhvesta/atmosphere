load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The models Lifr runs on the device, from //apps/libs/kits/inference/live,
# as the library features depend on. Only the app, and the assistant's
# end-to-end test, use this; features depend on //apps/lifr/clients/models.
swift_library(
    name = "models_live",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrModelsLive",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/features/root:__pkg__",
    ],
    deps = [
        "//apps/libs/kits/inference/live",
        "//apps/lifr/clients/models",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
