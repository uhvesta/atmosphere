load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The models Lifr runs on the device. Apple's on-device model goes through
# Foundation Models (iOS and macOS 26), weakly linked so the app still runs
# on iOS 18 and macOS 15, where it says the system is too old. The model
# needs Apple Intelligence, so this is checked by building, and by hand.
# Only the app uses it; features depend on //apps/lifr/clients/models.
swift_library(
    name = "models_live",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    linkopts = ["-Wl,-weak_framework,FoundationModels"],
    module_name = "LifrModelsLive",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/app:__subpackages__"],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/clients/models",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
