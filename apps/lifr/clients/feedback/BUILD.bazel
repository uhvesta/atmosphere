load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Haptics for changes the person made: a status picked, a drop, an undo, or a
# change that was refused, and an optional sound for finishing a task, the
# only feedback on the Mac.
swift_library(
    name = "feedback",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrFeedbackClient",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/features:__subpackages__"],
    deps = [
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":feedback",
        "//apps/lifr/core",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
