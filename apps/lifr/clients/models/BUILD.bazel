load("@rules_swift//swift:swift_library.bzl", "swift_library")

# What Lifr asks a model to do, on the shared library from
# //apps/libs/features/models/client, with an in-memory one for Lifr's
# tests and previews. The live library is in
# //apps/lifr/clients/models_live, which features never depend on.
swift_library(
    name = "models",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrModelsClient",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/clients/assistant:__pkg__",
        "//apps/lifr/clients/assistant_live:__pkg__",
        "//apps/lifr/clients/models_live:__pkg__",
        "//apps/lifr/clients/search_live:__pkg__",
        "//apps/lifr/clients/store_live:__pkg__",
        "//apps/lifr/features/bug_report:__pkg__",
        "//apps/lifr/features/conversations:__pkg__",
        "//apps/lifr/features/root:__pkg__",
        "//apps/lifr/features/settings:__pkg__",
        "//apps/lifr/features/skills:__pkg__",
    ],
    deps = [
        "//apps/libs/features/models/client",
        "//apps/libs/kits/inference",
        "//apps/lifr/api",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
