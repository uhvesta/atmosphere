load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Puts text on the clipboard: a bug report, or tasks copied as Markdown.
swift_library(
    name = "pasteboard",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrPasteboardClient",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/features:__subpackages__"],
    deps = ["@swiftpkg_swift_composable_architecture//:ComposableArchitecture"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
