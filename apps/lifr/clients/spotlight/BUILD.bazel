load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Lists tasks in the system's search, so they turn up in Spotlight.
swift_library(
    name = "spotlight",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrSpotlightClient",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__pkg__",
        "//apps/lifr/features/root:__pkg__",
    ],
    deps = ["@swiftpkg_swift_composable_architecture//:ComposableArchitecture"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
