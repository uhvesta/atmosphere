load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The reminders client: which notifications this device schedules from the
# records, and the permission to show them. This package has the
# definition and an in-memory version for tests and previews. The live one
# is //apps/lifr/clients/reminders_live, which features never depend on.
swift_library(
    name = "reminders",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrRemindersClient",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/clients/reminders_live:__pkg__",
        "//apps/lifr/features:__subpackages__",
        # Its tests check the Watch offers the same reminder buttons.
        "//apps/lifr/watch:__pkg__",
    ],
    deps = [
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":reminders",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
