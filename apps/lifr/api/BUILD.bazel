load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# The local API between `lifr` and the Mac app: JSON-RPC messages, error
# codes, the MCP tool list, and the handler that runs requests against Core.
# Hermetic, so the CLI and MCP server can be tested without Xcode.
swift_library(
    name = "api",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "LifrAPI",
    visibility = ["//apps/lifr:__subpackages__"],
    deps = ["//apps/lifr/core"],
)

# The CLI's tests run against the same fixture and check --json against the
# golden files.
exports_files(
    [
        "Tests/Fixture.swift",
        "Tests/golden/errors.json",
        "Tests/golden/mcp_tools.json",
        "Tests/golden/methods.json",
    ],
    visibility = ["//apps/lifr/cli:__pkg__"],
)

# Given/then tests for the handler, run with //apps/lifr/testing's harness.
swift_binary(
    name = "handler_tests",
    package_name = "lifr",
    testonly = True,
    srcs = ["Tests/Fixture.swift"] + glob(["Tests/Handler/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    deps = [
        ":api",
        "//apps/lifr/core",
        "//apps/lifr/testing",
    ],
)

sh_test(
    name = "handler_test",
    srcs = ["//apps/lifr/testing:run_tests.sh"],
    args = ["$(rootpath :handler_tests)"],
    data = [":handler_tests"],
)

# Writes the golden files from fresh fixtures.
swift_binary(
    name = "generate_golden",
    package_name = "lifr",
    testonly = True,
    srcs = [
        "Tests/Fixture.swift",
        "Tests/Generate/main.swift",
    ],
    copts = [
        "-swift-version",
        "6",
    ],
    deps = [
        ":api",
        "//apps/lifr/core",
    ],
)

_GOLDEN = [
    "mcp_tools",
    "methods",
    "errors",
]

run_binary(
    name = "generate",
    testonly = True,
    outs = ["generated/%s.json" % name for name in _GOLDEN],
    args = ["$(execpath generated/%s.json)" % name for name in _GOLDEN],
    tool = ":generate_golden",
)

[
    diff_test(
        name = name + "_golden_test",
        failure_message = "The API changed. If that's intended, run `bazel run //apps/lifr/api:update_golden` and review the diff.",
        file1 = "Tests/golden/%s.json" % name,
        file2 = "generated/%s.json" % name,
    )
    for name in _GOLDEN
]

sh_binary(
    name = "update_golden",
    testonly = True,
    srcs = ["update_golden.sh"],
    args = ["$(rootpaths :generate)"],
    data = [":generate"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
