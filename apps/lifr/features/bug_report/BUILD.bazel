load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Bug reports: recording the steps that led to a problem, describing it,
# and the reports kept encrypted on this device for Settings › Bug Reports.
swift_library(
    name = "bug_report",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrBugReport",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/features/root:__subpackages__",
        "//apps/lifr/features/settings:__pkg__",
    ],
    deps = [
        "//apps/lifr/clients/models",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# The recorder, redaction, storage and both screens' TestStore tests, on
# macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":bug_report",
        "//apps/lifr/clients/models",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
