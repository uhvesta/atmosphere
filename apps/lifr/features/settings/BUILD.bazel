load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//apps/lifr/testing/snapshot:defs.bzl", "lifr_snapshot_test")

# Settings: when tasks count as Procrastinated, agent access per Avenue,
# connected apps, the CLI install, and the models each use runs on. Also the
# sheet that approves an app.
swift_library(
    name = "settings",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrSettings",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/features:__subpackages__",
    ],
    deps = [
        "//apps/libs/features/chat",
        "//apps/libs/features/models",
        "//apps/libs/kits/chatui",
        "//apps/lifr/api",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/lock",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/reminders",
        "//apps/lifr/clients/session",
        "//apps/lifr/clients/store",
        "//apps/lifr/clients/sync",
        "//apps/lifr/core",
        "//apps/lifr/features/bug_report",
        "//apps/lifr/features/skills",
        "//apps/lifr/features/task_detail",
        "//apps/lifr/ui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":settings",
        "//apps/libs/features/models",
        "//apps/lifr/api",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/lock",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/session",
        "//apps/lifr/clients/store",
        "//apps/lifr/clients/sync",
        "//apps/lifr/core",
        "//apps/lifr/features/bug_report",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

# Display data, accessibility tree and images, on the pinned simulator.
lifr_snapshot_test(
    name = "snapshot_test",
    srcs = glob(["SnapshotTests/*.swift"]),
    deps = [
        ":settings",
        "//apps/libs/features/models",
        "//apps/lifr/api",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/lock",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/session",
        "//apps/lifr/clients/store",
        "//apps/lifr/clients/sync",
        "//apps/lifr/core",
        "//apps/lifr/features/bug_report",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
