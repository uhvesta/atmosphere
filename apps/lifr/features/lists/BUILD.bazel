load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Anytime, Later and the Logbook: lists across every Avenue by start date,
# and of closed tasks.
swift_library(
    name = "lists",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrLists",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/features/root:__pkg__"],
    deps = [
        "//apps/lifr/core",
        "//apps/lifr/features/task_list",
        "//apps/lifr/ui",
    ],
)

# Query tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":lists",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/task_list",
        "//apps/lifr/ui",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
