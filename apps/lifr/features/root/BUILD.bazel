load("//apps/libs/kits/inference/litert:test_model.bzl", "GEMMA_4_E2B")
load("//apps/lifr/testing/snapshot:defs.bzl", "lifr_snapshot_test")

_DEPS = [
    "//apps/libs/features/models",
    "//apps/libs/kits/chatui",
    "//apps/lifr/api",
    "//apps/lifr/clients/feedback",
    "//apps/lifr/clients/lock",
    "//apps/lifr/clients/pasteboard",
    "//apps/lifr/clients/reminders",
    "//apps/lifr/clients/session",
    "//apps/lifr/clients/spotlight",
    "//apps/lifr/clients/store",
    "//apps/lifr/clients/sync",
    "//apps/lifr/core",
    "//apps/lifr/features/avenue",
    "//apps/lifr/features/board",
    "//apps/lifr/features/calendar",
    "//apps/lifr/features/trash",
    "//apps/lifr/features/bug_report",
    "//apps/lifr/features/conversations",
    "//apps/lifr/features/lists",
    "//apps/lifr/features/procrastinated",
    "//apps/lifr/features/quick_add",
    "//apps/lifr/features/search",
    "//apps/lifr/features/settings",
    "//apps/lifr/features/sync_review",
    "//apps/lifr/features/task_detail",
    "//apps/lifr/features/task_list",
    "//apps/lifr/features/today",
    "//apps/lifr/features/upcoming",
    "//apps/lifr/ui",
    "//apps/lifr/widgets:client",
    "//apps/lifr/widgets:glance",
    "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
]

# The app's screens together: the iPhone's tabs or the Mac's sidebar, quick
# add, the sync banner, the approval sheet, the Mac's commands and menu bar.
swift_library(
    name = "root",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrRoot",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/app:__subpackages__"],
    deps = _DEPS,
)

# TestStore tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":root",
        "//apps/lifr/clients/models",
    ] + _DEPS,
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

# The spec's UX flows, end to end through the root store.
swift_library(
    name = "flow_tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["FlowTests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":root",
        "//apps/lifr/features/shortcuts",
    ] + _DEPS,
)

macos_unit_test(
    name = "flow_tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":flow_tests_lib"],
)

# Display data, accessibility tree and images, on the pinned simulator.
lifr_snapshot_test(
    name = "snapshot_test",
    srcs = glob(["SnapshotTests/*.swift"]),
    deps = [
        ":root",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
    ] + _DEPS,
)

# Each of a person's flows on the iPhone, step by step through the live
# app: the accessibility tree and an image per step. One test per area, so
# the areas run side by side on simulators of their own; `:flow_snapshot_test`
# runs them all.
_PHONE_FLOWS = {
    "assistant": "PhoneAssistantFlowTests",
    "assistant_edits": "PhoneAssistantEditsFlowTests",
    "chat": "PhoneChatFlowTests",
    "settings": "PhoneSettingsFlowTests",
    "tasks": "PhoneTasksFlowTests",
    "today": "PhoneTodayFlowTests",
    "widgets": "PhoneWidgetsFlowTests",
}

[
    lifr_snapshot_test(
        name = "flow_snapshot_test_" + area,
        srcs = [
            "FlowSnapshotTests/PhoneFlowTestCase.swift",
            "FlowSnapshotTests/{}.swift".format(tests),
        ],
        hosted = True,
        deps = [
            ":root",
            "//apps/libs/features/chat",
            "//apps/libs/kits/capture",
            "//apps/lifr/clients/assistant",
            "//apps/lifr/clients/assistant_live",
            "//apps/lifr/clients/models",
            "//apps/lifr/clients/search",
            "//apps/lifr/features/shortcuts",
            "//apps/lifr/widgets:views",
            "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
        ] + _DEPS,
    )
    for area, tests in _PHONE_FLOWS.items()
]

test_suite(
    name = "flow_snapshot_test",
    tests = [":flow_snapshot_test_" + area for area in _PHONE_FLOWS],
)

# The same flows on the Mac, in windows on this Mac: the accessibility tree
# and an image of every window per step. Manual, since `bazel test` can't
# read other windows: run it with //apps/libs/kits/flow:run_mac.sh.
lifr_snapshot_test(
    name = "mac_flow_snapshot_test",
    srcs = glob(["MacFlowSnapshotTests/*.swift"]),
    mac = True,
    tags = ["manual"],
    deps = [
        ":root",
        "//apps/libs/features/chat",
        "//apps/libs/kits/capture",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/assistant_live",
        "//apps/lifr/clients/models",
        "//apps/lifr/features/shortcuts",
        "//apps/lifr/widgets:views",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
    ] + _DEPS,
)

# Where the test's model is, and the SHA-256 Bazel checked it against, for
# the test to find it and check the catalog pins the same file.
genrule(
    name = "test_model_swift",
    testonly = True,
    srcs = ["@lifr_test_model//:{}".format(GEMMA_4_E2B.path)],
    outs = ["TestModel.swift"],
    cmd = """cat > $@ <<'EOF'
enum TestModel {{
    static let runfile = "$(rlocationpath @lifr_test_model//:{path})"
    static let sha256 = "{sha256}"
}}
EOF""".format(
        path = GEMMA_4_E2B.path,
        sha256 = GEMMA_4_E2B.sha256,
    ),
)

# The assistant on a real model, Gemma 4 E2B on this Mac's GPU, through
# the live app: a reply, its draft, adding it and undoing that. The model's
# words differ from one GPU to the next, so the trees leave them out and the
# test checks what changed instead. Manual: it downloads 2.6 GB, takes
# minutes, and needs what the Mac flows need. Run it with
# //apps/libs/kits/flow:run_mac.sh.
lifr_snapshot_test(
    name = "model_e2e_test",
    srcs = glob(["ModelE2ETests/*.swift"]) + [":test_model_swift"],
    # LiteRT-LM's runtime, which the app copies there itself.
    additional_contents = {"@litert_lm//:libCLiteRTLM_mac.dylib": "Frameworks"},
    data = ["@lifr_test_model//:{}".format(GEMMA_4_E2B.path)],
    mac = True,
    tags = ["manual"],
    deps = [
        ":root",
        "//apps/libs/kits/inference/litert",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/assistant_live",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/models_live",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
    ] + _DEPS,
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
