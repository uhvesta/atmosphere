load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Onboarding: the first launch on a device. What Avenues, Projects and tasks
# are, a few Avenues to start with, and the optional permissions.
swift_library(
    name = "onboarding",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrOnboarding",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/features:__subpackages__"],
    deps = [
        "//apps/lifr/clients/lock",
        "//apps/lifr/clients/reminders",
        "//apps/lifr/clients/store",
        "//apps/lifr/clients/sync",
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":onboarding",
        "//apps/lifr/clients/lock",
        "//apps/lifr/clients/reminders",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
