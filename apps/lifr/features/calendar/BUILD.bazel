load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Calendar: a month of tasks by the day they're due, the selected day's
# tasks under it, and dropping a task on a day to move it there.
swift_library(
    name = "calendar",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrCalendar",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/features:__subpackages__"],
    deps = [
        "//apps/lifr/clients/feedback",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/task_list",
        "//apps/lifr/ui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":calendar",
        "//apps/lifr/clients/feedback",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/task_list",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
