load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//apps/lifr/testing/snapshot:defs.bzl", "lifr_snapshot_test")

# Conversations with the assistant: the list, and each chat with its draft
# card and Undo for what the assistant changed.
swift_library(
    name = "conversations",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrConversations",
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/features/root:__pkg__"],
    deps = [
        "//apps/libs/features/chat",
        "//apps/libs/kits/assistant",
        "//apps/libs/kits/capture",
        "//apps/libs/kits/chat",
        "//apps/libs/kits/chatui",
        "//apps/lifr/api",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/search",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/skills",
        "//apps/lifr/ui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":conversations",
        "//apps/libs/features/chat",
        "//apps/libs/kits/capture",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/search",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

# Accessibility tree and images of a chat with a draft, on the pinned
# simulator.
lifr_snapshot_test(
    name = "snapshot_test",
    srcs = glob(["SnapshotTests/*.swift"]),
    deps = [
        ":conversations",
        "//apps/libs/kits/capture",
        "//apps/libs/kits/chatui",
        "//apps/libs/kits/inference",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
