load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//apps/lifr/testing/snapshot:defs.bzl", "lifr_snapshot_test")

# Quick Add: a task in a few taps, or a task and its Sub tasks.
swift_library(
    name = "quick_add",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrQuickAdd",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/features:__subpackages__",
    ],
    deps = [
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/task_detail",
        "//apps/lifr/features/task_list",
        "//apps/lifr/ui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

# TestStore tests, on macOS.
swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":quick_add",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/task_detail",
        "//apps/lifr/features/task_list",
        "//apps/lifr/ui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

# Display data, accessibility tree and images, on the pinned simulator.
lifr_snapshot_test(
    name = "snapshot_test",
    srcs = glob(["SnapshotTests/*.swift"]),
    deps = [
        ":quick_add",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/task_list",
        "//apps/lifr/ui",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
