load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Shortcuts and Siri: add a task, what's on Today, finish a task. The app
# lists this library in `app_intents`, so the intents are found at build.
swift_library(
    name = "shortcuts",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    # Named, so the app's App Intents step sees the framework.
    linkopts = ["-Wl,-framework,AppIntents"],
    module_name = "LifrShortcuts",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/features/root:__pkg__",
    ],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "//apps/lifr/features/task_list",
        "//apps/lifr/features/today",
        "//apps/lifr/ui",
    ],
)

swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":shortcuts",
        "//apps/lifr/clients/store",
        "//apps/lifr/core",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
