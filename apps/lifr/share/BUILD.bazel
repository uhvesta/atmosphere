load("@lifr_identity//:defs.bzl", "IOS_APP_GROUP", "SHARE_BUNDLE_ID")
load("@rules_apple//apple:ios.bzl", "ios_extension")
load("@rules_apple//apple:macos.bzl", "macos_extension", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//apps/lifr:signing.bzl", "lifr_entitlements")

# Lifr in the share sheet: a link or text another app shares becomes a
# task. The extension can't open the records, so it queues the task in the
# App Group and Lifr adds it the next time it opens.

swift_library(
    name = "share_lib",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrShare",
    target_compatible_with = ["//bazel/xcode"],
    # The app's catalog lists its words.
    visibility = ["//apps/lifr/app:__pkg__"],
    deps = [
        "//apps/lifr/core",
        "//apps/lifr/widgets:glance",
    ],
)

# Built but not yet in the iPhone app: its bundle ID needs the App Group
# assigned in the developer portal and an App Store profile from
# tools/testflight first.
ios_extension(
    name = "ios",
    bundle_id = SHARE_BUNDLE_ID,
    bundle_name = "LifrShare",
    entitlements = select({
        "//apps/lifr:is_signed": ":ios_entitlements",
        "//conditions:default": None,
    }) if IOS_APP_GROUP else None,
    families = ["iphone"],
    infoplists = ["Extension/Info.plist"],
    minimum_os_version = "18.0",
    provisioning_profile = select({
        "@apple_support//constraints:device": "//apps/lifr/app:ios_development",
        "//conditions:default": None,
    }),
    resources = ["//apps/lifr/app:Resources/Localizable.xcstrings"],
    target_compatible_with = ["//bazel/xcode"],
    version = "//apps/lifr/app:ios_version",
    deps = [":share_lib"],
)

macos_extension(
    name = "macos",
    bundle_id = SHARE_BUNDLE_ID,
    bundle_name = "LifrShare",
    codesignopts = ["--options=runtime"],
    entitlements = select({
        "//apps/lifr:is_signed": ":mac_entitlements",
        "//conditions:default": ":unsigned_mac_entitlements",
    }),
    infoplists = ["Extension/Info.plist"],
    minimum_os_version = "15.0",
    resources = ["//apps/lifr/app:Resources/Localizable.xcstrings"],
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/app:__pkg__"],
    deps = [":share_lib"],
)

lifr_entitlements(
    name = "ios_entitlements",
    icloud = False,
    ios_app_group = True,
)

lifr_entitlements(
    name = "mac_entitlements",
    app_group = True,
    icloud = False,
    sandbox = True,
)

# Unsigned, macOS gives the extension no App Group, so adding says Lifr
# needs a signed build.
lifr_entitlements(
    name = "unsigned_mac_entitlements",
    icloud = False,
    sandbox = True,
)

swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [":share_lib"],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
