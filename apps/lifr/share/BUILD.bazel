load("@lifr_identity//:defs.bzl", "SHARE_BUNDLE_ID", "SHARE_KEYCHAIN_GROUP")
load("@rules_apple//apple:ios.bzl", "ios_extension")
load("@rules_apple//apple:macos.bzl", "macos_extension", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//apps/lifr:signing.bzl", "lifr_entitlements")

# Lifr in the share sheet: a link or text another app shares becomes a
# task. The extension can't open the records, so it queues the task in the
# App Group, or on an iPhone without one in a keychain group it shares with
# Lifr, and Lifr adds it the next time it opens.

swift_library(
    name = "share_lib",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrShare",
    target_compatible_with = ["//bazel/xcode"],
    # The app's catalog lists its words.
    visibility = ["//apps/lifr/app:__pkg__"],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/core",
        "//apps/lifr/widgets:glance",
    ],
)

# In signed iPhone builds; tools/testflight registers its App ID and makes
# its App Store profile.
ios_extension(
    name = "ios",
    bundle_id = SHARE_BUNDLE_ID,
    bundle_name = "LifrShare",
    entitlements = select({
        "//apps/lifr:is_signed": ":ios_entitlements_signed",
        "//conditions:default": None,
    }),
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = [
        "Extension/Info.plist",
        "Extension/Info-iOS.plist",
    ],
    minimum_os_version = "18.0",
    provisioning_profile = select({
        "//apps/lifr:is_app_store": "//apps/lifr/app:ios_share_app_store",
        "@apple_support//constraints:device": "//apps/lifr/app:ios_development",
        "//conditions:default": None,
    }),
    resources = ["//apps/lifr/app:Resources/Localizable.xcstrings"],
    target_compatible_with = ["//bazel/xcode"],
    version = "//apps/lifr/app:ios_version",
    visibility = ["//apps/lifr/app:__pkg__"],
    deps = [":share_lib"],
)

macos_extension(
    name = "macos",
    bundle_id = SHARE_BUNDLE_ID,
    bundle_name = "LifrShare",
    codesignopts = ["--options=runtime"],
    entitlements = select({
        "//apps/lifr:is_signed": ":mac_entitlements",
        "//conditions:default": ":unsigned_mac_entitlements",
    }),
    infoplists = ["Extension/Info.plist"],
    minimum_os_version = "15.0",
    resources = ["//apps/lifr/app:Resources/Localizable.xcstrings"],
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/lifr/app:__pkg__"],
    deps = [":share_lib"],
)

lifr_entitlements(
    name = "ios_entitlements_signed",
    icloud = False,
    ios_app_group = True,
    keychain_groups = [SHARE_KEYCHAIN_GROUP],
)

lifr_entitlements(
    name = "mac_entitlements",
    app_group = True,
    icloud = False,
    sandbox = True,
)

# Unsigned, macOS gives the extension no App Group, so adding says Lifr
# needs a signed build.
lifr_entitlements(
    name = "unsigned_mac_entitlements",
    icloud = False,
    sandbox = True,
)

swift_library(
    name = "tests_lib",
    package_name = "lifr",
    testonly = True,
    srcs = glob(["Tests/*.swift"]),
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        ":share_lib",
        "//apps/lifr/core",
    ],
)

macos_unit_test(
    name = "tests",
    minimum_os_version = "15.0",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":tests_lib"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
