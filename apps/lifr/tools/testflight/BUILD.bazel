load(
    "@lifr_identity//:defs.bzl",
    "BUNDLE_ID",
    "SHARE_BUNDLE_ID",
    "SHARE_IN_APP",
    "TEAM_ID",
    "WIDGETS_BUNDLE_ID",
)
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

# Uploads the iPhone app to TestFlight from this Mac:
#   bazel run --config=xcode //apps/lifr/tools/testflight:upload
# Once, first: store the App Store Connect API key in the login Keychain.
#   bazel run --config=xcode //apps/lifr/tools/testflight:setup -- <.p8> <Key ID> <Issuer ID>
# LocalLogChatr's upload (//apps/locallogchatr/tools/testflight) runs the same
# script and key with its own app.

# The App Store Connect API calls upload.sh makes.
swift_binary(
    name = "asc",
    srcs = ["main.swift"],
    target_compatible_with = ["//bazel/xcode"],
    visibility = ["//apps/locallogchatr/tools/testflight:__pkg__"],
)

exports_files(
    ["upload.sh"],
    visibility = ["//apps/locallogchatr/tools/testflight:__pkg__"],
)

sh_binary(
    name = "setup",
    srcs = ["setup.sh"],
)

# See upload.sh for what each argument is. Bazel splits args at spaces like
# a shell, so those with a space in them are quoted.
sh_binary(
    name = "upload",
    srcs = ["upload.sh"],
    args = [
        TEAM_ID or "none",
        "$(rootpath :asc)",
        "Lifr",
        "lifr_testflight",
        "//apps/lifr/app:ios",
        "lifr",
        "'" + BUNDLE_ID + "|Lifr|Lifr App Store|lifr-app-store'",
        "'" + WIDGETS_BUNDLE_ID + "|Lifr Widgets|Lifr Widgets App Store|lifr-widgets-app-store'",
    ] + ([
        # The share extension, once LIFR_IOS_EXTRAS in user.bazelrc lists it.
        "'" + SHARE_BUNDLE_ID + "|Lifr Share|Lifr Share App Store|lifr-share-app-store'",
    ] if SHARE_IN_APP else []),
    data = [":asc"],
    target_compatible_with = ["//bazel/xcode"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
