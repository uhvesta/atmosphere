load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@lifr_identity//:defs.bzl", "BUNDLE_ID", "IOS_APP_GROUP", "TEAM_ID")
load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_apple//apple:xcarchive.bzl", "xcarchive")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//apps/lifr:signing.bzl", "lifr_entitlements")
load(":strings.bzl", "lifr_strings")

# The SwiftUI app, shared by iOS and macOS. Needs Xcode: build with
# `--config=xcode` (see //bazel/xcode).

swift_library(
    name = "app_lib",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrApp",
    target_compatible_with = ["//bazel/xcode"],
    deps = [
        "//apps/lifr/api",
        "//apps/lifr/clients/assistant",
        "//apps/lifr/clients/assistant_live",
        "//apps/lifr/clients/lock",
        "//apps/lifr/clients/models",
        "//apps/lifr/clients/models_litert",
        "//apps/lifr/clients/models_live",
        "//apps/lifr/clients/reminders",
        "//apps/lifr/clients/reminders_live",
        "//apps/lifr/clients/session",
        "//apps/lifr/clients/session_live",
        "//apps/lifr/clients/store",
        "//apps/lifr/clients/store_live",
        "//apps/lifr/clients/sync",
        "//apps/lifr/clients/sync_live",
        "//apps/lifr/core",
        "//apps/lifr/features/root",
        "//apps/lifr/features/shortcuts",
        "//apps/lifr/widgets:client",
        "//apps/lifr/widgets:glance",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

ios_application(
    name = "ios",
    app_icons = glob(["Resources/iOS.xcassets/**"]),
    # Add a task, what's on today and finish a task, in Shortcuts and Siri.
    app_intents = ["//apps/lifr/features/shortcuts"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Lifr",
    # Stops a signed build that has no team in user.bazelrc.
    codesign_inputs = select({
        "//apps/lifr:is_signed": [":ios_signing_check"],
        "//conditions:default": [],
    }),
    # The App Group the widgets read Today from, only when user.bazelrc
    # sets one: it needs an explicit App ID's profile.
    entitlements = select({
        "//apps/lifr:is_signed": ":ios_app_group",
        "//conditions:default": None,
    }) if IOS_APP_GROUP else None,
    # Today on the Home Screen.
    extensions = ["//apps/lifr/widgets:ios"],
    families = ["iphone"],
    infoplists = [
        "Info.plist",
        "Info-iOS.plist",
    ],
    minimum_os_version = "18.0",
    # Any device build, so Xcode can run it on a phone; the simulator
    # needs none. TestFlight uploads use the App Store one.
    provisioning_profile = select({
        "//apps/lifr:is_app_store": ":ios_app_store",
        "@apple_support//constraints:device": ":ios_development",
        "//conditions:default": None,
    }),
    resources = ["Resources/Localizable.xcstrings"],
    target_compatible_with = ["//bazel/xcode"],
    version = ":ios_version",
    # For the generated Xcode project (//apps/lifr:xcodeproj).
    visibility = ["@rules_xcodeproj//xcodeproj:generated"],
    deps = [":app_lib"],
)

# The iPhone build number: 1.0, or the UTC date and time tools/testflight
# passes with --embed_label=lifr_<YYYYMMDD>_<HHMM>, so each upload is newer
# than the last.
apple_bundle_version(
    name = "ios_version",
    build_label_pattern = "lifr_{day}_{time}",
    build_version = "{day}.{time}",
    capture_groups = {
        "day": "\\d{1,8}",
        "time": "\\d{1,4}",
    },
    fallback_build_label = "lifr_1_0",
    short_version_string = "1.0",
    visibility = ["//apps/lifr/widgets:__pkg__"],
)

macos_application(
    name = "macos",
    # Helpers, not MacOS: on a case-insensitive disk the CLI, `lifr`, would
    # collide with the app's executable, `Lifr`.
    additional_contents = {"//apps/lifr/cli:lifr": "Helpers"},
    app_icons = glob(["Resources/Mac.xcassets/**"]),
    app_intents = ["//apps/lifr/features/shortcuts"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Lifr",
    # The hardened runtime: no injected libraries, no unsigned code.
    codesignopts = ["--options=runtime"],
    # The App Group whose container holds the local API's socket, and the
    # microphone, for recordings sent to the assistant.
    entitlements = select({
        "//apps/lifr:is_signed": ":app_group",
        "//conditions:default": ":unsigned_mac",
    }),
    # Today on the desktop and in Notification Center.
    extensions = ["//apps/lifr/widgets:macos"],
    infoplists = [
        "Info.plist",
        "Info-macOS.plist",
    ],
    minimum_os_version = "15.0",
    resources = ["Resources/Localizable.xcstrings"],
    target_compatible_with = ["//bazel/xcode"],
    # For the generated Xcode project (//apps/lifr:xcodeproj).
    visibility = ["@rules_xcodeproj//xcodeproj:generated"],
    deps = [":app_lib"],
)

lifr_entitlements(
    name = "app_group",
    app_group = True,
    microphone = True,
)

lifr_entitlements(
    name = "unsigned_mac",
    icloud = False,
    microphone = True,
)

lifr_entitlements(
    name = "ios_signing_check",
)

lifr_entitlements(
    name = "ios_app_group",
    icloud = False,
    ios_app_group = True,
)

# The team's development profile for the iPhone app. iCloud needs an
# explicit App ID's profile instead; see the M10 notes in the spec.
local_provisioning_profile(
    name = "ios_development",
    profile_name = "iOS Team Provisioning Profile: *",
    team_id = TEAM_ID,
    # The widgets' extension signs with it too.
    visibility = ["//apps/lifr/widgets:__pkg__"],
)

# The App Store profiles tools/testflight makes and installs, for the
# iPhone app and its widgets.
local_provisioning_profile(
    name = "ios_app_store",
    profile_name = "Lifr App Store",
    team_id = TEAM_ID,
)

local_provisioning_profile(
    name = "ios_widgets_app_store",
    profile_name = "Lifr Widgets App Store",
    team_id = TEAM_ID,
    visibility = ["//apps/lifr/widgets:__pkg__"],
)

# Archives for Xcode's Organizer, with dSYMs. Build them signed:
#   bazel build --config=lifr_mac_release //apps/lifr/app:macos_archive
#   bazel build --config=lifr_ios_device //apps/lifr/app:ios_archive
xcarchive(
    name = "ios_archive",
    bundle = ":ios",
    tags = ["manual"],
    target_compatible_with = ["//bazel/xcode"],
)

xcarchive(
    name = "macos_archive",
    bundle = ":macos",
    tags = ["manual"],
    target_compatible_with = ["//bazel/xcode"],
)

# The words the app shows, in every language it speaks. English is the
# source: views use their English text as the key, and other code uses
# String(localized:). Translations go in the catalog.
lifr_strings(
    name = "strings",
    catalog = "Resources/Localizable.xcstrings",
    target_compatible_with = ["//bazel/xcode"],
    deps = [":app_lib"],
)

diff_test(
    name = "strings_test",
    failure_message = "The app's strings changed. Run `bazel run --config=xcode //apps/lifr/app:update_strings`, then translate the new strings in the diff.",
    file1 = "Resources/Localizable.xcstrings",
    file2 = ":strings",
    target_compatible_with = ["//bazel/xcode"],
)

sh_binary(
    name = "update_strings",
    srcs = ["update_strings.sh"],
    args = ["$(rootpath :strings)"],
    data = [":strings"],
    target_compatible_with = ["//bazel/xcode"],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "strings.bzl",
    ],
    tags = ["starlark"],
)
