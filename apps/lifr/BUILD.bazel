load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcodeproj")

# Signs the Mac app and `lifr` for the team in user.bazelrc (see identity.bzl),
# and gives the iPhone app its App Group. Any iPhone build for a device uses
# the team's development profile, set or not. Set by
# --config=lifr_mac_release and --config=lifr_ios_device in .bazelrc. Off, the apps are signed ad hoc and
# build anywhere Xcode is installed, but `lifr` can't connect to the app.
bool_flag(
    name = "signed",
    build_setting_default = False,
)

config_setting(
    name = "is_signed",
    flag_values = {":signed": "true"},
    # rules_apple's macros check select() keys against their own package.
    visibility = [
        "//apps/lifr/app:__pkg__",
        "//apps/lifr/cli:__pkg__",
        "//apps/lifr/widgets:__pkg__",
        "@rules_apple//apple:__pkg__",
    ],
)

# Signs the iPhone app and its widgets for the App Store, to upload to
# TestFlight, with the profiles tools/testflight makes. Set by
# --config=lifr_testflight in .bazelrc.
bool_flag(
    name = "app_store",
    build_setting_default = False,
)

# A signed device build for the App Store: more specific than the device
# constraint or signing alone, so it wins the profile and entitlements
# select()s.
config_setting(
    name = "is_app_store",
    constraint_values = ["@apple_support//constraints:device"],
    flag_values = {
        ":app_store": "true",
        ":signed": "true",
    },
    visibility = [
        "//apps/lifr/app:__pkg__",
        "//apps/lifr/widgets:__pkg__",
        "@rules_apple//apple:__pkg__",
    ],
)

# Generates Lifr.xcodeproj for previews, the debugger and Instruments:
# `bazel run //apps/lifr:xcodeproj`. Xcode builds through Bazel with
# `--config=rules_xcodeproj`, which .bazelrc points at `--config=xcode`.
# The iPhone app builds for the simulator or, with the team's development
# profile, for a connected phone.
xcodeproj(
    name = "xcodeproj",
    project_name = "Lifr",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            "//apps/lifr/app:ios",
            target_environments = [
                "device",
                "simulator",
            ],
        ),
        "//apps/lifr/app:macos",
        "//apps/lifr/cli:lifr",
    ],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "identity.bzl",
        "signing.bzl",
    ],
    tags = ["starlark"],
)
