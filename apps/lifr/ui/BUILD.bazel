load("@rules_swift//swift:swift_library.bzl", "swift_library")

# Lifr's shared SwiftUI views and the display data they show. Plain SwiftUI,
# no TCA, so features and previews can use them with any data. Needs Xcode for
# SwiftUI: build with `--config=xcode`.
swift_library(
    name = "ui",
    package_name = "lifr",
    srcs = glob(["Sources/*.swift"]),
    module_name = "LifrUI",
    target_compatible_with = ["//bazel/xcode"],
    visibility = [
        "//apps/lifr/app:__subpackages__",
        "//apps/lifr/features:__subpackages__",
    ],
    deps = ["//apps/lifr/core"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
