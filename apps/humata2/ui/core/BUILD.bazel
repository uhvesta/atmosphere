load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["src/keys.rs"],
    visibility = ["//apps/humata2/features/app:__pkg__"],
)

rust_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    aliases = {"//apps/humata2/clients:api": "humata2_clients"},
    # GPUI's macros find gpui-kit through it.
    compile_data = ["Cargo.toml"],
    crate_name = "humata2_ui_core",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/ui:__subpackages__",
    ],
    deps = [
        "//apps/humata2/clients:api",
        "//apps/humata2/features/app",
        "//apps/humata2/features/session",
        "//libs/tca-rust:tca",
        "@crates//:gpui-kit",
        "@crates//:tokio",
        "@crates//:unicode-segmentation",
        "@crates//:unicode-width",
    ],
)

rust_test(
    name = "core_unit_test",
    crate = ":core",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
