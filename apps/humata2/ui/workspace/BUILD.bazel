load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "workspace",
    srcs = glob(["src/**/*.rs"]),
    aliases = {"//apps/humata2/clients:api": "humata2_clients"},
    # GPUI's macros find gpui-kit through it.
    compile_data = ["Cargo.toml"],
    crate_name = "humata2_ui_workspace",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/ui:__pkg__",
    ],
    deps = [
        "//apps/humata2/clients:api",
        "//apps/humata2/features/app",
        "//apps/humata2/features/board",
        "//apps/humata2/features/files",
        "//apps/humata2/features/find",
        "//apps/humata2/features/hosts",
        "//apps/humata2/features/inbox",
        "//apps/humata2/features/pr_review",
        "//apps/humata2/features/session",
        "//apps/humata2/features/sidebar",
        "//apps/humata2/features/todo",
        "//apps/humata2/features/views",
        "//apps/humata2/terminal/client:terminal_replica",
        "//apps/humata2/terminal/grid:terminal_grid",
        "//apps/humata2/terminal/pane:terminal_pane",
        "//apps/humata2/terminal/view:terminal_view",
        "//apps/humata2/terminal/vt:ghostty_vt",
        "//apps/humata2/terminal/wire",
        "//apps/humata2/todo",
        "//apps/humata2/ui/changes",
        "//apps/humata2/ui/core",
        "//apps/humata2/ui/desk",
        "//apps/humata2/ui/machines",
        "//apps/humata2/ui/settings",
        "@crates//:gpui-kit",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "workspace_unit_test",
    aliases = {"//apps/humata2/clients": "humata2_clients_fakes"},
    crate = ":workspace",
    deps = [
        "//apps/humata2/clients",
        "//libs/tca-rust:tca",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
