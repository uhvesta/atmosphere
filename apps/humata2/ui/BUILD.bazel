load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    ["src/keys.rs"],
    visibility = ["//apps/humata2/features/app:__pkg__"],
)

# Humata 2's GPUI views over the feature states, and the one bridge between
# the app's tca-rust store and GPUI (ui/src/bridge.rs). On ordinary GPUI
# only for now; the desktop app picks the engine and builds the GPUI
# resources from `humata2_ui::Assets`.
FEATURES = [
    "app",
    "board",
    "desk",
    "files",
    "find",
    "hosts",
    "inbox",
    "palette",
    "pr_review",
    "review",
    "session",
    "settings",
    "sidebar",
    "views",
]

rust_library(
    name = "ui",
    srcs = [
        "src/lib.rs",
        "src/lists.rs",
        "src/pages.rs",
        "src/panels.rs",
        "src/restart_report.rs",
        "src/shell.rs",
        "src/starting.rs",
    ],
    aliases = {
        "//apps/humata2/clients:api": "humata2_clients",
    },
    # GPUI's macros find gpui-kit through it.
    compile_data = ["Cargo.toml"],
    crate_name = "humata2_ui",
    visibility = ["//apps/humata2/desktop:__pkg__"],
    deps = [
        "//apps/humata2/clients:api",
        "//apps/humata2/ui/changes",
        "//apps/humata2/ui/core",
        "//apps/humata2/ui/desk",
        "//apps/humata2/ui/machines",
        "//apps/humata2/ui/overlays",
        "//apps/humata2/ui/report",
        "//apps/humata2/ui/settings",
        "//apps/humata2/ui/workspace",
        "//libs/tca-rust:tca",
        "@crates//:gpui-kit",
        "@crates//:unicode-width",
    ] + ["//apps/humata2/features/%s" % feature for feature in FEATURES],
)

rust_test(
    name = "ui_unit_test",
    crate = ":ui",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
