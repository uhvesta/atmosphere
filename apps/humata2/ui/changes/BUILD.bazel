load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "changes",
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//apps/humata2/clients:api": "humata2_clients",
    },
    # GPUI's macros find gpui-kit through it.
    compile_data = ["Cargo.toml"],
    crate_name = "humata2_ui_changes",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/ui:__subpackages__",
    ],
    deps = [
        "//apps/humata2/clients:api",
        "//apps/humata2/features/app",
        "//apps/humata2/features/pr_review",
        "//apps/humata2/features/review",
        "//apps/humata2/features/session",
        "//apps/humata2/features/settings",
        "//apps/humata2/markdown",
        "//apps/humata2/ui/core",
        "@crates//:gpui-kit",
        "@crates//:unicode-segmentation",
        "@crates//:unicode-width",
    ],
)

rust_test(
    name = "changes_unit_test",
    aliases = {
        "//apps/humata2/clients": "humata2_clients_fakes",
    },
    crate = ":changes",
    deps = [
        "//apps/humata2/clients",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
