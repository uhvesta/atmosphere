load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "machines",
    srcs = glob(["src/**/*.rs"]),
    aliases = {"//apps/humata2/clients:api": "humata2_clients"},
    # GPUI's macros find gpui-kit through it.
    compile_data = ["Cargo.toml"],
    crate_name = "humata2_ui_machines",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/ui:__subpackages__",
    ],
    deps = [
        "//apps/humata2/clients:api",
        "//apps/humata2/features/app",
        "//apps/humata2/features/files",
        "//apps/humata2/features/hosts",
        "//apps/humata2/features/mass_delete",
        "//apps/humata2/ui/core",
        "@crates//:gpui-kit",
    ],
)

rust_test(
    name = "machines_unit_test",
    crate = ":machines",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
