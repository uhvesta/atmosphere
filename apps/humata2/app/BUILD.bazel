load("@lifr_identity//:defs.bzl", "HUMATA2_BUNDLE_ID")
load("//tools/notices:linked.bzl", "humata2_linked_crates")
load(":app.bzl", "humata2_app")

# Humata 2.app for Apple silicon Macs: the desktop window, with humatad2,
# the holder and the humata CLI in Contents/Helpers, which the app installs
# into ~/.humata2 on launch, and THIRD_PARTY_NOTICES.txt generated from the
# crate lock (//tools/notices). Signed ad hoc here; a release signs it with
# Developer ID (tools/release/release.sh). Build it with
# `bazel build --compilation_mode=opt //apps/humata2/app`.
humata2_app(
    name = "app",
    bundle_id = HUMATA2_BUNDLE_ID,
    executable = "//apps/humata2/desktop:humata2",
    icon = "//apps/humata2/app/icon:icns",
    infoplist = "Info.plist",
    notices = "@humata2_notices//:THIRD_PARTY_NOTICES.txt",
    platform = "darwin-arm64",
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    tools = "//apps/humata2/daemon/humatad:tools_mac",
)

# The external crates the app's binaries link, which the notices must cover
# (//tools/notices:notices_test).
humata2_linked_crates(
    name = "linked_crates",
    binaries = [
        "//apps/humata2/daemon/humatad:tools_mac",
        "//apps/humata2/desktop:humata2",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//tools/notices:__pkg__"],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "app.bzl",
    ],
    tags = ["starlark"],
)
