load("@lifr_identity//:defs.bzl", "HUMATA2_BUNDLE_ID", "TEAM_ID")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/notices:linked.bzl", "humata2_linked_crates")
load(":app.bzl", "humata2_app")
load(":fskit.bzl", "humata2_fskit_appex")

_HUMATA2_APP_GROUP = (TEAM_ID or "UNSIGNED") + "." + HUMATA2_BUNDLE_ID

humata2_fskit_appex(
    name = "fskit_appex",
    srcs = [
        "fskit/BridgeClient.swift",
        "fskit/HumataFSExtension.swift",
    ],
    app_group = _HUMATA2_APP_GROUP,
    bundle_id = HUMATA2_BUNDLE_ID + ".fskit",
    entitlements = "fskit/HumataFS.entitlements",
    infoplist = "fskit/Info.plist",
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

sh_test(
    name = "fskit_appex_test",
    srcs = ["fskit_appex_test.sh"],
    args = ["$(rootpath :fskit_appex)"],
    data = [":fskit_appex"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

# Humata 2.app for Apple silicon Macs: the desktop window, with humatad2,
# the holder, the humata CLI and the stack CLI in Contents/Helpers, which the app installs
# into ~/.humata2 on launch, and THIRD_PARTY_NOTICES.txt generated from the
# crate lock (//tools/notices). Signed ad hoc here; a release signs it with
# Developer ID (tools/release/release.sh). Build it with
# `bazel build --compilation_mode=opt //apps/humata2/app`.
humata2_app(
    name = "app",
    browser_extension = "//apps/humata2/browser_extension:bundle",
    bundle_id = HUMATA2_BUNDLE_ID,
    executable = "//apps/humata2/desktop:humata2",
    fskit_appex = ":fskit_appex",
    icon = "//apps/humata2/app/icon:icns",
    infoplist = "Info.plist",
    # The Linux tools Add machine installs (TS-2); not in the fakes app.
    machine_tools = "//apps/humata2/daemon/humatad:tools_linux",
    notices = "@humata2_notices//:THIRD_PARTY_NOTICES.txt",
    platform = "darwin-arm64",
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    tools = "//apps/humata2/daemon/humatad:tools_mac",
)

# The external crates the app's binaries link, which the notices must cover
# (//tools/notices:notices_test).
humata2_linked_crates(
    name = "linked_crates",
    binaries = [
        "//apps/humata2/daemon/humatad:tools_linux",
        "//apps/humata2/daemon/humatad:tools_mac",
        "//apps/humata2/desktop:humata2",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//tools/notices:__pkg__"],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "app.bzl",
        "fskit.bzl",
    ],
    tags = ["starlark"],
)

# Humata 2 (fakes).app: the same window on the made-up workspace, for trying
# the screens against the design frames (LOOK2). It never installs or starts
# the host tools.
humata2_app(
    name = "app_fakes",
    browser_extension = "//apps/humata2/browser_extension:bundle",
    bundle_id = HUMATA2_BUNDLE_ID + ".fakes",
    executable = "//apps/humata2/desktop:humata2_fakes",
    icon = "//apps/humata2/app/icon:icns",
    infoplist = "Info.fakes.plist",
    notices = "@humata2_notices//:THIRD_PARTY_NOTICES.txt",
    platform = "darwin-arm64",
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    tools = "//apps/humata2/daemon/humatad:tools_mac",
)
