load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load(":prost.bzl", "rust_prost_domain", "rust_prost_umbrella")

# Humata 2's internal gRPC protocol between the app and the daemons
# (humata/v1/*.proto), described in ../GRPC.md.

# protoc-gen-prost-domain: injects per-type extern_path for imported humata.v1
# files so every message/enum is generated in exactly one domain crate.
rust_binary(
    name = "protoc-gen-prost-domain",
    srcs = ["protoc_gen_prost_domain.rs"],
    deps = [
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:protoc-gen-prost",
    ],
)

# ---------------------------------------------------------------------------
# Per-domain proto_library and same-package prost rust_library targets.
# ---------------------------------------------------------------------------

_PROTO_VISIBILITY = [
    "//apps/humata2/api/grpc:__pkg__",
    "//apps/humata2/cli:__pkg__",
    "//apps/humata2/daemon/humatad:__pkg__",
]

_RUST_VISIBILITY = ["//apps/humata2:__subpackages__"]

proto_library(
    name = "core_proto",
    srcs = [
        "humata/v1/access.proto",
        "humata/v1/build.proto",
        "humata/v1/capabilities.proto",
        "humata/v1/common.proto",
        "humata/v1/errors.proto",
        "humata/v1/operations.proto",
    ],
    strip_import_prefix = "",
    visibility = _PROTO_VISIBILITY,
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

rust_prost_domain(
    name = "core_rust",
    crate_name = "humata2_proto_core",
    proto = ":core_proto",
    visibility = _RUST_VISIBILITY,
)

proto_library(
    name = "terminal_proto",
    srcs = ["humata/v1/terminal.proto"],
    strip_import_prefix = "",
    visibility = _PROTO_VISIBILITY,
    deps = [
        ":core_proto",
        "@protobuf//:timestamp_proto",
    ],
)

rust_prost_domain(
    name = "terminal_rust",
    crate_name = "humata2_proto_terminal",
    dep_proto_crates = {":core_proto": "humata2_proto_core"},
    proto = ":terminal_proto",
    reexport_crates = ["humata2_proto_core"],
    visibility = _RUST_VISIBILITY,
    deps = [":core_rust"],
)

