# ---------------------------------------------------------------------------
# Umbrella targets (kept as rust_prost_library until M1 zero-duplication is verified).
# ---------------------------------------------------------------------------

proto_library(
    name = "humata2_proto",
    srcs = glob(["humata/v1/*.proto"]),
    strip_import_prefix = "",
    # humatad2 generates its tonic services from these protos, and the CLI
    # builds the descriptor set it prints replies as JSON with.
    visibility = [
        "//apps/humata2/cli:__pkg__",
        "//apps/humata2/daemon/humatad:__pkg__",
    ],
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

rust_prost_umbrella(
    name = "humata2_rust",
    crate_name = "humata2_proto",
    reexport_crates = [
        "humata2_proto_board",
        "humata2_proto_catalog",
        "humata2_proto_core",
        "humata2_proto_desk",
        "humata2_proto_events",
        "humata2_proto_files",
        "humata2_proto_inbox",
        "humata2_proto_machines",
        "humata2_proto_peer",
        "humata2_proto_review",
        "humata2_proto_sessions",
        "humata2_proto_terminal",
    ],
    visibility = ["//apps/humata2:__subpackages__"],
    deps = [
        ":board_rust",
        ":catalog_rust",
        ":core_rust",
        ":desk_rust",
        ":events_rust",
        ":files_rust",
        ":inbox_rust",
        ":machines_rust",
        ":peer_rust",
        ":review_rust",
        ":sessions_rust",
        ":terminal_rust",
    ],
)

# What humatad2's store keeps whole on disk (humata/store/v1). Storage
# only: never part of the API, so its fields can change with the store's
# own format versions.
proto_library(
    name = "humata2_store_proto",
    srcs = ["humata/store/v1/store.proto"],
    strip_import_prefix = "",
)

rust_prost_library(
    name = "humata2_store_rust",
    proto = ":humata2_store_proto",
    visibility = [
        "//apps/humata2/daemon:__subpackages__",
    ],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "prost.bzl",
    ],
    tags = ["starlark"],
)
