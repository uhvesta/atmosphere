# gpui-base's text selection, patched so a drag through the blank space
# beside lines selects the lines in between, as in a browser, and a gesture
# that selects nothing still tells the text view it ended, and so the text
# view reports the bounds of each list item it laid out. Applied to
# gpui-base in @crates and @crates_gpui_fast by a crate annotation in
# MODULE.bazel. Keep it in `git diff` form, with a `diff --git` line per
# file: without those, Bazel's patcher hands each file's last hunk to the
# next file and the fetch fails.
exports_files(
    ["gpui-base-selection.patch"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
