load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The Diff panel: per-repo file diffs, folding, wrap, line comments drafted and sent to the agent.
# State, actions and effects only; the views are in //apps/humata2/ui.
rust_library(
    name = "review",
    srcs = glob(["src/*.rs"]),
    aliases = {"//apps/humata2/clients:api": "humata2_clients"},
    crate_name = "humata2_review",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/features/app:__pkg__",
        "//apps/humata2/ui:__subpackages__",
    ],
    deps = [
        "//apps/humata2/clients:api",
        "//libs/tca-rust:tca",
        "@crates//:serde",
    ],
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src],
        crate_root = src,
        deps = [
            ":review",
            "//apps/humata2/clients",
            "//libs/tca-rust:tca",
            "@crates//:serde_json",
        ],
    )
    for src in glob(
        ["tests/*.rs"],
        allow_empty = True,
    )
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
