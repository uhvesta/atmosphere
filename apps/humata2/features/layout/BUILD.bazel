load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The pane workspace (NV-28–NV-35): what each screen's panes show, how they
# split, the layout policy that limits it, undo, and a non-destructive Reset.
# State, actions and effects only; the views are in //apps/humata2/ui.
rust_library(
    name = "layout",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_layout",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/features/app:__pkg__",
        "//apps/humata2/ui:__pkg__",
    ],
    deps = [
        "//apps/humata2/clients",
        "//libs/tca-rust:tca",
        "@crates//:serde",
    ],
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src],
        crate_root = src,
        deps = [
            ":layout",
            "//apps/humata2/clients",
            "//libs/tca-rust:tca",
        ],
    )
    for src in glob(
        ["tests/*.rs"],
        allow_empty = True,
    )
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
