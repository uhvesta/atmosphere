load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Reviewing a pull request with an agent beside you: the start dialog, the
# chat follower, Submit review and new commits (PR-1 to PR-26, D283 to D300).
# State, actions and effects only; the views are in //apps/humata2/ui.
rust_library(
    name = "pr_review",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_pr_review",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/features/app:__pkg__",
        "//apps/humata2/ui:__pkg__",
    ],
    deps = [
        "//apps/humata2/clients",
        "//libs/tca-rust:tca",
        "@crates//:thiserror",
    ],
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src],
        crate_root = src,
        deps = [
            ":pr_review",
            "//apps/humata2/clients",
            "//libs/tca-rust:tca",
            "@crates//:tokio",
        ],
    )
    for src in glob(
        ["tests/*.rs"],
        allow_empty = True,
    )
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
