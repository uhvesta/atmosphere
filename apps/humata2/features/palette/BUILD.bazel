load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The command palette: fuzzy search over commands, sessions and channels, recent first, context-aware commands with inline arguments.
# State, actions and effects only; the views are in //apps/humata2/ui.
rust_library(
    name = "palette",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_palette",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/features/app:__pkg__",
        "//apps/humata2/ui:__pkg__",
    ],
    deps = [
        "//apps/humata2/clients",
        "//libs/tca-rust:tca",
        "@crates//:serde",
    ],
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src],
        crate_root = src,
        deps = [
            ":palette",
            "//apps/humata2/clients",
            "//libs/tca-rust:tca",
        ],
    )
    for src in glob(
        ["tests/*.rs"],
        allow_empty = True,
    )
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
