load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The Inbox: scopes, request rows, the decision card and its answers, Approve all and Deny all, answered requests.
# State, actions and effects only; the views are in //apps/humata2/ui.
rust_library(
    name = "inbox",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_inbox",
    visibility = [
        "//apps/humata2/desktop:__pkg__",
        "//apps/humata2/features/app:__pkg__",
        "//apps/humata2/ui:__pkg__",
    ],
    deps = [
        "//apps/humata2/clients",
        "//libs/tca-rust:tca",
        "@crates//:serde",
    ],
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src],
        crate_root = src,
        deps = [
            ":inbox",
            "//apps/humata2/clients",
            "//libs/tca-rust:tca",
        ],
    )
    for src in glob(
        ["tests/*.rs"],
        allow_empty = True,
    )
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
