load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Humata 2's state on disk: session records, terminal tabs, agents and how
# to resume them, pointers and the journal of writes made while the host is
# away, in one SQLite database (WAL, synchronous = FULL) under a schema
# version. Data kept whole is a proto blob in the frame every file at rest
# uses (humata2_chunk; codec, type, version, checksum; TR-13, D65), zstd
# when that pays; big ones live in files named by their hash, written
# before the row that names them. Knows nothing about the network.
STORE_DEPS = [
    "//apps/humata2/api/proto:humata2_store_rust",
    "//apps/humata2/chunk:humata2_chunk",
    "@crates//:prost",
    "@crates//:rusqlite",
    "@crates//:sha2",
    "@crates//:thiserror",
]

rust_library(
    name = "store",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_store",
    visibility = [
        "//apps/humata2/cli:__pkg__",
        "//apps/humata2/daemon:__subpackages__",
    ],
    deps = STORE_DEPS + ["//apps/humata2/daemon/durable"],
)

# The store with its fault points live (`HUMATA2_STOP_AT`), for the tests
# that kill a process at each one. Never linked into a release binary.
rust_library(
    name = "store_faults",
    testonly = True,
    srcs = glob(["src/*.rs"]),
    crate_features = ["faults"],
    crate_name = "humata2_store",
    visibility = [
        "//apps/humata2/daemon/revive:__pkg__",
        "//apps/humata2/daemon/sessions:__pkg__",
        "//apps/humata2/daemon/transfers:__pkg__",
    ],
    deps = STORE_DEPS + ["//apps/humata2/daemon/durable:durable_faults"],
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src],
        deps = [
            ":store",
            "@crates//:rusqlite",
            "@crates//:tempfile",
        ],
    )
    for src in glob(
        ["tests/*.rs"],
        exclude = [
            "tests/kill_points.rs",
            "tests/power_cut.rs",
        ],
    )
]

rust_test(
    name = "kill_points_test",
    size = "medium",
    srcs = ["tests/kill_points.rs"],
    deps = [
        ":store_faults",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "store_unit_test",
    crate = ":store",
    deps = ["@crates//:tempfile"],
)

# Cuts the power under a host's store and a machine's at each point a
# write passes (PER-25).
rust_test(
    name = "power_cut_test",
    size = "medium",
    srcs = ["tests/power_cut.rs"],
    deps = [
        ":store_faults",
        "@crates//:rusqlite",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
