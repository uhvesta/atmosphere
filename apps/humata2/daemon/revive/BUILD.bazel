load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Brings a machine's sessions back once their terminals' holders are gone:
# resumes each agent with its pinned conversation and checks it took it
# up, restarts shells in their folders, and reattaches to holders still
# running, and writes a restart report of what it found and did.
# humatad2 runs it when it starts.
REVIVE_DEPS = [
    "//apps/humata2/daemon/contain",
    "//apps/humata2/report",
    "@crates//:notify",
    "@crates//:rustix",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
]

rust_library(
    name = "revive",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_revive",
    visibility = [
        "//apps/humata2/daemon/humatad:__pkg__",
        "//apps/humata2/daemon/sessions:__pkg__",
    ],
    deps = REVIVE_DEPS + [
        "//apps/humata2/daemon/holder",
        "//apps/humata2/daemon/store",
    ],
)

rust_test(
    name = "revive_unit_test",
    crate = ":revive",
    deps = ["@crates//:tempfile"],
)

# Built on the store with its fault points live, for the kill matrix.
rust_library(
    name = "revive_faults",
    testonly = True,
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_revive",
    visibility = [
        "//apps/humata2/daemon/humatad:__pkg__",
        "//apps/humata2/daemon/revive:__pkg__",
        "//apps/humata2/daemon/sessions:__pkg__",
    ],
    deps = REVIVE_DEPS + [
        "//apps/humata2/daemon/holder:holder_faults",
        "//apps/humata2/daemon/store:store_faults",
    ],
)

# PER-23: kills holders and the daemon at each point of a launch and a
# resume, and checks each session comes back or says why it can't.
rust_test(
    name = "kill_matrix_test",
    size = "large",
    srcs = ["tests/kill_matrix.rs"],
    data = ["//apps/humata2/daemon/holder:humata2_holder_faults"],
    env = {"HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder_faults)"},
    tags = ["slow"],
    deps = [
        ":revive_faults",
        "//apps/humata2/daemon/holder:holder_faults",
        "//apps/humata2/daemon/store:store_faults",
        "@crates//:rustix",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
