load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Stop/start sessions, restart recovery, restart doctor, and DaemonService
# for humatad2 (mandatory split of svc_lifecycle to stay <=12k LOC).
COMMON_DEPS = [
    "//apps/humata2/api/grpc:core",
    "//apps/humata2/chunk:humata2_chunk",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/durable",
    "//apps/humata2/daemon/holder",
    "//apps/humata2/daemon/humatad:grpc",
    "//apps/humata2/daemon/machines",
    "//apps/humata2/daemon/ports",
    "//apps/humata2/daemon/revive",
    "//apps/humata2/daemon/rpc_kit",
    "//apps/humata2/daemon/sessions",
    "//apps/humata2/daemon/store",
    "@crates//:clap",
    "@crates//:http-body",
    "@crates//:hyper-util",
    "@crates//:prost",
    "@crates//:rustix",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tower",
    "@crates//:uuid",
]

rust_library(
    name = "svc_stop_restart",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_stop_restart",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = COMMON_DEPS + [
        "//apps/humata2/daemon/runtime",
    ],
)

# The svc_stop_restart crate with fault points active (`feature = "faults"`).
rust_library(
    name = "svc_stop_restart_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["faults"],
    crate_name = "humata2_svc_stop_restart",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = COMMON_DEPS + [
        "//apps/humata2/daemon/runtime:runtime_faults",
    ],
)

rust_test(
    name = "svc_stop_restart_unit_test",
    crate = ":svc_stop_restart",
    deps = [
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
