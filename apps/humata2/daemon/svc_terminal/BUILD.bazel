load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

SHARED_DEPS = [
    "//apps/humata2/chunk:humata2_chunk",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/humatad:grpc",
    "//apps/humata2/daemon/ports",
    "//apps/humata2/daemon/rpc_kit",
    "@crates//:prost",
    "@crates//:prost-types",
    "@crates//:rustix",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:uuid",
]

NORMAL_DEPS = SHARED_DEPS + [
    "//apps/humata2/daemon/holder",
    "//apps/humata2/daemon/runtime",
    "//apps/humata2/daemon/sessions",
    "//apps/humata2/daemon/store",
]

FAULTS_DEPS = SHARED_DEPS + [
    "//apps/humata2/daemon/holder:holder_faults",
    "//apps/humata2/daemon/runtime:runtime_faults",
    "//apps/humata2/daemon/sessions:sessions_faults",
    "//apps/humata2/daemon/store:store_faults",
]

rust_library(
    name = "svc_terminal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_terminal",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = NORMAL_DEPS,
)

rust_library(
    name = "svc_terminal_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["faults"],
    crate_name = "humata2_svc_terminal",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = FAULTS_DEPS,
)

rust_test(
    name = "svc_terminal_unit_test",
    crate = ":svc_terminal",
    deps = [
        "@crates//:hyper-util",
        "@crates//:tempfile",
        "@crates//:tower",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
