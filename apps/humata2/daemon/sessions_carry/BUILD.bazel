load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

SESSIONS_CARRY_DEPS = [
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:thiserror",
    "@crates//:uuid",
]

rust_library(
    name = "sessions_carry",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_sessions_carry",
    visibility = [
        "//apps/humata2/daemon/humatad:__pkg__",
        "//apps/humata2/daemon/sessions:__pkg__",
    ],
    deps = SESSIONS_CARRY_DEPS + [
        "//apps/humata2/daemon/conversation",
        "//apps/humata2/daemon/durable",
        "//apps/humata2/daemon/holder",
        "//apps/humata2/daemon/revive",
        "//apps/humata2/daemon/sessions_core",
        "//apps/humata2/daemon/store",
    ],
)

rust_test(
    name = "sessions_carry_unit_test",
    crate = ":sessions_carry",
    deps = [
        "@crates//:rusqlite",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "sessions_carry_faults",
    testonly = True,
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_sessions_carry",
    visibility = [
        "//apps/humata2/daemon/humatad:__pkg__",
        "//apps/humata2/daemon/sessions:__pkg__",
    ],
    deps = SESSIONS_CARRY_DEPS + [
        "//apps/humata2/daemon/conversation",
        "//apps/humata2/daemon/durable:durable_faults",
        "//apps/humata2/daemon/holder:holder_faults",
        "//apps/humata2/daemon/revive:revive_faults",
        "//apps/humata2/daemon/sessions_core:sessions_core_faults",
        "//apps/humata2/daemon/store:store_faults",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
