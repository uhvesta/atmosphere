load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Session transfer, move, rebuild, remote fork, continue-in, push, and remote
# start/review handlers for humatad2 (SPLIT_PHASE3_DAEMON §2.3, C3 Sibling 2).
TRANSFER_DEPS = [
    "//apps/humata2/api/grpc:core",
    "//apps/humata2/api/grpc:inbox",
    "//apps/humata2/api/grpc:peer",
    "//apps/humata2/api/grpc:review",
    "//apps/humata2/api/grpc:sessions",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/ports",
    "//apps/humata2/daemon/rpc_kit",
    "@crates//:prost",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tonic",
    "@crates//:uuid",
]

rust_library(
    name = "svc_sessions_transfer",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_sessions_transfer",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = TRANSFER_DEPS + [
        "//apps/humata2/daemon/runtime",
        "//apps/humata2/daemon/sessions",
        "//apps/humata2/daemon/store",
        "//apps/humata2/daemon/svc_sessions_common",
    ],
)

rust_library(
    name = "svc_sessions_transfer_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["faults"],
    crate_name = "humata2_svc_sessions_transfer",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = TRANSFER_DEPS + [
        "//apps/humata2/daemon/runtime:runtime_faults",
        "//apps/humata2/daemon/sessions:sessions_faults",
        "//apps/humata2/daemon/store:store_faults",
        "//apps/humata2/daemon/svc_sessions_common:svc_sessions_common_faults",
    ],
)

rust_test(
    name = "svc_sessions_transfer_unit_test",
    crate = ":svc_sessions_transfer",
    deps = [
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
