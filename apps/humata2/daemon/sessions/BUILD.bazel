load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# A channel's folders and clones on this machine, and the steps that start
# a session in them: names (CH-2, FC-11..FC-14), the folder layout (FC-1),
# main and session clones (FC-2, FC-3), the agents a session can run, and
# the start and channel setup that are finished or undone after a crash
# at any step (SE-4, PER-11, PER-27). humatad2's ChannelService and
# SessionService drive it; it knows nothing about gRPC.
SESSIONS_DEPS = [
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:uuid",
]

rust_library(
    name = "sessions",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_sessions",
    visibility = ["//apps/humata2/daemon/humatad:__pkg__"],
    deps = SESSIONS_DEPS + [
        "//apps/humata2/daemon/durable",
        "//apps/humata2/daemon/holder",
        "//apps/humata2/daemon/revive",
        "//apps/humata2/daemon/store",
    ],
)

rust_test(
    name = "sessions_unit_test",
    crate = ":sessions",
    deps = ["@crates//:tempfile"],
)

# The same crate on the fault-point builds of everything it drives.
rust_library(
    name = "sessions_faults",
    testonly = True,
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_sessions",
    deps = SESSIONS_DEPS + [
        "//apps/humata2/daemon/durable:durable_faults",
        "//apps/humata2/daemon/holder:holder_faults",
        "//apps/humata2/daemon/revive:revive_faults",
        "//apps/humata2/daemon/store:store_faults",
    ],
)

# PER-23, PER-27: kills channel setup and session start at each point and
# checks recovery finishes or fully undoes them.
rust_test(
    name = "kill_matrix_test",
    size = "large",
    srcs = ["tests/kill_matrix.rs"],
    data = ["//apps/humata2/daemon/holder:humata2_holder_faults"],
    env = {"HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder_faults)"},
    tags = ["slow"],
    deps = [
        ":sessions_faults",
        "//apps/humata2/daemon/holder:holder_faults",
        "//apps/humata2/daemon/revive:revive_faults",
        "//apps/humata2/daemon/store:store_faults",
        "@crates//:rustix",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
