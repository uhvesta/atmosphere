load("@rules_rust//rust:defs.bzl", "rust_library")

# Thin re-export facade over sessions_core, sessions_desk, and sessions_carry
# during Phase 4A migration so daemon/humatad builds unchanged.
rust_library(
    name = "sessions",
    srcs = ["src/lib.rs"],
    crate_name = "humata2_sessions",
    visibility = ["//apps/humata2/daemon/humatad:__pkg__",
        "//apps/humata2/daemon:__subpackages__"],
    deps = [
        "//apps/humata2/daemon/revive",
        "//apps/humata2/daemon/sessions_carry",
        "//apps/humata2/daemon/sessions_core",
        "//apps/humata2/daemon/sessions_desk",
        "//apps/humata2/daemon/store",
    ],
)

# The same facade on the fault-point builds of sessions_core, sessions_desk,
# and sessions_carry.
rust_library(
    name = "sessions_faults",
    testonly = True,
    srcs = ["src/lib.rs"],
    crate_name = "humata2_sessions",
    visibility = ["//apps/humata2/daemon/humatad:__pkg__",
        "//apps/humata2/daemon:__subpackages__"],
    deps = [
        "//apps/humata2/daemon/revive:revive_faults",
        "//apps/humata2/daemon/sessions_carry:sessions_carry_faults",
        "//apps/humata2/daemon/sessions_core:sessions_core_faults",
        "//apps/humata2/daemon/sessions_desk:sessions_desk_faults",
        "//apps/humata2/daemon/store:store_faults",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
