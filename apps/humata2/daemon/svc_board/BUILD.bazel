load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# What svc_board is built on that has no fault-point build.
SVC_BOARD_SHARED_DEPS = [
    "//apps/humata2/api/grpc:board",
    "//apps/humata2/api/grpc:catalog",
    "//apps/humata2/api/grpc:core",
    "//apps/humata2/api/grpc:events",
    "//apps/humata2/api/grpc:files",
    "//apps/humata2/api/grpc:inbox",
    "//apps/humata2/api/grpc:machines",
    "//apps/humata2/api/grpc:peer",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/ports",
    "//apps/humata2/daemon/rpc_kit",
    "@crates//:prost",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tonic",
]

# Standalone BoardService crate (`humata2_svc_board`) extracted from humatad2.
rust_library(
    name = "svc_board",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_board",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_BOARD_SHARED_DEPS + [
        "//apps/humata2/daemon/store",
    ],
)

# The same crate on the fault-point builds of its parts, for the faults
# daemons: one graph, so their fault points stay live.
rust_library(
    name = "svc_board_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_board",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_BOARD_SHARED_DEPS + [
        "//apps/humata2/daemon/store:store_faults",
    ],
)

rust_test(
    name = "svc_board_unit_test",
    crate = ":svc_board",
    deps = ["@crates//:tempfile"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
