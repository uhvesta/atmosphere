load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# What svc_inbox is built on that has no fault-point build.
SVC_INBOX_SHARED_DEPS = [
    "//apps/humata2/api/grpc:core",
    "//apps/humata2/api/grpc:events",
    "//apps/humata2/api/grpc:inbox",
    "//apps/humata2/api/grpc:peer",
    "//apps/humata2/api/proto:humata2_store_rust",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/browser_copilot",
    "//apps/humata2/daemon/ports",
    "//apps/humata2/daemon/rpc_kit",
    "@crates//:prost",
    "@crates//:sha2",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:uuid",
]

rust_library(
    name = "svc_inbox",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_inbox",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_INBOX_SHARED_DEPS + [
        "//apps/humata2/daemon/runtime",
        "//apps/humata2/daemon/sessions_core",
        "//apps/humata2/daemon/store",
        "//apps/humata2/daemon/svc_away",
    ],
)

# The same crate on the fault-point builds of its parts, for the faults
# daemons: one graph, so their fault points stay live.
rust_library(
    name = "svc_inbox_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_inbox",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_INBOX_SHARED_DEPS + [
        "//apps/humata2/daemon/runtime:runtime_faults",
        "//apps/humata2/daemon/sessions_core:sessions_core_faults",
        "//apps/humata2/daemon/store:store_faults",
        "//apps/humata2/daemon/svc_away:svc_away_faults",
    ],
)

rust_test(
    name = "svc_inbox_unit_test",
    crate = ":svc_inbox",
    deps = [
        "@crates//:tempfile",
    ],
)

# Records agent CLI screens as labelled text snapshots through the real
# holder and the daemon's terminal engine, for the prompt parser's replay
# tests.
SCREENPARSE_DEPS = [
    "//apps/humata2/daemon/holder",
    "//apps/humata2/daemon/vt_authority",
    "//apps/humata2/testing/tmp_folder",
    "@crates//:thiserror",
    "@crates//:tokio",
]

rust_library(
    name = "screenparse",
    testonly = True,
    srcs = glob(
        ["tests/screenparse/*.rs"],
        exclude = ["tests/screenparse/record_main.rs"],
    ),
    crate_name = "humata2_screenparse",
    crate_root = "tests/screenparse/lib.rs",
    deps = SCREENPARSE_DEPS,
)

rust_binary(
    name = "screenparse_record",
    testonly = True,
    srcs = ["tests/screenparse/record_main.rs"],
    data = ["//apps/humata2/daemon/holder:humata2_holder"],
    deps = [
        ":screenparse",
        "@crates//:thiserror",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "screenparse_unit_test",
    crate = ":screenparse",
)

# Fast-tier deterministic replay of the recorded CLI screen corpus through
# `screen_question` and `ScreenAsk` (zero model calls, zero sleeps).
rust_test(
    name = "screen_replay_test",
    srcs = ["tests/screen_replay.rs"],
    data = glob(["tests/screens/**/*.txt"]),
    deps = [
        ":screenparse",
        ":svc_inbox",
        "//apps/humata2/daemon/runtime",
        "//apps/humata2/daemon/store",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

# Fast-tier deterministic tests for ATM-54 SESSIONBOOT startup authorization.
rust_test(
    name = "startup_auth_test",
    srcs = ["tests/startup_auth.rs"],
    deps = [
        ":svc_inbox",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

# Slow-tier live CLI screen recorder check: runs only on demand and skips
# cleanly when agent logins are unavailable.
sh_test(
    name = "screenparse_live",
    timeout = "long",
    srcs = ["tests/screenparse/live_test.sh"],
    data = [
        "tests/screenparse/mcp_echo.py",
        "tests/screenparse/record_corpus.sh",
        ":screenparse_record",
    ] + glob(["tests/screenparse/scripts/*.script"]),
    tags = [
        "external",
        "local",
        "manual",
        "no-sandbox",
        "slow",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
