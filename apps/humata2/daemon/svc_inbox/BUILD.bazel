load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# What svc_inbox is built on that has no fault-point build.
SVC_INBOX_SHARED_DEPS = [
    "//apps/humata2/api/proto:humata2_store_rust",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/humatad:grpc",
    "//apps/humata2/daemon/ports",
    "//apps/humata2/daemon/rpc_kit",
    "@crates//:prost",
    "@crates//:sha2",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:uuid",
]

rust_library(
    name = "svc_inbox",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_inbox",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_INBOX_SHARED_DEPS + [
        "//apps/humata2/daemon/runtime",
        "//apps/humata2/daemon/sessions_core",
        "//apps/humata2/daemon/store",
        "//apps/humata2/daemon/svc_away",
    ],
)

# The same crate on the fault-point builds of its parts, for the faults
# daemons: one graph, so their fault points stay live.
rust_library(
    name = "svc_inbox_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_inbox",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_INBOX_SHARED_DEPS + [
        "//apps/humata2/daemon/runtime:runtime_faults",
        "//apps/humata2/daemon/sessions_core:sessions_core_faults",
        "//apps/humata2/daemon/store:store_faults",
        "//apps/humata2/daemon/svc_away:svc_away_faults",
    ],
)

rust_test(
    name = "svc_inbox_unit_test",
    crate = ":svc_inbox",
    deps = [
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
