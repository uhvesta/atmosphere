load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# What svc_files is built on that has no fault-point build.
SVC_FILES_SHARED_DEPS = [
    "//apps/humata2/api/grpc:core",
    "//apps/humata2/api/grpc:events",
    "//apps/humata2/api/grpc:files",
    "//apps/humata2/chunk:humata2_chunk",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/conversation",
    "//apps/humata2/daemon/ports",
    "//apps/humata2/daemon/rpc_kit",
    "@crates//:prost",
    "@crates//:sha2",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
]

# FileService on this machine's own files, file manager ops, Go-to-file search,
# clone file-change tracking, and cross-machine file/trash forwarding.
rust_library(
    name = "svc_files",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_files",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_FILES_SHARED_DEPS + [
        "//apps/humata2/daemon/store",
    ],
)

# The same crate on the fault-point builds of its parts, for the faults
# daemons: one graph, so their fault points stay live.
rust_library(
    name = "svc_files_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_svc_files",
    visibility = ["//apps/humata2/daemon:__subpackages__"],
    deps = SVC_FILES_SHARED_DEPS + [
        "//apps/humata2/daemon/store:store_faults",
    ],
)

rust_test(
    name = "svc_files_unit_test",
    crate = ":svc_files",
    deps = [
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
