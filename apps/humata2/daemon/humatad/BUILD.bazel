# Each test starts humatad2 and humata2_holder as the real binaries and
# talks to them over gRPC on a socket of its own: the admin daemon with
# --admin as HUMATAD2, and the release one as HUMATAD2_RELEASE for the
# checks that a call with no credential is refused. The CLI login tests
# also run `humata` (HUMATA) in a terminal of their own. Each gets only
# the binaries TEST_NEEDS lists for it.
[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        # The multi-machine rig (tests/common/remote_rig.rs) starts a host
        # and fake boxes per test; under a full gate its tests outrun the
        # 300 s of a medium test. Every wait in them has its own deadline.
        size = "large" if src.removeprefix("tests/").removesuffix(".rs") in RIG_TESTS else "medium",
        timeout = "eternal" if src.removeprefix("tests/").removesuffix(".rs") in POWER_CUT_TESTS else None,
        srcs = [src],
        crate_root = src,
        data = [
            label
            for need in ["BASE"] + TEST_NEEDS.get(
                src.removeprefix("tests/").removesuffix(".rs"),
                [],
            )
            for label in NEED_DATA[SCOPED_NEED.get(
                src.removeprefix("tests/").removesuffix(".rs") + "/" + need,
                need,
            )]
        ],
        env = {
            variable: path
            for need in ["BASE"] + TEST_NEEDS.get(
                src.removeprefix("tests/").removesuffix(".rs"),
                [],
            )
            for variable, path in NEED_ENV[SCOPED_NEED.get(
                src.removeprefix("tests/").removesuffix(".rs") + "/" + need,
                need,
            )].items()
        },
        # A shard of a power-cut suite traces its operations and cuts each
        # at all of its points: long, but each wait in it has a deadline.
        shard_count = POWER_CUT_SHARDS if src.removeprefix("tests/").removesuffix(".rs") in POWER_CUT_TESTS else RIG_SHARDS.get(
            src.removeprefix("tests/").removesuffix(".rs"),
            0,
        ),
        target_compatible_with = ["@platforms//os:linux"] if src.removeprefix("tests/").removesuffix(".rs") in LINUX_VM_TESTS else [],
        deps = [
            ":grpc",
            ":test_common",
            "//apps/humata2/chunk:humata2_chunk",
            "//apps/humata2/daemon/machines",
            "//apps/humata2/daemon/machines:fake_machine",
            # REPOS (RL-5): tests/repos.rs seeds the library.
            "//apps/humata2/daemon/repo_library",
            "//apps/humata2/daemon/passphrase",
            "//apps/humata2/daemon/store",
            "//apps/humata2/terminal/vt:ghostty_vt",
            "//apps/humata2/testing/tmp_folder",
            "@crates//:hmac",
            "@crates//:hyper-util",
            "@crates//:prost",
            "@crates//:rustix",
            "@crates//:serde_json",
            "@crates//:sha2",
            "@crates//:tempfile",
            "@crates//:tokio",
            "@crates//:tokio-stream",
            "@crates//:tonic",
            "@crates//:tower",
        ],
    )
    for src in glob(["tests/*.rs"])
]

# TR-10: the round trip over a real `serve --stdio` link, printed as
# percentiles. Manual: run it on a release build, with
# `bazel test -c opt :peer_link_latency_bench --test_output=streamed
# --test_arg=--nocapture`.
rust_test(
    name = "peer_link_latency_bench",
    srcs = ["benches/peer_link_latency.rs"],
    crate_root = "benches/peer_link_latency.rs",
    data = [":humatad2"],
    env = {"HUMATAD2": "$(rootpath :humatad2)"},
    tags = ["manual"],
    deps = [
