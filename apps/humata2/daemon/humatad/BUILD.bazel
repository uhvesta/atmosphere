# Chained after desk_stuck_remote: a plain start cut the same way.
RIG_TESTS.append("start_stuck_remote")

# Chained after start_stuck_remote: a box's restart whose resume of an agent
# fails (HUMATA2_FAIL_AT), then the host's resume taking the record over.
RIG_TESTS.append("start_resume_failed_remote")

# Chained after start_resume_failed_remote: stop on an agent saved as
# launching whose old holder still lives.
RIG_TESTS.append("stop_launching")

# DESKWATCH: a Desk session on a box is told on the host's feed when the box changes it.
RIG_TESTS.append("desk_events_remote")

# Chained after desk_events_remote: a pull request review started on a
# box (PR-4, PR-21), checked, updated and submitted through the host.
RIG_TESTS.append("pr_review_remote")

# Chained after pr_review_remote: a review moved to a box and back (PR-21).
# SEAM: BUILD list.
RIG_TESTS.append("pr_review_move")

# D731: a host killed between asking a box for a Desk start and keeping its answer.
RIG_TESTS.append("desk_start_host_cut")

# An agent sends to its channel's machine by name (PL-3, TP-1).
RIG_TESTS.append("agent_send_machine")

# FK-9: a context-only fork on a box given its own copy through the host.
RIG_TESTS.append("own_copy_remote")

# D784: the host lists, stops, resumes and ends a box's holders there.
RIG_TESTS.append("running_holders_remote")

# HO-6: a machine shell opened, attached, stopped, resumed and ended on a box
