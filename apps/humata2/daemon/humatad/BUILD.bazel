    name = "humatad2_faults",
    testonly = True,
    srcs = glob(
        ["src/**/*.rs"],
        exclude = EXTRACTED_SRCS,
    ),
    crate_features = [
        "admin",
        "faults",
    ] + ALL_SVC_FEATURES,
    rustc_env = APP_IDENTITY,
    visibility = ["//apps/humata2:__subpackages__"],
    deps = FULL_FAULTS_DEPS + [
        "//apps/humata2/daemon/svc_board:svc_board_faults",
        "//apps/humata2/daemon/svc_mcp",
        "//apps/humata2/daemon/svc_review:svc_review_faults",
    ],
)

