RIG_TESTS.append("machine_shell_remote")

# D784: a failed resume on a box ends the holder it started there.
RIG_TESTS.append("resume_exits_at_once_remote")

# CH-24, D784: no delete plan for a channel another machine holds, and the
# refusal tells online machines from offline ones as they are.
RIG_TESTS.append("channel_delete_remote")

# Single power cuts picked from the suites below, one test each: the quick
# check to queue while working on recovery.
RIG_TESTS.append("power_cut_focus")

# The PER-28 power-cut suites (D243): one test per operation, each a trace of
# it and then a fresh host and box per point. A shard's tests share a few
# rigs at a time (AT_ONCE in tests/common/power_cut.rs), so its operations
# take turns; an operation's shard is its index modulo the shards, which
# splits the points about evenly between the two.
POWER_CUT_TESTS = [
    "power_cut_both",
    "power_cut_host",
    "power_cut_machine",
]

POWER_CUT_SHARDS = 2

# Rig suites with many tests of their own, each a host and boxes for
# minutes: shared out so each shard stays within a large test's time.
RIG_SHARDS = {
    "stop_box": 4,
}

# Rig suites that check a Linux box (D784's remote amendment): built for
# Linux only, so the Linux VM batch runs them with `//apps/humata2/daemon/...`
# (testing/linux/BATCH.md) and the Mac skips them.
LINUX_VM_TESTS = [
    "machine_shell_remote_linux",
]

RIG_TESTS.extend(LINUX_VM_TESTS)

# Each test starts humatad2 and humata2_holder as the real binaries and
# talks to them over gRPC on a socket of its own: the admin daemon with
# --admin as HUMATAD2, and the release one as HUMATAD2_RELEASE for the
# checks that a call with no credential is refused. The CLI login tests
# also run `humata` (HUMATA) in a terminal of their own.
[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        # The multi-machine rig (tests/common/remote_rig.rs) starts a host
        # and fake boxes per test; under a full gate its tests outrun the
        # 300 s of a medium test. Every wait in them has its own deadline.
        size = "large" if src.removeprefix("tests/").removesuffix(".rs") in RIG_TESTS else "medium",
        timeout = "eternal" if src.removeprefix("tests/").removesuffix(".rs") in POWER_CUT_TESTS else None,
        srcs = [src] + glob(["tests/common/*.rs"]),
        crate_root = src,
        data = [
            ":humatad2",
            ":humatad2_admin",
            ":humatad2_faults",
            ":setsid",
            "//apps/humata2/cli:humata",
            "//apps/humata2/daemon/holder:humata2_holder",
            "//apps/humata2/daemon/holder:humata2_holder_faults",
            "//tools/stack",
        ],
        env = {
            "HUMATA": "$(rootpath //apps/humata2/cli:humata)",
            "HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder)",
            "HUMATA2_HOLDER_FAULTS": "$(rootpath //apps/humata2/daemon/holder:humata2_holder_faults)",
            "HUMATA2_SETSID": "$(rootpath :setsid)",
            "HUMATAD2": "$(rootpath :humatad2_admin)",
            "HUMATAD2_FAULTS": "$(rootpath :humatad2_faults)",
            "HUMATAD2_RELEASE": "$(rootpath :humatad2)",
            "STACK": "$(rootpath //tools/stack:stack)",
        },
        # A shard of a power-cut suite traces its operations and cuts each
        # at all of its points: long, but each wait in it has a deadline.
        shard_count = POWER_CUT_SHARDS if src.removeprefix("tests/").removesuffix(".rs") in POWER_CUT_TESTS else RIG_SHARDS.get(
            src.removeprefix("tests/").removesuffix(".rs"),
            0,
        ),
        target_compatible_with = ["@platforms//os:linux"] if src.removeprefix("tests/").removesuffix(".rs") in LINUX_VM_TESTS else [],
        deps = [
            ":grpc",
            "//apps/humata2/chunk:humata2_chunk",
            "//apps/humata2/daemon/machines",
            "//apps/humata2/daemon/machines:fake_machine",
            # REPOS (RL-5): tests/repos.rs seeds the library.
            "//apps/humata2/daemon/repo_library",
            "//apps/humata2/daemon/passphrase",
            "//apps/humata2/daemon/store",
            "//apps/humata2/terminal/vt:ghostty_vt",
            "@crates//:hmac",
            "@crates//:hyper-util",
            "@crates//:prost",
            "@crates//:rustix",
            "@crates//:serde_json",
            "@crates//:sha2",
            "@crates//:tempfile",
            "@crates//:tokio",
            "@crates//:tokio-stream",
            "@crates//:tonic",
            "@crates//:tower",
        ],
    )
    for src in glob(["tests/*.rs"])
]

# TR-10: the round trip over a real `serve --stdio` link, printed as
# percentiles. Manual: run it on a release build, with
# `bazel test -c opt :peer_link_latency_bench --test_output=streamed
# --test_arg=--nocapture`.
rust_test(
    name = "peer_link_latency_bench",
    srcs = ["benches/peer_link_latency.rs"],
    crate_root = "benches/peer_link_latency.rs",
    data = [":humatad2"],
    env = {"HUMATAD2": "$(rootpath :humatad2)"},
    tags = ["manual"],
    deps = [
        ":grpc",
        "@crates//:hyper-util",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tower",
    ],
)

# The daemon tests' harness, which the CLI's live tests reuse by path.
exports_files(
    ["tests/common/mod.rs"],
    visibility = ["//apps/humata2/cli:__pkg__"],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "tonic.bzl",
        "tools.bzl",
    ],
    tags = ["starlark"],
)
