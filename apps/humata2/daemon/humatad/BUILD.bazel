load("@lifr_identity//:defs.bzl", "HUMATA2_BUNDLE_ID", "TEAM_ID")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":tonic.bzl", "rust_tonic_services")
load(":tools.bzl", "tools_bundle")

# humatad2, Humata 2's daemon: serves the gRPC API (../../api/GRPC.md) on a
# Unix socket, or the peer link on stdio with `serve --stdio`; `humatad2
# bridge` carries the socket over stdio for SSH or a provider's connect
# command. It only wires the parts together: state is
# //apps/humata2/daemon/store, terminals are //apps/humata2/daemon/holder.

# protoc-gen-tonic, the protoc plugin for tonic, built from the workspace's
# pinned crate.
rust_binary(
    name = "protoc-gen-tonic",
    srcs = ["codegen/protoc_gen_tonic.rs"],
    deps = [
        "@crates//:prost",
        "@crates//:protoc-gen-prost",
        "@crates//:protoc-gen-tonic",
    ],
)

rust_tonic_services(
    name = "tonic_gen",
    package = "humata.v1",
    plugin = ":protoc-gen-tonic",
    proto = "//apps/humata2/api/proto:humata2_proto",
)

# The message types and the generated clients and servers, as one module.
rust_library(
    name = "grpc",
    srcs = ["codegen/grpc.rs"],
    compile_data = [":tonic_gen"],
    crate_name = "humata2_grpc",
    # The generated code is written for this edition.
    edition = "2021",
    rustc_env = {"HUMATA2_TONIC_RS": "$(execpath :tonic_gen)"},
    # Generated code: clippy has nothing to say that we could act on.
    tags = ["noclippy"],
    # The app's real daemon client speaks the same generated clients.
    visibility = [
        "//apps/humata2/cli:__pkg__",
        "//apps/humata2/clients/live:__pkg__",
        # The desktop live flows call ViewService as a session's agent.
        "//apps/humata2/desktop:__pkg__",
    ],
    deps = [
        "//apps/humata2/api/proto:humata2_rust",
        "@crates//:prost",
        "@crates//:tonic",
        "@crates//:tonic-prost",
    ],
)

# What the daemon is built on that has a fault-point build (`*_faults`):
# the faults daemon swaps each for its twin, so a point in any of them is
# live in it.
FAULT_SWAPPED = [
    "//apps/humata2/daemon/durable",
    "//apps/humata2/daemon/holder",
    "//apps/humata2/daemon/revive",
    "//apps/humata2/daemon/sessions",
    "//apps/humata2/daemon/store",
    "//apps/humata2/daemon/transfers",
]

SHARED_DEPS = [
    ":grpc",
    "//apps/humata2/api/proto:humata2_store_rust",
    "//apps/humata2/chunk:humata2_chunk",
    "//apps/humata2/daemon/access",
    "//apps/humata2/daemon/agent_hooks",
    "//apps/humata2/daemon/app_peer",
    "//apps/humata2/daemon/machines",
    "//apps/humata2/daemon/marks",
    # REPOS (RL-5): the repo library.
    "//apps/humata2/daemon/repo_library",
    "//apps/humata2/daemon/mcp",
    "//apps/humata2/daemon/mirror",
    "//apps/humata2/daemon/contain",
    "//apps/humata2/daemon/passphrase",
    "//apps/humata2/daemon/review_diff",
    "//apps/humata2/daemon/vt_authority",
    "//apps/humata2/terminal/vt:ghostty_vt",
    "@crates//:clap",
    "@crates//:hmac",
    "@crates//:http-body",
    "@crates//:hyper-util",
    "@crates//:notify",
    "@crates//:prost",
    "@crates//:rand",
    "@crates//:rustix",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:toml",
    "@crates//:tonic",
    "@crates//:tower",
    "@crates//:uuid",
]

DAEMON_DEPS = SHARED_DEPS + FAULT_SWAPPED

# The same daemon on the fault-point builds of its parts.
FAULTS_DEPS = SHARED_DEPS + [
    "//apps/humata2/daemon/durable:durable_faults",
    "//apps/humata2/daemon/holder:holder_faults",
    "//apps/humata2/daemon/revive:revive_faults",
    "//apps/humata2/daemon/sessions:sessions_faults",
    "//apps/humata2/daemon/store:store_faults",
    "//apps/humata2/daemon/transfers:transfers_faults",
]

# The signed app's identity, which the daemon checks socket peers against
# (D135): empty in a build without a team, so nothing is taken for the app.
APP_IDENTITY = {
    "HUMATA2_BUNDLE_ID": HUMATA2_BUNDLE_ID,
    "HUMATA2_TEAM_ID": TEAM_ID,
}

# The release daemon: a call with no credential is refused (SEC-9).
rust_binary(
    name = "humatad2",
    srcs = glob(["src/**/*.rs"]),
    rustc_env = APP_IDENTITY,
    visibility = ["//apps/humata2:__subpackages__"],
    deps = DAEMON_DEPS,
)

# TS-2: humatad2, the holder, the humata CLI and the stack CLI for every
# platform a machine may be, with a manifest of their SHA-256s, as one folder
# for the app to carry and `humatad2 serve --tools` to read. The Linux
# platforms are the static musl ones (bazel/platforms), cross-built here.
tools_bundle(
    name = "tools",
    holder = "//apps/humata2/daemon/holder:humata2_holder",
    humata = "//apps/humata2/cli:humata",
    humatad2 = ":humatad2",
    platforms = {
        "//bazel/platforms:linux_arm64": "linux-aarch64",
        "//bazel/platforms:linux_x86_64": "linux-x86_64",
        "//bazel/platforms:macos_arm64": "darwin-arm64",
        "//bazel/platforms:macos_x86_64": "darwin-x86_64",
    },
    stack = "//tools/stack:stack",
    visibility = ["//apps/humata2:__subpackages__"],
)

# The Mac's own tools, signed ad hoc, for the app bundle to carry in
# Contents/Helpers (//apps/humata2/app). Remote machines get `:tools`.
tools_bundle(
    name = "tools_mac",
    holder = "//apps/humata2/daemon/holder:humata2_holder",
    humata = "//apps/humata2/cli:humata",
    humatad2 = ":humatad2",
    platforms = {
        "//bazel/platforms:macos_arm64": "darwin-arm64",
    },
    stack = "//tools/stack:stack",
    visibility = ["//apps/humata2/app:__pkg__"],
)

# The Linux tools (static musl, both architectures) the app carries in
# Contents/Resources/machine-tools, which it installs in ~/.humata2/machine-tools
# so Add machine finds the matching set (TS-2). ELF files only: nothing there
# needs codesigning.
tools_bundle(
    name = "tools_linux",
    holder = "//apps/humata2/daemon/holder:humata2_holder",
    humata = "//apps/humata2/cli:humata",
    humatad2 = ":humatad2",
    platforms = {
        "//bazel/platforms:linux_arm64": "linux-aarch64",
        "//bazel/platforms:linux_x86_64": "linux-x86_64",
    },
    stack = "//tools/stack:stack",
    visibility = ["//apps/humata2/app:__pkg__"],
)

# A test daemon: with `serve --admin`, a call with no credential acts as
# the user, so tests can drive it without logging in. Never shipped.
rust_binary(
    name = "humatad2_admin",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["admin"],
    rustc_env = APP_IDENTITY,
    # The app client's parity suite and the app's live flows run against it too.
    visibility = [
        "//apps/humata2/cli:__pkg__",
        "//apps/humata2/clients/live:__pkg__",
        "//apps/humata2/desktop:__pkg__",
    ],
    deps = DAEMON_DEPS,
)

# The admin test daemon with every fault point live, its own and its
# crates': HUMATA2_STOP_AT, HUMATA2_FAULT_TRACE, HUMATA2_FAULT_ARM,
# HUMATA2_FAIL_AT (a step returns its error), HUMATA2_POWER_CUT_ROOTS, and
# SIGUSR2 as a power cut. Never shipped.
rust_binary(
    name = "humatad2_faults",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "admin",
        "faults",
    ],
    rustc_env = APP_IDENTITY,
    visibility = ["//apps/humata2:__subpackages__"],
    deps = FAULTS_DEPS,
)

# The holder, for the app client's parity suite: the daemon there needs one
# to start sessions, and the holder is visible only inside daemon/.
filegroup(
    name = "holder_for_clients",
    testonly = True,
    srcs = ["//apps/humata2/daemon/holder:humata2_holder"],
    visibility = [
        "//apps/humata2/cli:__pkg__",
        "//apps/humata2/clients/live:__pkg__",
        "//apps/humata2/desktop:__pkg__",
    ],
)

# The release daemon's own unit tests: the link proof, the machine id,
# terminal sessions and CLI logins.
rust_test(
    name = "humatad2_unit_test",
    crate = ":humatad2",
    rustc_env = APP_IDENTITY,
    deps = [
        "//apps/humata2/daemon/conversation",
        "@crates//:rusqlite",
        "@crates//:tempfile",
    ],
)

# Runs a program in a terminal session of its own, for the CLI login
# tests: macOS has no setsid(1).
rust_binary(
    name = "setsid",
    testonly = True,
    srcs = ["tests/bin/setsid.rs"],
    # The desktop's remote live flows start the multi-machine rig, whose
    # fake `ssh` runs each link in a group of its own.
    visibility = ["//apps/humata2/desktop:__pkg__"],
    deps = ["@crates//:rustix"],
)

# The multi-machine rig (tests/common/remote_rig.rs and the harness it sits
# on), as a library for the desktop's live flows: a host and fake boxes in
# one test. Every binary it starts comes from the test's environment.
rust_library(
    name = "remote_rig",
    testonly = True,
    srcs = [
        "tests/common/mcp_client.rs",
        "tests/common/mod.rs",
        "tests/common/pr_github.rs",
        "tests/common/remote_rig.rs",
        "tests/rig/lib.rs",
    ],
    crate_name = "humata2_remote_rig",
    crate_root = "tests/rig/lib.rs",
    visibility = ["//apps/humata2/desktop:__pkg__"],
    deps = [
        ":grpc",
        "//apps/humata2/chunk:humata2_chunk",
        "//apps/humata2/daemon/machines",
        "//apps/humata2/daemon/machines:fake_machine",
        "//apps/humata2/daemon/store",
        "@crates//:hyper-util",
        "@crates//:prost",
        "@crates//:rustix",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tower",
    ],
)

