load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# humata2_snapshot once per engine: `snapshot` on ordinary GPUI, `snapshot_fast`
# on GPUI Fast (D57). Test-only, as the engine's test support it uses.
ENGINES = {
    "": "@crates//:gpui-kit",
    "_fast": "@crates_gpui_fast//:gpui-kit",
}

# GPUI's own `image` crate, so screenshots pass between them as one type.
IMAGE = {
    "": "@crates//:image",
    "_fast": "@crates_gpui_fast//:image",
}

[
    rust_library(
        name = "snapshot" + engine,
        testonly = True,
        srcs = glob(["src/*.rs"]),
        crate_features = ["fast"] if engine else [],
        crate_name = "humata2_snapshot",
        visibility = [
            "//apps/humata2/clients:__subpackages__",
            "//apps/humata2/desktop:__subpackages__",
            "//apps/humata2/diff:__subpackages__",
            "//apps/humata2/features:__subpackages__",
            "//apps/humata2/markdown:__subpackages__",
            "//apps/humata2/review:__subpackages__",
            "//apps/humata2/terminal:__subpackages__",
            "//apps/humata2/testing:__subpackages__",
            "//apps/humata2/ui:__subpackages__",
        ],
        deps = [
            gpui_kit,
            "//apps/humata2/engine:engine" + engine + "_test_support",
            "//libs/tca-rust:tca",
            IMAGE[engine],
            "@crates//:thiserror",
        ],
    )
    for engine, gpui_kit in ENGINES.items()
]

[
    rust_test(
        name = "snapshot" + engine + "_test",
        crate = ":snapshot" + engine,
    )
    for engine in ENGINES
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
