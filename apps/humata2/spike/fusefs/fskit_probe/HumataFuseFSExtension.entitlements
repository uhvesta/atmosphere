<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!---->
<!-- Gate T1 throwaway spike entitlements for HumataFuseFSExtension.appex. -->
<!-- Replace $(TeamIdentifierPrefix) with the Apple Developer Team ID prefix -->
<!-- when signing for macOS 26.7+ fskitd activation. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)com.humata2.fusefs</string>
    </array>
</dict>
</plist>
