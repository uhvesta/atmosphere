load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Shared wire protocol between the host daemon's To-do web server and the
# GPUI Wasm To-do client (WEBTODO, D905). Pure serde types; compiles on both
# native and wasm32-unknown-unknown.
rust_library(
    name = "wire",
    srcs = ["src/lib.rs"],
    crate_name = "humata2_web_todo_wire",
    visibility = ["//apps/humata2:__subpackages__"],
    deps = [
        "//apps/humata2/todo",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "wire_test",
    crate = ":wire",
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
