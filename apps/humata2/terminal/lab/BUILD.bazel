# Ordinary SSH clipboard acceptance; isolated headless clipboard, no personal shell config.
[
    rust_test(
        name = "clipboard_ssh" + engine + "_test",
        srcs = ["tests/clipboard_ssh.rs"],
        data = ["//apps/humata2/daemon/holder:humata2_holder"],
        env = {"HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder)"},
        tags = [
            "external",
            "manual",
        ],
        target_compatible_with = ["@platforms//os:macos"],
        deps = [
            ":lib" + engine,
            "//apps/humata2/engine:engine" + engine + "_test_support",
            "//apps/humata2/terminal/session",
            "//apps/humata2/terminal/vt:ghostty_vt",
            gpui,
            "@crates//:tempfile",
            "@crates//:tokio",
        ],
    )
    for engine, gpui in {
        "": "@crates//:gpui-kit",
        "_fast": "@crates_gpui_fast//:gpui-kit",
    }.items()
]

