load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//apps/humata2/testing:defs.bzl", "humata2_snapshot_test")

rust_library(
    name = "lib",
    srcs = glob(
        ["src/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "terminal_lab",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//apps/humata2/terminal/embed",
        "//apps/humata2/terminal/pane:terminal_pane",
        "//apps/humata2/terminal/session",
        "//apps/humata2/terminal/vt:ghostty_vt",
        "@crates//:gpui-kit",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "terminal_lab",
    srcs = ["src/main.rs"],
    data = ["//apps/humata2/daemon/holder:humata2_holder"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":lib",
        "//apps/humata2/engine",
        "//apps/humata2/terminal/session",
        "@crates//:gpui-kit",
        "@crates//:thiserror",
        "@crates//:tokio",
    ],
)

humata2_snapshot_test(
    name = "app_test",
    srcs = ["tests/app.rs"],
    data = ["//apps/humata2/daemon/holder:humata2_holder"],
    env = {
        "HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder)",
        "SHELL": "/bin/sh",
    },
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":lib",
        "//apps/humata2/engine:engine_test_support",
        "//apps/humata2/terminal/embed",
