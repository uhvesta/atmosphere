load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "vm_fixture_driver",
    srcs = ["tests/vm_fixture.sh"],
    tags = ["manual"],
)

rust_library(
    name = "host",
    srcs = glob(
        ["src/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "terminal_host",
    visibility = ["//apps/humata2/terminal/demo:__pkg__"],
    deps = [
        "//apps/humata2/terminal/codec",
        "//apps/humata2/terminal/provider",
        "//apps/humata2/terminal/session",
        "//apps/humata2/terminal/vt:ghostty_vt",
        "//apps/humata2/terminal/wire",
        "@crates//:axum",
        "@crates//:flate2",
        "@crates//:futures-util",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tokio-tungstenite",
    ],
)

rust_binary(
    name = "terminal_host",
    srcs = ["src/main.rs"],
    data = ["//apps/humata2/daemon/holder:humata2_holder"],
    visibility = ["//apps/humata2/terminal/demo:__pkg__"],
    deps = [
        ":host",
        "//apps/humata2/terminal/session",
        "//apps/humata2/terminal/wire",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "host_test",
    crate = ":host",
    data = ["//apps/humata2/daemon/holder:humata2_holder"],
    env = {"HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder)"},
    deps = [
        "@crates//:base64",
        "@crates//:tempfile",
        "@crates//:tokio-tungstenite",
    ],
)

rust_test(
    name = "agent_resume_codex_test",
    timeout = "moderate",
    args = [
        "--ignored",
        "actual_codex_host_recovers_exact_conversation_after_owned_child_sigkill",
        "--nocapture",
    ],
    crate = ":host",
    data = [
        "//apps/humata2/daemon/holder:humata2_holder",
        "//apps/humata2/terminal/provider:tests/codex_resume.py",
    ],
    env = {
        "HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder)",
        "TERMINAL_CODEX_HELPER": "$(rootpath //apps/humata2/terminal/provider:tests/codex_resume.py)",
    },
    tags = [
        "external",
        "local",
        "manual",
        "no-sandbox",
    ],
    deps = [
        "@crates//:base64",
        "@crates//:tempfile",
        "@crates//:tokio-tungstenite",
    ],
)

rust_test(
    name = "agent_resume_vm_test",
    timeout = "long",
    args = [
        "--ignored",
        "agent_resume_vm_tests::",
        "--nocapture",
    ],
    crate = ":host",
    data = [
        "tests/vm_fixture.sh",
        "//apps/humata2/daemon/holder:humata2_holder",
    ],
    env = {
        "HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/holder:humata2_holder)",
        "TERMINAL_VM_DRIVER": "$(rootpath :tests/vm_fixture.sh)",
    },
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    deps = [
        "@crates//:base64",
        "@crates//:tempfile",
        "@crates//:tokio-tungstenite",
    ],
)

