load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "wire",
    srcs = glob(["src/*.rs"]),
    crate_name = "terminal_wire",
    visibility = [
        "//apps/humata2/terminal/client:__pkg__",
        "//apps/humata2/terminal/demo:__pkg__",
        "//apps/humata2/terminal/host:__pkg__",
        "//apps/humata2/terminal/session:__pkg__",
        "//apps/humata2/terminal/web:__pkg__",
    ],
    deps = [
        "//apps/humata2/terminal/codec",
        "@crates//:base64",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "wire_test",
    crate = ":wire",
    deps = ["@crates//:serde_json"],
)
