# The live flow cases in shards that run side by side and beside other
# tests. Each case has its own world: its own folders under /tmp, its own
# daemon socket and no TCP port, and it ends only the processes started from
# its folders. A case past its limit has its world ended
# (live_flows/leftovers.rs), so a hang fails that case, not the run.
# RUST_TEST_THREADS keeps the shards together near the machine's cores.
sh_test(
    name = "live_flows_test",
    size = "large",
    srcs = ["tests/live_flows_shard.sh"],
    data = [":live_flows_cases"] + LIVE_FLOWS_DATA,
    env = dict(
        LIVE_FLOWS_ENV,
        LIVE_FLOWS_CASES = "$(rootpath :live_flows_cases)",
        RUST_TEST_THREADS = "4",
    ),
    shard_count = 3,
    target_compatible_with = ["@platforms//os:macos"],
)

# The shard script on a stand-in case binary (tests/live_flows_shard_test.sh):
# a case hung past its grace fails alone, and the cases that hadn't ended
# run again without it (D759).
sh_test(
    name = "live_flows_shard_test",
    srcs = ["tests/live_flows_shard_test.sh"],
    data = ["tests/live_flows_shard.sh"],
    env = {"LIVE_FLOWS_SHARD": "$(rootpath tests/live_flows_shard.sh)"},
)

# SSHE2E (D690): the app's whole path to a real shell on the shared Lima VM
# h2-terminal-c1: the app on live clients, this Mac's humatad2, real ssh,
# humatad2 --role machine and its holder on the VM, installed by the host's
# own Add machine from the real linux-aarch64 tools. Only `real_vm::` tests
# run. They skip unless TERMINAL_LAB_SSH_CONFIG is given:
#   ./terminal-ssh-demo.sh start
#   bazel test //apps/humata2/desktop:live_flows_ssh_test \
#     --test_env=TERMINAL_LAB_SSH_CONFIG="$HOME/.lima/h2-terminal-c1/ssh.config"
# Each test makes and removes its own throwaway user on the VM (D691).
sh_test(
    name = "live_flows_ssh_test",
    size = "large",
    srcs = ["tests/live_flows_run.sh"],
    # Only the real-VM tests, one at a time: the VM has 0.75 GiB.
    args = ["--test-threads=1"],
    data = [
        ":live_flows_cases",
        # The real tools the host installs on the VM (linux-aarch64).
        "//apps/humata2/daemon/humatad:tools",
    ] + LIVE_FLOWS_DATA,
    env = dict(
        LIVE_FLOWS_ENV,
        HUMATA2_TOOLS = "$(rootpath //apps/humata2/daemon/humatad:tools)",
        LIVE_FLOWS_CASES = "$(rootpath :live_flows_cases)",
        LIVE_FLOWS_FILTER = "real_vm::",
    ),
    # Starts real daemons and holders, so it runs alone.
    tags = [
        "exclusive",
        "external",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# FUSEFSWIRE T13: the FUSE mount on real Lima remotes. Cases 1 to 5 run on
# h2-fuse-r1 (FUSE_VM_SSH_CONFIG); 2 and 5 stop and start only that VM. Case 6
# runs on h2-terminal-c1 (TERMINAL_LAB_SSH_CONFIG) when it has no /dev/fuse.
# Slow tier, before each release:
#   bazel test //apps/humata2/desktop:live_flows_fuse_vm_test --strategy=TestRunner=local \
#     --test_env=FUSE_VM_SSH_CONFIG="$HOME/.lima/h2-fuse-r1/ssh.config" \
#     --test_env=TERMINAL_LAB_SSH_CONFIG="$HOME/.lima/h2-terminal-c1/ssh.config"
sh_test(
    name = "live_flows_fuse_vm_test",
    size = "enormous",
    srcs = ["tests/live_flows_run.sh"],
    args = ["--test-threads=1"],
    data = [
        ":live_flows_cases",
        # The real tools (linux-aarch64, with the FUSE helper) the host installs.
        "//apps/humata2/daemon/humatad:tools",
    ] + LIVE_FLOWS_DATA,
    env = dict(
        LIVE_FLOWS_ENV,
        HUMATA2_TOOLS = "$(rootpath //apps/humata2/daemon/humatad:tools)",
        LIVE_FLOWS_CASES = "$(rootpath :live_flows_cases)",
        LIVE_FLOWS_FILTER = "fuse_vm::",
    ),
    tags = [
        "exclusive",
        "external",
        "manual",
        "slow",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

