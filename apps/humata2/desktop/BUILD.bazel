# Humata 2's desktop app, on fake clients until the real daemon is wired in.
# Run it with `bazel run //apps/humata2/desktop:humata2`.
rust_binary(
    name = "humata2",
    srcs = glob(["src/*.rs"]),
    # GPUI's macros find gpui-kit through it.
    compile_data = ["Cargo.toml"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//apps/humata2/app:__pkg__"],
    deps = [
        "//apps/humata2/clients",
        "//apps/humata2/clients/live",
        "//apps/humata2/desktop/install",
        "//apps/humata2/engine",
        "//apps/humata2/features/app",
        "//apps/humata2/features/inbox",
        "//apps/humata2/ui",
        "//libs/tca-rust:tca",
        "@crates//:gpui-kit",
        "@crates//:notify",
        "@crates//:thiserror",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "humata2_fakes",
    srcs = glob(["src/*.rs"]),
    # GPUI's macros find gpui-kit through it.
    compile_data = ["Cargo.toml"],
    # The "Humata 2 (fakes)" app runs on the made-up workspace even from a
    # bundle (LOOK2).
    rustc_env = {"HUMATA2_BACKEND": "fakes"},
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//apps/humata2/app:__pkg__"],
    deps = [
        "//apps/humata2/clients",
        "//apps/humata2/clients/live",
        "//apps/humata2/desktop/install",
        "//apps/humata2/engine",
        "//apps/humata2/features/app",
        "//apps/humata2/features/inbox",
        "//apps/humata2/ui",
        "//libs/tca-rust:tca",
        "@crates//:gpui-kit",
        "@crates//:notify",
        "@crates//:thiserror",
        "@crates//:tokio",
    ],
)

