# What the live flow cases run: humata, the holder, both humatad2 builds
# and setsid, by the environment variables the cases read them from.
LIVE_FLOWS_DATA = [
    "//apps/humata2/cli:humata",
    "//apps/humata2/daemon/humatad:holder_for_clients",
    # SEAM (D397): devbox-1's own machine-role daemon (live_flows/away_box.rs).
    "//apps/humata2/daemon/humatad:humatad2",
    "//apps/humata2/daemon/humatad:humatad2_admin",
    # SEAM: the multi-machine rig's fake ssh runs each link under setsid.
    "//apps/humata2/daemon/humatad:setsid",
]

LIVE_FLOWS_ENV = {
    "HUMATA": "$(rootpath //apps/humata2/cli:humata)",
    "HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/humatad:holder_for_clients)",
    "HUMATA2_SETSID": "$(rootpath //apps/humata2/daemon/humatad:setsid)",
    "HUMATAD2": "$(rootpath //apps/humata2/daemon/humatad:humatad2_admin)",
    "HUMATAD2_RELEASE": "$(rootpath //apps/humata2/daemon/humatad:humatad2)",
}

