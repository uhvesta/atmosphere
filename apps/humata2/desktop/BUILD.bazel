# Bug reports as the app does them (I9): record, form, pin, copy, snapshot,
# replay and the socket, all headless.
rust_test(
    name = "report_test",
    srcs = ["tests/report.rs"],
    compile_data = ["Cargo.toml"],
    crate_root = "tests/report.rs",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//apps/humata2/clients",
        "//apps/humata2/engine:engine_test_support",
        "//apps/humata2/features/app",
        "//apps/humata2/report",
        "//apps/humata2/testing/flow",
        "//apps/humata2/ui",
        "//libs/tca-rust:tca",
        "@crates//:gpui-kit",
        "@crates//:tempfile",
        "@crates//:tokio",
