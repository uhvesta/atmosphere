load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Installs the host's own tools (humatad2, the holder, the humata CLI) from
# the app bundle into ~/.humata2/bin on every launch, registers the launchd
# login item and links `humata` onto the person's PATH (TS-0, PER-20, D51).
rust_library(
    name = "install",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "humata2_install",
    visibility = ["//apps/humata2/desktop:__pkg__"],
    deps = [
        "@crates//:rustix",
        "@crates//:sha2",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "install_test",
    srcs = ["tests/install.rs"],
    crate_root = "tests/install.rs",
    deps = [
        ":install",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
