load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Humata 2's bug reports (I9) without a GUI: recordings and snapshots of
# interactions, reducer actions, view and layout trees and daemon calls,
# scrubbed of seeded secrets and terminal text, saved as text files an agent
# can read, and turned into flow scripts that replay against fake daemon
# services made from the recording. The desktop app and the CLI add
# themselves to `visibility` when they start using it.
rust_library(
    name = "report",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_report",
    visibility = [
        # `humata report` (D133).
        "//apps/humata2/cli:__pkg__",
        # The daemon's restart reports (PER-29).
        "//apps/humata2/daemon/revive:__pkg__",
        # Record and replay in the desktop app (I9).
        "//apps/humata2/desktop:__subpackages__",
        "//apps/humata2/ui:__subpackages__",
    ],
    deps = [
        "@crates//:image",
        "@crates//:png",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:zstd",
    ],
)

rust_test(
    name = "report_unit_test",
    crate = ":report",
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src] + glob(["tests/support/*.rs"]),
        crate_root = src,
        # tests/folder_snapshot.rs reads its recorded folders from the
        # runfiles; `bazel run` with HUMATA2_SNAPSHOT=record writes them.
        data = glob(
            ["tests/__snapshots__/**"],
            allow_empty = True,
        ),
        deps = [
            ":report",
            "@crates//:image",
            "@crates//:png",
            "@crates//:serde_json",
            "@crates//:tempfile",
            "@crates//:tokio",
        ],
    )
    for src in glob(["tests/*.rs"])
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
