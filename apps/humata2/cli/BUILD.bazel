load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":descriptors.bzl", "proto_descriptor_set")

# `humata`, Humata 2's command for people and their scripts (../api/CLI.md):
# one gRPC operation per command, sent to the daemon's Unix socket.

# Every message the daemon can send, so any reply prints as JSON.
proto_descriptor_set(
    name = "descriptors",
    proto = "//apps/humata2/api/proto:humata2_proto",
)

# The commands, behind a Daemon trait the tests fake. Only this package's
# binary and tests use it.
rust_library(
    name = "cli",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    compile_data = [":descriptors"],
    crate_name = "humata2_cli",
    crate_root = "src/lib.rs",
    rustc_env = {"HUMATA2_DESCRIPTORS": "$(execpath :descriptors)"},
    deps = [
        "//apps/humata2/api/proto:humata2_rust",
        "//apps/humata2/chunk:humata2_chunk",
        "//apps/humata2/report",
        "@crates//:clap",
        "@crates//:hyper-util",
        "@crates//:prost",
        "@crates//:prost-reflect",
        "@crates//:rustix",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tower",
        "@crates//:uuid",
    ],
)

rust_binary(
    name = "humata",
    srcs = ["src/main.rs"],
    visibility = ["//apps/humata2:__subpackages__"],
    deps = [
        ":cli",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "cli_unit_test",
    crate = ":cli",
    deps = ["@crates//:tempfile"],
)

# One test binary per file: each runs commands against a fake daemon and
# checks the requests sent, the JSON printed and the exit code.
[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src] + glob(["tests/support/*.rs"]),
        crate_root = src,
        deps = [
            ":cli",
            "//apps/humata2/api/proto:humata2_rust",
            "//apps/humata2/chunk:humata2_chunk",
            "//apps/humata2/report",
            "@crates//:prost",
            "@crates//:serde_json",
            "@crates//:tempfile",
            "@crates//:tokio",
        ],
    )
    for src in glob(
        ["tests/*.rs"],
        exclude = ["tests/hosts_live.rs"],
    )
]

# `humata host|provider|skills sync` against a real humatad2 (the admin build) and a fake
# machine behind a fake `ssh`: no network, never the real ~/.ssh or home folder.
rust_test(
    name = "hosts_live_test",
    srcs = [
        "tests/hosts_live.rs",
        "//apps/humata2/daemon/humatad:tests/common/mod.rs",
    ],
    crate_root = "tests/hosts_live.rs",
    data = [
        ":humata",
        "//apps/humata2/daemon/humatad:holder_for_clients",
        "//apps/humata2/daemon/humatad:humatad2",
        "//apps/humata2/daemon/humatad:humatad2_admin",
    ],
    env = {
        "HUMATA": "$(rootpath :humata)",
        "HUMATA2_HOLDER": "$(rootpath //apps/humata2/daemon/humatad:holder_for_clients)",
        "HUMATAD2": "$(rootpath //apps/humata2/daemon/humatad:humatad2_admin)",
        "HUMATAD2_RELEASE": "$(rootpath //apps/humata2/daemon/humatad:humatad2)",
    },
    deps = [
        "//apps/humata2/chunk:humata2_chunk",
        "//apps/humata2/daemon/humatad:grpc",
        "//apps/humata2/daemon/machines:fake_machine",
        "//apps/humata2/daemon/store",
        "@crates//:hyper-util",
        "@crates//:prost",
        "@crates//:rustix",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tower",
    ],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "descriptors.bzl",
    ],
    tags = ["starlark"],
)
