load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The app's real Machines client over MachineService, ProviderService,
# SkillsService, OperationService, DaemonService, SessionService, and
# ChannelService.
rust_library(
    name = "live_machines",
    srcs = glob(["src/**/*.rs"]),
    aliases = {"//apps/humata2/clients:api": "humata2_clients"},
    crate_name = "humata2_clients_live_machines",
    visibility = [
        "//apps/humata2/clients:__subpackages__",
        "//apps/humata2/desktop:__subpackages__",
    ],
    deps = [
        "//apps/humata2/api/grpc:core",
        "//apps/humata2/api/grpc:machines",
        "//apps/humata2/api/grpc:peer",
        "//apps/humata2/api/grpc:sessions",
        "//apps/humata2/clients:api",
        "//apps/humata2/clients/live_core",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "live_machines_unit_test",
    crate = ":live_machines",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

MACHINES_TEST_DATA = [
    "//apps/humata2/clients/live:holder_for_clients",
    "//apps/humata2/daemon/humatad:humatad2_test_away_board",
    "//apps/humata2/daemon/humatad:humatad2_test_away_board_release",
]

MACHINES_TEST_ENV = {
    "HUMATA2_HOLDER": "$(rootpath //apps/humata2/clients/live:holder_for_clients)",
    "HUMATAD2": "$(rootpath //apps/humata2/daemon/humatad:humatad2_test_away_board)",
    "HUMATAD2_RELEASE": "$(rootpath //apps/humata2/daemon/humatad:humatad2_test_away_board_release)",
}

# The machines client against a real humatad2 and a fake machine: no network,
# never the real ~/.ssh.
rust_test(
    name = "machines_cases",
    srcs = ["tests/machines.rs"],
    crate_root = "tests/machines.rs",
    data = MACHINES_TEST_DATA,
    env = MACHINES_TEST_ENV,
    # Run through machines_test (sharded).
    tags = ["manual"],
    deps = [
        ":live_machines",
        "//apps/humata2/clients/live:clients",
        "//apps/humata2/clients/live:fake_machine",
        "//apps/humata2/clients/live:grpc",
        "//apps/humata2/clients/live_core",
        "//apps/humata2/clients/live_daemon",
        "@crates//:hyper-util",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tower",
    ],
)

sh_test(
    name = "machines_test",
    srcs = ["//apps/humata2/testing:rust_test_shard.sh"],
    data = [":machines_cases"] + MACHINES_TEST_DATA,
    env = dict(
        MACHINES_TEST_ENV,
        RUST_TEST_BIN = "$(rootpath :machines_cases)",
    ),
    shard_count = 2,
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
