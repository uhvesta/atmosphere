load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# One tab's gRPC attach read as the terminal component's frames, and its
# frames sent back (D271). Pure mapping with no runtime, so the browser
# client can share it. Only the live client uses it.
rust_library(
    name = "terminal_link",
    srcs = glob(["src/*.rs"]),
    crate_name = "humata2_terminal_link",
    visibility = ["//apps/humata2/clients/live:__pkg__"],
    deps = [
        "//apps/humata2/api/proto:humata2_rust",
        "//apps/humata2/terminal/wire",
        "@crates//:thiserror",
    ],
)

[
    rust_test(
        name = "%s_test" % src.removeprefix("tests/").removesuffix(".rs"),
        srcs = [src],
        deps = [
            ":terminal_link",
            "//apps/humata2/api/proto:humata2_rust",
            "//apps/humata2/terminal/wire",
        ],
    )
    for src in glob(["tests/*.rs"])
]

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
