load("@rules_rust//rust:defs.bzl", "rust_library")

# The app's real daemon client facade: re-exports `live_core` and the
# per-domain live client crates so existing callers build unchanged.
rust_library(
    name = "live",
    srcs = ["src/lib.rs"],
    crate_name = "humata2_clients_live",
    visibility = ["//apps/humata2/desktop:__subpackages__"],
    deps = [
        "//apps/humata2/clients/live_core",
        "//apps/humata2/clients/live_daemon",
        "//apps/humata2/clients/live_desk",
        "//apps/humata2/clients/live_diff",
        "//apps/humata2/clients/live_files",
        "//apps/humata2/clients/live_machines",
        "//apps/humata2/clients/live_review",
    ],
)

# Shared dependencies forwarded to the per-domain live client packages under
# `//apps/humata2/clients/...`.
alias(
    name = "grpc",
    actual = "//apps/humata2/daemon/humatad:grpc",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

alias(
    name = "terminal_link",
    actual = "//apps/humata2/clients/terminal_link:terminal_link",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

alias(
    name = "wire",
    actual = "//apps/humata2/terminal/wire:wire",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

alias(
    name = "fake_machine",
    testonly = True,
    actual = "//apps/humata2/daemon/machines:fake_machine",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

alias(
    name = "clients",
    testonly = True,
    actual = "//apps/humata2/clients:clients",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

alias(
    name = "humatad2_admin",
    testonly = True,
    actual = "//apps/humata2/daemon/humatad:humatad2_admin",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

alias(
    name = "holder_for_clients",
    testonly = True,
    actual = "//apps/humata2/daemon/humatad:holder_for_clients",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

# Unit tests across all split live crates.
test_suite(
    name = "live_unit_test",
    tests = [
        "//apps/humata2/clients/live_core:live_core_unit_test",
        "//apps/humata2/clients/live_daemon:live_daemon_unit_test",
        "//apps/humata2/clients/live_desk:live_desk_unit_test",
        "//apps/humata2/clients/live_diff:live_diff_unit_test",
        "//apps/humata2/clients/live_files:live_files_unit_test",
        "//apps/humata2/clients/live_machines:live_machines_unit_test",
        "//apps/humata2/clients/live_review:live_review_unit_test",
    ],
)

# Parity suites across daemon and review comments.
