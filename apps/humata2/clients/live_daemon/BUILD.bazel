load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "live_daemon",
    srcs = [
        "src/agent_switches.rs",
        "src/boards.rs",
        "src/channel_repos.rs",
        "src/daemon.rs",
        "src/events.rs",
        "src/history.rs",
        "src/inbox.rs",
        "src/lib.rs",
        "src/link.rs",
        "src/marks.rs",
        "src/message.rs",
        "src/read_marks.rs",
        "src/repos.rs",
        "src/running.rs",
        "src/session_repos.rs",
        "src/settings.rs",
        "src/setup.rs",
        "src/state.rs",
        "src/terminals.rs",
    ],
    aliases = {
        "//apps/humata2/clients:api": "humata2_clients",
    },
    crate_name = "humata2_clients_live_daemon",
    visibility = [
        "//apps/humata2/clients:__subpackages__",
        "//apps/humata2/desktop:__subpackages__",
    ],
    deps = [
        "//apps/humata2/api/grpc:board",
        "//apps/humata2/api/grpc:catalog",
        "//apps/humata2/api/grpc:core",
        "//apps/humata2/api/grpc:events",
        "//apps/humata2/api/grpc:inbox",
        "//apps/humata2/api/grpc:machines",
        "//apps/humata2/api/grpc:peer",
        "//apps/humata2/api/grpc:sessions",
        "//apps/humata2/api/grpc:terminal",
        "//apps/humata2/clients:api",
        "//apps/humata2/clients/live:terminal_link",
        "//apps/humata2/clients/live:wire",
        "//apps/humata2/clients/live_core",
        "//apps/humata2/clients/live_desk",
        "//apps/humata2/clients/live_diff",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "live_daemon_unit_test",
    crate = ":live_daemon",
    visibility = ["//apps/humata2/clients:__subpackages__"],
)

rust_test(
    name = "parity_daemon_test",
    srcs = ["tests/parity_daemon.rs"],
    crate_root = "tests/parity_daemon.rs",
    data = [
        "//apps/humata2/clients/live:holder_for_clients",
        "//apps/humata2/clients/live:humatad2_admin",
    ],
    env = {
        "HUMATA2_HOLDER": "$(rootpath //apps/humata2/clients/live:holder_for_clients)",
        "HUMATAD2": "$(rootpath //apps/humata2/clients/live:humatad2_admin)",
    },
    visibility = ["//apps/humata2/clients:__subpackages__"],
    deps = [
        ":live_daemon",
        "//apps/humata2/clients/live:clients",
        "//apps/humata2/clients/live_test_support",
        "@crates//:tokio",
    ],
)

