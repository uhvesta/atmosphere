"""Hermetic Swift toolchains for macOS arm64 and static Linux (musl).

Usage, in MODULE.bazel:

    swift = use_extension("//bazel/toolchains/swift:extensions.bzl", "swift")
    swift.toolchain(version = "6.4.2")
    use_repo(swift, "swift_toolchains")
    register_toolchains("@swift_toolchains//:all")

Nothing comes from the build machine: the compiler is the swift.org release
for the host, the macOS SDK is one of Apple's Command Line Tools SDK packages,
and the Linux SDK is the swift.org Static Linux SDK. Linking always goes
through the @llvm C/C++ toolchain, so Swift, C, Rust, Go and Zig share one
linker and one libc per platform.

Every release in swift_versions.json gets toolchains, selected by
--@swift_toolchains//:version. Its default works like rules_java: the root
module's `swift.toolchain(version = ...)` wins, then the first other module
that sets one, then DEFAULT_SWIFT_VERSION. A release's compiler and SDKs
download only when a build selects it. macOS SDKs are listed in
macos_sdks.json; regenerate both files with
`bazel run //tools/swift_catalog`. To use a mirror, rewrite the
download URLs with --downloader_config instead of overriding them here.
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
load("@llvm//:http_pkg_archive.bzl", "http_pkg_archive")
load(
    ":versions.bzl",
    "DEFAULT_SWIFT_VERSION",
    "MACOS_MINIMUM_OS",
    "MACOS_SDK_FRAMEWORKS",
)

_DOWNLOAD = "https://download.swift.org/swift-{v}-release"

# The compiler binaries swift_tools and the driver need. Everything else in
# usr/bin (clang, lldb, sourcekit, swift-package and friends) is left out:
# compiling C and linking are the @llvm toolchain's job.
_COMPILER_BINARIES = [
    "swift",
    "swift-autolink-extract",
    "swift-driver",
    "swift-frontend",
    "swift-plugin-server",
    "swift-symbolgraph-extract",
    "swiftc",
]

# Resource directories for platforms we never target.
_UNUSED_RESOURCE_DIRS = [
    "FrameworkABIBaseline",
    "appletvos",
    "appletvsimulator",
    "embedded",
    "iphoneos",
    "iphonesimulator",
    "migrator",
    "pm",
    "watchos",
    "watchsimulator",
    "xros",
    "xrsimulator",
]

_LINUX_ARCHES = {
    "aarch64": "aarch64",
    "x86_64": "x86_64",
}

def _compiler_repos(prefix, version, hashes):
    """Declares one compiler repository per supported build host."""
    http_pkg_archive(
        name = prefix + "compiler_macos",
        urls = [_DOWNLOAD.format(v = version) + "/xcode/swift-{v}-RELEASE/swift-{v}-RELEASE-osx.pkg".format(v = version)],
        sha256 = hashes["macos"],
        strip_prefix = "swift-{v}-RELEASE-osx-package.pkg/Payload".format(v = version),
        dst = "toolchain",
        includes = ["usr/bin/" + b for b in _COMPILER_BINARIES] + [
            "usr/lib/clang/*",
            "usr/lib/swift/*",
        ],
        excludes = ["usr/lib/swift/%s/*" % d for d in _UNUSED_RESOURCE_DIRS],
        files = {"BUILD.bazel": Label(":compiler.BUILD.bazel")},
    )

    for arch, key in [("aarch64", "linux_aarch64"), ("x86_64", "linux_x86_64")]:
        suffix = "-aarch64" if arch == "aarch64" else ""
        http_archive(
            name = prefix + "compiler_linux_" + arch,
            urls = [_DOWNLOAD.format(v = version) + "/ubuntu2204{s}/swift-{v}-RELEASE/swift-{v}-RELEASE-ubuntu22.04{s}.tar.gz".format(s = suffix, v = version)],
            sha256 = hashes[key],
            strip_prefix = "swift-{v}-RELEASE-ubuntu22.04{s}".format(s = suffix, v = version),
            add_prefix = "toolchain",
            build_file = Label(":compiler.BUILD.bazel"),
        )

def _static_sdk_impl(rctx):
    name = "swift-{v}-RELEASE_static-linux-{s}".format(
        v = rctx.attr.version,
        s = rctx.attr.sdk_version,
    )
    rctx.download_and_extract(
        url = rctx.attr.urls,
        sha256 = rctx.attr.sha256,
        stripPrefix = "{n}.artifactbundle/{n}/swift-linux-musl".format(n = name),
    )

    # The sysroot directory is named after the musl release (musl-1.2.5.sdk);
    # give it a stable name so the hub does not need to know it.
    sdks = [e for e in rctx.path(".").readdir() if e.basename.startswith("musl-") and e.basename.endswith(".sdk")]
    if len(sdks) != 1:
        fail("expected exactly one musl-*.sdk in the Static Linux SDK, found %s" % sdks)
    rctx.rename(sdks[0].basename, "musl.sdk")

    rctx.file("BUILD.bazel", "\n".join([
        "# Generated by //bazel/toolchains/swift:extensions.bzl.",
        'package(default_visibility = ["//visibility:public"])',
        "",
    ] + [
        """filegroup(
    name = "sdk_files_{arch}",
    srcs = glob(["musl.sdk/{arch}/**"]),
)
""".format(arch = arch)
        for arch in _LINUX_ARCHES
    ]))
    return rctx.repo_metadata(reproducible = True)

_static_sdk = repository_rule(
    implementation = _static_sdk_impl,
    doc = "The swift.org Static Linux SDK (musl), one sysroot per architecture.",
    attrs = {
        "sdk_version": attr.string(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "urls": attr.string_list(mandatory = True),
        "version": attr.string(mandatory = True),
    },
)

def _macos_sdk_repo(name, sdk, frameworks):
    includes = [
        "SDKSettings.json",
        "SDKSettings.plist",
        "usr/include/*",
        "usr/lib/*.tbd",
        "usr/lib/swift/*",
    ]
    for framework in frameworks:
        includes.append("System/Library/Frameworks/%s.framework/*" % framework)
    http_pkg_archive(
        name = name,
        urls = sdk.urls,
        sha256 = sdk.sha256,
        strip_prefix = sdk.strip_prefix,
        dst = "sdk",
        includes = includes,
        files = {"BUILD.bazel": Label(":macos_sdk.BUILD.bazel")},
    )

# The hub. It refers to the other repositories by label only, so building for
# one platform never downloads another platform's compiler or SDK.

_HUB_HEADER = """\
# Generated by //bazel/toolchains/swift:extensions.bzl. Do not edit.
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_swift//swift/toolchains:swift_toolchain.bzl", "swift_toolchain")
load("@rules_swift//swift/toolchains:swift_tools.bzl", "swift_tools")

package(default_visibility = ["//visibility:public"])

exports_files([".swift-version"])

# The Swift release to build with: --@swift_toolchains//:version=6.3.3.
# Defaults to the one MODULE.bazel pins. Each release's compiler and SDKs
# download only when a build selects it.
string_flag(
    name = "version",
    build_setting_default = "{default}",
    values = {versions},
)
"""

_VERSION = """
config_setting(
    name = "is_{v_}",
    flag_values = {{":version": "{version}"}},
)
"""

# rules_swift only adds swift_tools.additional_inputs to compile actions, so
# each (build host, target) pair gets its own swift_tools carrying the
# target's SDK.
_SWIFT_TOOLS = """
swift_tools(
    name = "{v_}_tools_{exec}_to_{target}",
    additional_inputs = [
        "@@{compiler}//:compiler_files",
        "{sdk_files}",
    ],
    swift_autolink_extract = "@@{compiler}//:toolchain/usr/bin/swift-autolink-extract",
    swift_driver = "@@{compiler}//:toolchain/usr/bin/swiftc",
    swift_symbolgraph_extract = "@@{compiler}//:toolchain/usr/bin/swift-symbolgraph-extract",
)
"""

_MACOS_TOOLCHAIN = """
swift_toolchain(
    name = "swift_{v_}_{exec}_to_macos_arm64",
    arch = "arm64",
    # rules_swift derives an unversioned triple from the C/C++ toolchain,
    # and an unversioned clang target means "the SDK version" (26.x). Pin
    # both to @llvm's minimum so Swift and C objects agree.
    copts = [
        "-target",
        "arm64-apple-macos{min_os}",
        "-Xcc",
        "--target=arm64-apple-macos{min_os}",
    ],
    # Run swiftc directly instead of through /usr/bin/xcrun; needs
    # rules_swift_no_xcrun.patch.
    env = {{"RULES_SWIFT_NO_XCRUN": "1"}},
    features = [
        "swift._supports_upcoming_features",
        "swift.no_embed_debug_module",
        # ld64.lld has no --defsym; keep `main` as the entry point.
        "swift.no_entry_point_rename",
        "-swift.remap_xcode_path",
    ],
    linker_inputs = [
        "@@{sdk}//:swift_link_files",
        "@@{compiler}//:compiler_files",
    ],
    linkopts = [
        "-L{sdk_dir}/usr/lib/swift",
        "-L{tc_dir}/usr/lib/swift/macosx",
        "-F{sdk_dir}/System/Library/Frameworks",
        "-Wl,-rpath,/usr/lib/swift",
    ],
    # "wasi" makes rules_swift take the link flags from this rule only,
    # instead of guessing paths inside an Xcode or system toolchain.
    os = "wasi",
    parsed_version = "{version}",
    sdkroot = "{sdk_dir}",
    swift_tools = ":{v_}_tools_{exec}_to_macos_arm64",
    version_file = "swift-version-{version}",
)

toolchain(
    name = "{v_}_{exec}_to_macos_arm64",
    exec_compatible_with = {exec_constraints},
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    target_settings = [":is_{v_}"],
    toolchain = ":swift_{v_}_{exec}_to_macos_arm64",
    toolchain_type = "@rules_swift//toolchains:toolchain_type",
)
"""

_MUSL_TOOLCHAIN = """
swift_toolchain(
    name = "swift_{v_}_{exec}_to_linux_{arch}_musl",
    arch = "{arch}",
    # @llvm reports an -unknown-linux-gnu triple for every Linux platform;
    # override it (including the clang importer's copy) so Swift sees musl.
    copts = [
        "-target",
        "{arch}-swift-linux-musl",
        "-Xcc",
        "--target={arch}-swift-linux-musl",
        "-Xwrapped-swift=-resource-dir={res}",
    ],
    # Run swiftc directly instead of through /usr/bin/xcrun; needs
    # rules_swift_no_xcrun.patch.
    env = {{"RULES_SWIFT_NO_XCRUN": "1"}},
    features = [
        "swift._supports_upcoming_features",
        "swift.no_embed_debug_module",
        "swift.use_autolink_extract",
        "-swift.remap_xcode_path",
    ],
    linker_inputs = ["@@{static_sdk}//:sdk_files_{arch}"],
    # What `swiftc -static-executable` adds; see
    # swift_static/linux-static/static-executable-args.lnk in the SDK.
    linkopts = [
        "{res}/linux-static/{arch}/swiftrt.o",
        "-L{res}/linux-static",
        # Foundation autolinks libraries the SDK ships (fts, xml2, curl, ...).
        # @llvm's own libc and libc++ are found first.
        "-L{sysroot}/usr/lib",
        "@{res}/linux-static/static-executable-args.lnk",
    ],
    os = "wasi",
    parsed_version = "{version}",
    sdkroot = "{sysroot}",
    swift_tools = ":{v_}_tools_{exec}_to_linux_{arch}_musl",
    version_file = "swift-version-{version}",
)

toolchain(
    name = "{v_}_{exec}_to_linux_{arch}_musl",
    exec_compatible_with = {exec_constraints},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:{arch}",
        "@llvm//constraints/libc:musl",
    ],
    target_settings = [":is_{v_}"],
    toolchain = ":swift_{v_}_{exec}_to_linux_{arch}_musl",
    toolchain_type = "@rules_swift//toolchains:toolchain_type",
)
"""

def _external(repo):
    return "external/" + repo

def _underscored(version):
    return version.replace(".", "_")

def _hub_impl(rctx):
    # Apparent repo name (as passed in `versions`) -> canonical name.
    canonical = {label.repo_name.rsplit("+", 1)[-1]: label.repo_name for label in rctx.attr.repos}
    versions = json.decode(rctx.attr.versions)
    ordered = sorted(versions, key = _version_key)

    content = [_HUB_HEADER.format(default = rctx.attr.default_version, versions = repr(ordered))]
    for version in ordered:
        repos = versions[version]
        v_ = _underscored(version)
        content.append(_VERSION.format(v_ = v_, version = version))
        rctx.file("swift-version-" + version, version + "\n")
        static_sdk = canonical[repos["static_sdk"]]
        sdk = canonical[repos["macos_sdk"]] if repos["macos_sdk"] else None
        execs = {
            "linux_aarch64": (repos["compiler_linux_aarch64"], ["@platforms//os:linux", "@platforms//cpu:aarch64"]),
            "linux_x86_64": (repos["compiler_linux_x86_64"], ["@platforms//os:linux", "@platforms//cpu:x86_64"]),
            "macos_arm64": (repos["compiler_macos"], ["@platforms//os:macos", "@platforms//cpu:aarch64"]),
        }
        for exec, (compiler, constraints) in sorted(execs.items()):
            compiler = canonical[compiler]
            fmt = dict(
                compiler = compiler,
                exec = exec,
                exec_constraints = repr(constraints),
                static_sdk = static_sdk,
                tc_dir = _external(compiler) + "/toolchain",
                v_ = v_,
                version = version,
            )

            # Apple's SDK license only covers Apple hardware, so only macOS
            # hosts build for macOS.
            if exec == "macos_arm64" and sdk:
                content.append(_SWIFT_TOOLS.format(
                    sdk_files = "@@%s//:sdk_files" % sdk,
                    target = "macos_arm64",
                    **fmt
                ))
                content.append(_MACOS_TOOLCHAIN.format(
                    min_os = MACOS_MINIMUM_OS,
                    sdk = sdk,
                    sdk_dir = _external(sdk) + "/sdk",
                    **fmt
                ))
            for arch in _LINUX_ARCHES:
                sysroot = "{}/musl.sdk/{}".format(_external(static_sdk), arch)
                content.append(_SWIFT_TOOLS.format(
                    sdk_files = "@@%s//:sdk_files_%s" % (static_sdk, arch),
                    target = "linux_%s_musl" % arch,
                    **fmt
                ))
                content.append(_MUSL_TOOLCHAIN.format(
                    arch = arch,
                    res = sysroot + "/usr/lib/swift_static",
                    sysroot = sysroot,
                    **fmt
                ))

    rctx.file("BUILD.bazel", "".join(content))
    rctx.file(".swift-version", rctx.attr.default_version + "\n")
    rctx.file("versions.bzl", """\
\"\"\"Swift releases @swift_toolchains can build with. Generated.\"\"\"

DEFAULT_VERSION = {default}

VERSIONS = {versions}

# Releases with a macOS SDK their compiler can read.
MACOS_VERSIONS = {macos}
""".format(
        default = repr(rctx.attr.default_version),
        versions = repr(ordered),
        macos = repr([v for v in ordered if versions[v]["macos_sdk"]]),
    ))
    return rctx.repo_metadata(reproducible = True)

_hub = repository_rule(
    implementation = _hub_impl,
    doc = "Declares swift_toolchain and toolchain() targets for every release and (build host, target) pair.",
    attrs = {
        "default_version": attr.string(mandatory = True),
        "repos": attr.label_list(mandatory = True, doc = "Every repo named in `versions`, to find canonical names."),
        "versions": attr.string(mandatory = True, doc = "JSON: release -> apparent names of its compiler, static SDK and macOS SDK repos."),
    },
)

def _select_tag(mctx, tag_name):
    """Returns the root module's tag, else the first module's, else None."""
    selected = None
    for mod in mctx.modules:
        tags = getattr(mod.tags, tag_name)
        if len(tags) > 1:
            fail("only one swift.%s(...) tag is allowed per module (%s has %d)" % (tag_name, mod.name, len(tags)))
        if not tags:
            continue
        if mod.is_root:
            return tags[0]
        if selected == None:
            selected = tags[0]
    return selected

def _version_key(version):
    return [int(part) for part in version.split(".")]

def _newest_readable_sdk(xcode):
    """The newest macOS SDK a Swift release's compiler can read, or None.

    A swift.org compiler can't load SDK modules built by a newer compiler, so
    an SDK is usable only if it is no newer than the one in the Xcode that the
    release shipped with (swift.org's "xcode" field, for example "Xcode 26.4").
    From Xcode 26 on, that SDK's version is at most the Xcode version.
    """
    words = xcode.split(" ")
    if len(words) != 2:
        return None
    parts = [int(p) for p in words[1].split(".") if p.isdigit()]
    if not parts:
        return None
    return [parts[0], parts[1] if len(parts) > 1 else 0]

def _pick_sdk(release, sdks, requested):
    """Picks the macOS SDK version for a release, or None if none fits.

    That is the requested SDK if the release's compiler can read it, else the
    newest one it can read.
    """
    newest = _newest_readable_sdk(release.get("xcode", ""))
    readable = [s for s in sdks if newest == None or _version_key(s) <= newest]
    if requested and requested in readable:
        return requested
    return sorted(readable, key = _version_key)[-1] if readable else None

def _swift_impl(mctx):
    releases = json.decode(mctx.read(Label(":swift_versions.json")))
    sdks = json.decode(mctx.read(Label(":macos_sdks.json")))

    toolchain = _select_tag(mctx, "toolchain")
    default = toolchain.version if toolchain else DEFAULT_SWIFT_VERSION
    if toolchain and (toolchain.sha256 or toolchain.static_sdk_version):
        release = dict(releases.get(default, {}))
        release.update(toolchain.sha256)
        if toolchain.static_sdk_version:
            release["static_sdk_version"] = toolchain.static_sdk_version
        releases[default] = release
    missing = [k for k in ["linux_aarch64", "linux_x86_64", "macos", "static_sdk", "static_sdk_version"] if k not in releases.get(default, {})]
    if missing:
        fail("Swift {v} is not in //bazel/toolchains/swift:swift_versions.json (known: {known}). Run `bazel run //tools/swift_catalog`, or pass swift.toolchain(sha256 = {{...}}, static_sdk_version = ...) with: {m}".format(
            v = default,
            known = ", ".join(sorted(releases, key = _version_key)),
            m = ", ".join(missing),
        ))

    # The macOS SDK: the root module's swift.macos_sdk(version = ...) for every
    # release that can read it, else each release's newest readable SDK. A
    # replacement package (urls = ...) is used as is for every release.
    sdk_tag = _select_tag(mctx, "macos_sdk")
    requested = sdk_tag.version if sdk_tag else ""
    if requested and requested not in sdks:
        fail("macOS SDK {s} is not in //bazel/toolchains/swift:macos_sdks.json (known: {known})".format(
            s = requested,
            known = ", ".join(sorted(sdks, key = _version_key)),
        ))
    custom_sdk = sdk_tag != None and len(sdk_tag.urls) > 0
    frameworks = list(MACOS_SDK_FRAMEWORKS)
    for mod in mctx.modules:
        for tag in mod.tags.macos_sdk:
            frameworks.extend([f for f in tag.frameworks if f not in frameworks])
    frameworks = sorted(frameworks)

    hub_versions = {}
    sdk_repos = {}
    for version, release in releases.items():
        prefix = "swift_%s_" % _underscored(version)
        _compiler_repos(prefix, version, release)
        _static_sdk(
            name = prefix + "static_sdk",
            version = version,
            sdk_version = release["static_sdk_version"],
            sha256 = release["static_sdk"],
            urls = [_DOWNLOAD.format(v = version) + "/static-sdk/swift-{v}-RELEASE/swift-{v}-RELEASE_static-linux-{s}.artifactbundle.tar.gz".format(
                v = version,
                s = release["static_sdk_version"],
            )],
        )
        if custom_sdk:
            sdk_repo = "swift_macos_sdk_custom"
            if sdk_repo not in sdk_repos:
                sdk_repos[sdk_repo] = struct(sha256 = sdk_tag.sha256, strip_prefix = sdk_tag.strip_prefix, urls = sdk_tag.urls)
        else:
            sdk_version = _pick_sdk(release, sdks, requested)
            if version == default and requested and sdk_version != requested:
                fail("Swift {v} ({x}) can't read the macOS {s} SDK; use an older SDK or a newer Swift".format(
                    v = version,
                    x = release.get("xcode", "unknown Xcode"),
                    s = requested,
                ))
            sdk_repo = ("swift_macos_sdk_" + _underscored(sdk_version)) if sdk_version else ""
            if sdk_repo and sdk_repo not in sdk_repos:
                entry = sdks[sdk_version]
                sdk_repos[sdk_repo] = struct(sha256 = entry["sha256"], strip_prefix = entry["strip_prefix"], urls = entry["urls"])
        hub_versions[version] = {
            "compiler_linux_aarch64": prefix + "compiler_linux_aarch64",
            "compiler_linux_x86_64": prefix + "compiler_linux_x86_64",
            "compiler_macos": prefix + "compiler_macos",
            "macos_sdk": sdk_repo,
            "static_sdk": prefix + "static_sdk",
        }
    for name, sdk in sdk_repos.items():
        _macos_sdk_repo(name, sdk, frameworks)

    repo_names = sorted({n: None for repos in hub_versions.values() for n in repos.values() if n}.keys())
    _hub(
        name = "swift_toolchains",
        default_version = default,
        repos = ["@%s//:BUILD.bazel" % name for name in repo_names],
        versions = json.encode(hub_versions),
    )
    return mctx.extension_metadata(reproducible = True)

_toolchain_tag = tag_class(
    doc = "Selects the Swift release. The root module's choice wins.",
    attrs = {
        "sha256": attr.string_dict(
            doc = "Artifact hashes for a release missing from swift_versions.json. Keys: macos, linux_aarch64, linux_x86_64, static_sdk.",
        ),
        "static_sdk_version": attr.string(
            doc = "Static Linux SDK version in the artifact name, for a release missing from swift_versions.json.",
        ),
        "version": attr.string(mandatory = True, doc = "Swift release, for example 6.4.2."),
    },
)

_macos_sdk_tag = tag_class(
    doc = """Selects the macOS SDK and adds frameworks to its slice.

The root module's version (or replacement package) wins, then the first
other module's. Each Swift release uses that SDK if its compiler can read
it, else the newest SDK in macos_sdks.json that it can read.""",
    attrs = {
        "frameworks": attr.string_list(doc = "Extra System/Library/Frameworks to extract. Additive across modules."),
        "sha256": attr.string(),
        "strip_prefix": attr.string(),
        "urls": attr.string_list(),
        "version": attr.string(doc = "SDK version from macos_sdks.json, for example 15.5."),
    },
)

swift = module_extension(
    implementation = _swift_impl,
    tag_classes = {
        "macos_sdk": _macos_sdk_tag,
        "toolchain": _toolchain_tag,
    },
)
