build:lint --aspects=//bazel/lint:linters.bzl%buildifier,//bazel/lint:linters.bzl%clippy,//bazel/lint:linters.bzl%shellcheck,//bazel/lint:linters.bzl%swift_format,//bazel/lint:linters.bzl%swiftlint,//bazel/lint:linters.bzl%vale
build:lint --@aspect_rules_lint//lint:fail_on_violation

# always lint
build --config=lint

# On Linux, build static musl binaries for the host CPU by default (see
# bazel/platforms/BUILD.bazel). macOS hosts already target themselves.
common --enable_platform_specific_config
build:linux --platforms=//bazel/platforms:linux_host
# Tests need an execution platform that matches their target, linux_host.
# ORDER MATTERS: Bazel gives each action the first execution platform that
# fits, so the host must come first. Build-time tools then still build for
# the host, and only actions that need musl, like tests, fall through to
# linux_host. With linux_host first, every tool builds for static musl, where
# Rust can't build proc-macros ("can't find crate for thiserror_impl").
build:linux --extra_execution_platforms=@platforms//host,//bazel/platforms:linux_host

# Fail if anything reads Xcode or the Command Line Tools: Swift, C/C++, Rust,
# Go and Zig must all come from Bazel-managed toolchains. Used by CI on macOS.
build:no_xcode --sandbox_block_path=/Applications
build:no_xcode --sandbox_block_path=/Library/Developer
build:no_xcode --sandbox_block_path=/usr/bin/xcrun
build:no_xcode --sandbox_block_path=/usr/bin/xcode-select
build:no_xcode --worker_sandboxing

# Cross-compilation targets (see bazel/platforms/BUILD.bazel).
build:macos_arm64 --platforms=//bazel/platforms:macos_arm64
build:linux_arm64 --platforms=//bazel/platforms:linux_arm64
build:linux_x86_64 --platforms=//bazel/platforms:linux_x86_64
build:linux_arm64_gnu --platforms=//bazel/platforms:linux_arm64_gnu
build:linux_x86_64_gnu --platforms=//bazel/platforms:linux_x86_64_gnu

# On musl, Go's internal linker gives cgo binaries (anything importing net or
# os/user) an /lib/ld-musl-*.so.1 interpreter. Link them statically through
# @llvm instead. The glibc platforms keep glibc dynamic.
build:linux --@rules_go//go/config:static
build:linux_arm64 --@rules_go//go/config:static
build:linux_x86_64 --@rules_go//go/config:static
build:macos_arm64 --no@rules_go//go/config:static
build:linux_arm64_gnu --no@rules_go//go/config:static
build:linux_x86_64_gnu --no@rules_go//go/config:static

# Apps that need Xcode (see bazel/xcode/BUILD.bazel). rules_apple transitions
# to the platforms these flags name; the //bazel/xcode variants select Xcode's
# toolchains. Without this config those apps are skipped.
# xcode builds iPhone apps for the simulator; xcode_toolchains is the rest,
# for configs that build for devices instead.
build:xcode_toolchains --@apple_support//platforms:macos_arm64_platform=//bazel/xcode:macos_arm64
build:xcode_toolchains --@apple_support//platforms:ios_arm64_platform=//bazel/xcode:ios_arm64
build:xcode_toolchains --@apple_support//platforms:ios_sim_arm64_platform=//bazel/xcode:ios_sim_arm64
build:xcode_toolchains --macos_cpus=arm64
# Swift binaries and tests otherwise target the SDK's macOS, so a newer Xcode
# builds tests this Mac can't load. Matches the Mac app's minimum_os_version.
build:xcode_toolchains --macos_minimum_os=15.0
build:xcode_toolchains --host_macos_minimum_os=15.0
# Writes each Swift file's localizable strings, for //apps/lifr/app:strings.
build:xcode_toolchains --features=swift.emit_localized_strings
build:xcode --config=xcode_toolchains
build:xcode --ios_multi_cpus=sim_arm64
# Tools these builds run on the build machine also use Xcode: Swift macro
# plugins (swift-syntax) and rules_xcodeproj's rsync. @llvm's ld64.lld rejects
# the -defsym that rules_swift links plugins with, and the duplicate xxhash
# symbols in rsync's lz4 and xxhash.
build:xcode_toolchains --host_platform=//bazel/xcode:macos_arm64
# Up to four tests at once, each on a simulator of its own: about what 16 GB
# of memory holds alongside the build.
test:xcode --local_test_jobs=4
# Re-records snapshot references into the source tree (see
# apps/libs/kits/flow/defs.bzl). The run fails by design; run the tests
# again without this config to verify.
test:record_snapshots --config=xcode
test:record_snapshots --test_env=FLOWKIT_RECORD=1
test:record_snapshots --nocache_test_results
# Mac snapshot tests run on the host, where the sandbox would throw away the
# references they write into the source tree.
test:record_snapshots --strategy=TestRunner=local
# Lifr signed for your team (see apps/lifr/identity.bzl): the Mac app and
# `lifr` with Developer ID, and the iPhone app for devices with the team's
# development profile. Each needs its certificate in the login keychain, and
# LIFR_TEAM_ID and LIFR_BUNDLE_PREFIX set in user.bazelrc.
build:lifr_mac_release --config=xcode
build:lifr_mac_release --//apps/lifr:signed
build:lifr_mac_release --@rules_apple//apple/build_settings:signing_certificate_name="Developer ID Application"
build:lifr_mac_release --apple_generate_dsym
build:lifr_mac_release --compilation_mode=opt
build:lifr_ios_device --config=xcode_toolchains
build:lifr_ios_device --//apps/lifr:signed
build:lifr_ios_device --ios_multi_cpus=arm64
build:lifr_ios_device --apple_generate_dsym
build:lifr_ios_device --compilation_mode=opt
# The iPhone apps, Lifr and LangReadr, signed for the App Store, as their
# tools/testflight uploads them: needs the Apple Distribution certificate
# and the profiles it makes.
build:lifr_testflight --config=lifr_ios_device
build:lifr_testflight --//apps/lifr:app_store
# Builds started from the generated Lifr.xcodeproj (//apps/lifr:xcodeproj).
common:rules_xcodeproj --config=xcode
# Settings for this checkout only, such as LIFR_TEAM_ID and LIFR_BUNDLE_PREFIX
# for signing Lifr. Gitignored; keep it last so it overrides the above.
try-import %workspace%/user.bazelrc

# Fetched repositories nobody has used for a week go, once Bazel has been
# idle for a minute, so the shared repository cache doesn't grow forever.
common --repo_contents_cache_gc_max_age=7d
common --repo_contents_cache_gc_idle_delay=1m
