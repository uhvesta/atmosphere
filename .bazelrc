build:lint --aspects=//bazel/lint:linters.bzl%buildifier,//bazel/lint:linters.bzl%clippy,//bazel/lint:linters.bzl%shellcheck,//bazel/lint:linters.bzl%vale
build:lint --@aspect_rules_lint//lint:fail_on_violation

# always lint
build --config=lint

# On Linux, build static musl binaries for the host CPU by default (see
# bazel/platforms/BUILD.bazel). macOS hosts already target themselves.
common --enable_platform_specific_config
build:linux --platforms=//bazel/platforms:linux_host
# Tests need an execution platform that matches their target, linux_host.
# ORDER MATTERS: Bazel gives each action the first execution platform that
# fits, so the host must come first. Build-time tools then still build for
# the host, and only actions that need musl, like tests, fall through to
# linux_host. With linux_host first, every tool builds for static musl, where
# Rust can't build proc-macros ("can't find crate for thiserror_impl").
build:linux --extra_execution_platforms=@platforms//host,//bazel/platforms:linux_host

# Cross-compilation targets (see bazel/platforms/BUILD.bazel).
build:macos_arm64 --platforms=//bazel/platforms:macos_arm64
build:linux_arm64 --platforms=//bazel/platforms:linux_arm64
build:linux_x86_64 --platforms=//bazel/platforms:linux_x86_64
build:linux_arm64_gnu --platforms=//bazel/platforms:linux_arm64_gnu
build:linux_x86_64_gnu --platforms=//bazel/platforms:linux_x86_64_gnu

# On musl, Go's internal linker gives cgo binaries (anything importing net or
# os/user) an /lib/ld-musl-*.so.1 interpreter. Link them statically through
# @llvm instead. The glibc platforms keep glibc dynamic.
build:linux --@rules_go//go/config:static
build:linux_arm64 --@rules_go//go/config:static
build:linux_x86_64 --@rules_go//go/config:static
build:macos_arm64 --no@rules_go//go/config:static
build:linux_arm64_gnu --no@rules_go//go/config:static
build:linux_x86_64_gnu --no@rules_go//go/config:static
