build:lint --aspects=//tools/lint:linters.bzl%buildifier,//tools/lint:linters.bzl%clippy,//tools/lint:linters.bzl%shellcheck,//tools/lint:linters.bzl%vale
build:lint --@aspect_rules_lint//lint:fail_on_violation

# always lint
build --config=lint

# Cross-compilation targets (see tools/platforms/BUILD.bazel).
build:macos_arm64 --platforms=//tools/platforms:macos_arm64
build:linux_arm64 --platforms=//tools/platforms:linux_arm64
build:linux_x86_64 --platforms=//tools/platforms:linux_x86_64
build:linux_arm64_gnu --platforms=//tools/platforms:linux_arm64_gnu
build:linux_x86_64_gnu --platforms=//tools/platforms:linux_x86_64_gnu
