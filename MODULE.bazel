# MARK: - C/C++

# Xcode's C/C++ toolchain for the Xcode platforms only (//bazel/xcode). It
# must come before @llvm, which would otherwise match those platforms too.
register_toolchains("//bazel/xcode:all")

# Hermetic LLVM: zero-sysroot C/C++ toolchain for every exec/target pair. It
# brings its own libc (glibc stubs, musl) and downloads the macOS SDK, so no
# host compiler, Xcode, or sysroot is used. Rust, Go (cgo), and Swift link
# through it.
register_toolchains("@llvm//toolchain:all")

# MARK: - Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.14.4")

# MARK: - Go

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_bazelbuild_buildtools", "com_github_burntsushi_toml", "com_github_spf13_cobra", "org_golang_x_tools", "org_golang_x_tools_gopls")

# MARK: - Rust

rust_from_cargo = use_extension("//bazel/toolchains/rust:toolchain.bzl", "rust_from_cargo")
use_repo(rust_from_cargo, "rust_metadata", "rust_toolchains")

# Crates for the Cargo workspace (Cargo.toml, Cargo.lock). After changing
# dependencies, repin with `CARGO_BAZEL_REPIN=1 bazel mod tidy`.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
    # The hosts the Rust tools run on: the bootstrap hosts and the platforms in
    # //bazel/platforms. rules_rust matches crate selects on OS and CPU only,
    # so the gnu triples also cover the musl platforms.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# rules_rust's build script runner drops AR when it is libtool, as @llvm's is
# on macOS, so cc-rs falls back to /usr/bin/ar, which needs Xcode or the
# Command Line Tools. The patch passes it through; cc-rs drives libtool.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//bazel/toolchains/rust:rules_rust_libtool_ar.patch"],
)

# musl first: the glibc toolchains leave libc unconstrained, so they would
# otherwise also match the musl platforms.
register_toolchains(
    "@rust_toolchains//:rust_host__aarch64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_host__x86_64-unknown-linux-musl__stable",
    "@rust_toolchains//:all",
)

# prost for Humata's protocol, from the workspace's crates. Ahead of
# rules_rust_prost's default toolchain, which pins an older prost. See
# apps/humata/proto/BUILD.bazel.
register_toolchains("//apps/humata/proto:prost_toolchain")

# MARK: - Swift

# Hermetic swift.org compilers plus the macOS and Static Linux (musl) SDKs.
# Override the version from your own MODULE.bazel with
# swift.toolchain(version = "..."); see //bazel/toolchains/swift:versions.bzl.
swift = use_extension("//bazel/toolchains/swift:extensions.bzl", "swift")
swift.toolchain(version = "6.4.2")
use_repo(swift, "swift_toolchains")

register_toolchains("@swift_toolchains//:all")

# SwiftLint from source, for the lint aspect in //bazel/lint:swift.bzl. Its
# version and the hashes of its dependencies are pinned by the registry and
# MODULE.bazel.lock. swift-format needs no dependency: it ships in the
# swift.org release, and @swift_toolchains registers it as a toolchain.
register_toolchains("//bazel/toolchains/swift:swiftlint_toolchain")

# The rules_swift worker runs every compile through /usr/bin/xcrun on macOS,
# which needs Xcode or the Command Line Tools. The patch skips xcrun when the
# toolchain sets RULES_SWIFT_NO_XCRUN, as @swift_toolchains does.
# swift_compiler_plugin renames `main` and aliases it back with --defsym, which
# ld64.lld lacks; the second patch makes it honor swift.no_entry_point_rename
# like swift_binary, so SwiftLint's macro plugin links without Xcode.
single_version_override(
    module_name = "rules_swift",
    patch_strip = 1,
    patches = [
        "//bazel/toolchains/swift:rules_swift_no_xcrun.patch",
        "//bazel/toolchains/swift:rules_swift_plugin_entry_point.patch",
    ],
)

# MARK: - Swift packages

# Third-party Swift packages for the Xcode apps, from apps/lifr/Package.swift.
# The extension runs the host's `swift package` (Xcode's), so only builds that
# use a @swiftpkg_* repository need Xcode. Update the pins with
# `bazel run @swift_package//:resolve`.
swift_deps = use_extension("@rules_swift_package_manager//:extensions.bzl", "swift_deps")
swift_deps.from_package(
    resolved = "//apps/lifr:Package.resolved",
    swift = "//apps/lifr:Package.swift",
)

# Unlike SwiftPM, rules_swift_package_manager adds every folder in a C
# target that holds a header to its include path, and some of MLX's headers
# then shadow the system's: mlx-c/mlx/c/string.h, mlx-generated/metal's
# complex.h. It drops folders inside one it already has, so an empty header
# at Cmlx's root leaves only that, which shadows nothing; the paths
# Package.swift names stay. MLX's Metal kernels are compiled from their own
# pinned copy (see apps/libs/kits/inference/mlx/mlx_kernels.bzl), so their
# sources here are removed: MLX's C++ doesn't include them.
swift_deps.configure_package(
    name = "mlx-swift",
    patch_cmds = [
        "touch Source/Cmlx/bazel_include_root.h",
        "rm -r Source/Cmlx/mlx-generated/metal",
        # mlx-conditional's wrappers include sources Package.swift excludes,
        # which Bazel then leaves out of the build: copy them in as headers.
        "cp Source/Cmlx/mlx/mlx/backend/cpu/compiled.cpp Source/Cmlx/mlx-conditional/cpu_compiled.h",
        "cp Source/Cmlx/mlx/mlx/backend/no_cpu/compiled.cpp Source/Cmlx/mlx-conditional/no_cpu_compiled.h",
        "cp Source/Cmlx/mlx/mlx/backend/cpu/jit_compiler.cpp Source/Cmlx/mlx-conditional/jit_compiler.h",
        "perl -pi -e 's|\\.\\./mlx/mlx/backend/cpu/compiled\\.cpp|cpu_compiled.h|; s|\\.\\./mlx/mlx/backend/no_cpu/compiled\\.cpp|no_cpu_compiled.h|; s|\\.\\./mlx/mlx/backend/cpu/jit_compiler\\.cpp|jit_compiler.h|' Source/Cmlx/mlx-conditional/*.cpp",
    ],
)

# The same for mlx-swift-lm's xgrammar, which holds answers to a schema.
swift_deps.configure_package(
    name = "mlx-swift-lm",
    patch_cmds = [
        "cp Libraries/MLXCXGrammar/xgrammar/cpp/grammar_functor.cc Libraries/MLXCXGrammar/xgrammar/cpp/grammar_functor_source.h",
        "perl -pi -e 's|grammar_functor\\.cc\"|grammar_functor_source.h\"|' Libraries/MLXCXGrammar/grammar_functor_wrapper.cc",
    ],
)
use_repo(swift_deps, "swift_package", "swiftpkg_mlx_swift", "swiftpkg_mlx_swift_lm", "swiftpkg_swift_composable_architecture", "swiftpkg_swift_snapshot_testing", "swiftpkg_swift_transformers", "swiftpkg_swiftterm")

# Google's LiteRT-LM, which runs downloaded models for Lifr: its Swift API
# and prebuilt runtime, pinned by SHA-256. See
# apps/libs/kits/inference/litert/litert_lm.bzl.
litert_lm = use_repo_rule("//apps/libs/kits/inference/litert:litert_lm.bzl", "litert_lm")

litert_lm(name = "litert_lm")

# llama.cpp, which runs downloaded GGUF models for Lifr: its prebuilt
# framework for iPhones and Macs, pinned by SHA-256. See
# apps/libs/kits/inference/llama/llama_cpp.bzl.
llama_cpp = use_repo_rule("//apps/libs/kits/inference/llama:llama_cpp.bzl", "llama_cpp")

llama_cpp(name = "llama_cpp")

# MLX's Metal kernels, which SwiftPM can't build, from the mlx-swift commit
# apps/lifr/Package.resolved pins. See
# apps/libs/kits/inference/mlx/mlx_kernels.bzl.
mlx_kernels = use_repo_rule("//apps/libs/kits/inference/mlx:mlx_kernels.bzl", "mlx_kernels")

mlx_kernels(name = "mlx_kernels")

# Qwen3.5 0.8B in MLX's format, for the MLX spike. Only that manual test
# fetches it. See apps/libs/kits/inference/mlx/test_model.bzl.
mlx_test_model = use_repo_rule("//apps/libs/kits/inference/mlx:test_model.bzl", "mlx_test_model")

mlx_test_model(name = "mlx_test_model")

# Qwen3.5 0.8B, as Lifr's catalog pins it, for llama.cpp's smoke test. Only
