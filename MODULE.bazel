# apps/libs/kits/inference/llama/test_model.bzl.
gguf_test_model = use_repo_rule("//apps/libs/kits/inference/llama:test_model.bzl", "gguf_test_model")

gguf_test_model(name = "llama_test_model")

# Gemma 4 E2B, as Lifr's catalog pins it, for the assistant's end-to-end
