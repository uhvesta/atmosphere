module(name = "monty_oxide")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "llvm", version = "0.8.18")
bazel_dep(name = "aspect_rules_lint", version = "2.9.0")
bazel_dep(name = "aspect_rules_lint_rust", version = "0.0.3")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_zig", version = "0.17.0")
bazel_dep(name = "rules_python", version = "2.4.0-rc1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "toml.bzl", version = "0.5.0")
bazel_dep(name = "apple_support", version = "2.11.0")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")

# MARK: - C/C++

# Xcode's C/C++ toolchain for the Xcode platforms only (//bazel/xcode). It
# must come before @llvm, which would otherwise match those platforms too.
register_toolchains("//bazel/xcode:all")

# Hermetic LLVM: zero-sysroot C/C++ toolchain for every exec/target pair. It
# brings its own libc (glibc stubs, musl) and downloads the macOS SDK, so no
# host compiler, Xcode, or sysroot is used. Rust, Go (cgo), and Swift link
# through it.
register_toolchains("@llvm//toolchain:all")

# MARK: - Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.14.4")

# MARK: - Go

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_bazelbuild_buildtools", "com_github_burntsushi_toml", "com_github_spf13_cobra", "org_golang_x_tools", "org_golang_x_tools_gopls")

# MARK: - Rust

rust_from_cargo = use_extension("//bazel/toolchains/rust:toolchain.bzl", "rust_from_cargo")
use_repo(rust_from_cargo, "rust_metadata", "rust_toolchains")

# Crates for the Cargo workspace (Cargo.toml, Cargo.lock). After changing
# dependencies, repin with `CARGO_BAZEL_REPIN=1 bazel mod tidy`.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
    # The hosts the Rust tools run on: the bootstrap hosts and the platforms in
    # //bazel/platforms. rules_rust matches crate selects on OS and CPU only,
    # so the gnu triples also cover the musl platforms.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# rules_rust's build script runner drops AR when it is libtool, as @llvm's is
# on macOS, so cc-rs falls back to /usr/bin/ar, which needs Xcode or the
# Command Line Tools. The patch passes it through; cc-rs drives libtool.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//bazel/toolchains/rust:rules_rust_libtool_ar.patch"],
)

# musl first: the glibc toolchains leave libc unconstrained, so they would
# otherwise also match the musl platforms.
register_toolchains(
    "@rust_toolchains//:rust_host__aarch64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_host__x86_64-unknown-linux-musl__stable",
    "@rust_toolchains//:all",
)

# MARK: - Swift

# Hermetic swift.org compilers plus the macOS and Static Linux (musl) SDKs.
# Override the version from your own MODULE.bazel with
# swift.toolchain(version = "..."); see //bazel/toolchains/swift:versions.bzl.
swift = use_extension("//bazel/toolchains/swift:extensions.bzl", "swift")
swift.toolchain(version = "6.4.2")
use_repo(swift, "swift_toolchains")

register_toolchains("@swift_toolchains//:all")

# The rules_swift worker runs every compile through /usr/bin/xcrun on macOS,
# which needs Xcode or the Command Line Tools. The patch skips xcrun when the
# toolchain sets RULES_SWIFT_NO_XCRUN, as @swift_toolchains does.
single_version_override(
    module_name = "rules_swift",
    patch_strip = 1,
    patches = ["//bazel/toolchains/swift:rules_swift_no_xcrun.patch"],
)

# MARK: - Swift packages

# Third-party Swift packages for the Xcode apps, from apps/lifr/Package.swift.
# The extension runs the host's `swift package` (Xcode's), so only builds that
# use a @swiftpkg_* repository need Xcode. Update the pins with
# `bazel run @swift_package//:resolve`.
swift_deps = use_extension("@rules_swift_package_manager//:extensions.bzl", "swift_deps")
swift_deps.from_package(
    resolved = "//apps/lifr:Package.resolved",
    swift = "//apps/lifr:Package.swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_swift_composable_architecture", "swiftpkg_swift_snapshot_testing")

# MARK: - Zig

# rules_zig downloads the Zig compiler for the build host and cross-compiles
# with Zig's own libc for each target platform. The root module's first
# zig.toolchain(...) is the default; override it from your own MODULE.bazel.
zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.toolchain(zig_version = "0.17.0")
use_repo(zig, "zig_toolchains")

# Zig targets that match //bazel/platforms (libc, glibc version, macOS minimum).
register_toolchains("//bazel/toolchains/zig:all")

# MARK: - Host tooling

host_tools = use_extension("//bazel/host_tools:extensions.bzl", "host_tools")
use_repo(host_tools, "buildifier", "lima", "rumdl", "shfmt", "starpls", "vale")
