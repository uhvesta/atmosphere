load("@gazelle//:def.bzl", "gazelle")
load("@rules_shell//shell:sh_library.bzl", "sh_library")

exports_files(
    ["Cargo.toml"],
    visibility = ["//bazel/toolchains/rust:__pkg__"],
)

exports_files(
    ["MODULE.bazel"],
    visibility = ["//bazel/format:__pkg__"],
)

exports_files(
    [
        ".clippy.toml",
        ".shellcheckrc",
        ".vale.ini",
    ],
    visibility = ["//bazel/lint:__pkg__"],
)

# gazelle:prefix github.com/uhvesta/monty-oxide
gazelle(name = "gazelle")

alias(
    name = "format",
    actual = "//bazel/format:format",
)

alias(
    name = "format.check",
    actual = "//bazel/format:format.check",
)

alias(
    name = "check-deps",
    actual = "//tools/versionchecker/cmd:check-deps",
)

alias(
    name = "update-deps",
    actual = "//tools/versionchecker/cmd:update-deps",
)

filegroup(
    name = "markdown",
    srcs = glob(["*.md"]),
    tags = ["markdown"],
)

filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["starlark"],
)

sh_library(
    name = "bootstrap_bazelisk",
    srcs = ["//tools/bootstrap:bazelisk.sh"],
    data = ["//tools/bootstrap:versions.lock"],
)
