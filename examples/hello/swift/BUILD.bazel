load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

swift_binary(
    name = "hello",
    srcs = ["main.swift"],
    # Built with every Swift release by //tools/rules/swift/tests.
    visibility = ["//tools/rules/swift/tests:__pkg__"],
)

sh_test(
    name = "hello_test",
    srcs = ["hello_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [":hello"],
)

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
